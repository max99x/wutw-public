[sub_resource type="Resource" id="Resource_mxy6s"]
script = ExtResource("6_p7otl")
markedup_text = "Mix in clove, frankincense, and sandalwood."
outcome = SubResource("Resource_rqfe5")
markedup_result_text = "The apprentices blend clove, frankincense, and sandalwood into the base mixture of agarwood and crushed seashells, then knead it with honey.

The result is a set of pellets with a deep, warm fragrance.

The master examines their work over a hot censer and nods. \"They bring to mind the warmth of a winter robe.\"

The pellets are buried to age in the dark."

[sub_resource type="Resource" id="Resource_eb57d"]
