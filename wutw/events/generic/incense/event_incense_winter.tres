[sub_resource type="Resource" id="Resource_l1gue"]
script = ExtResource("6_p7otl")
markedup_text = "Mix in clove, frankincense, and spikenard."
outcome = SubResource("Resource_eb57d")
markedup_result_text = "The apprentices blend clove, frankincense, and spikenard into the base mixture of agarwood and crushed seashells, then knead it with honey.

The result is a set of pellets with a rich woody scent.

The master examines their work over a hot censer and frowns. \"It is a fine scent, but it does not suit the season.\""

[sub_resource type="Resource" id="Resource_ps5l8"]
script = ExtResource("6_p7otl")
markedup_text = "Mix in clove, camphor, spikenard, and sandalwood."
outcome = SubResource("Resource_eb57d")
markedup_result_text = "The apprentices blend clove, camphor, spikenard, and sandalwood into the base mixture of agarwood and crushed seashells, then knead it with honey.

The result is a set of pellets with a sweet, floral scent.

The master examines their work over a hot censer and frowns. \"It is a fine scent, but it does not suit the season.\""

[sub_resource type="Resource" id="Resource_6at2x"]
script = ExtResource("6_p7otl")
markedup_text = "Mix in patchouli, spikenard, sandalwood, and turmeric."
outcome = SubResource("Resource_eb57d")
markedup_result_text = "The apprentices blend patchouli, spikenard, sandalwood, and turmeric into the base mixture of agarwood and crushed seashells, then knead it with honey.

The result is a set of pellets with an earthy yet refreshing scent.

The master examines their work over a hot censer and frowns. \"It is a fine scent, but it does not suit the season.\""

[sub_resource type="Resource" id="Resource_8mfyw"]
script = ExtResource("3_21g8u")
markedup_text = "At the incense workshop, the apprentices are preparing a new blend for their master to examine.

They have boiled and crushed seashells, mixing them with agarwood for the traditional base, and are now preparing to add the main aromatic ingredients.

Today, they have been tasked with creating a seasonal scent appropriate for [b]winter[/b]."
background_image = SubResource("Resource_d0keq")
background_credit = ExtResource("4_032t8")
