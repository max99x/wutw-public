[sub_resource type="Resource" id="Resource_k1ms5"]
script = ExtResource("6_u77yp")
markedup_text = "Monks from the Shattered Order are visiting."
requirement = SubResource("Resource_1m4gs")
outcome = SubResource("Resource_lkjs2")
markedup_result_text = "A group from the Shattered Order arrives. Their orange robes are threadbare, but they all smile serenely.

When they emerge in the afternoon, one monk approaches the bath-keeper with a blank scroll. \"Let your guests fill their names in this scroll, along with their home shard,\" he says. \"A testament of how your service links our communities... And maybe it'll save them from the next Shattering,\" he adds with a wink."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

