[sub_resource type="Resource" id="Resource_bekio"]
script = ExtResource("6_u77yp")
markedup_text = "Monks from the Order of the Wilds are visiting."
requirement = SubResource("Resource_024be")
outcome = SubResource("Resource_ixqgj")
markedup_result_text = "The monks and nuns of the Wilds arrive, their companion falcons circling over their heads. The head bath-keeper leads them to the warm pools, apologizing profusely for the recent increase in snails clinging to the edges of the pool.

On their way out, one of the monks takes the bath-keeper aside. He explains that the snails are to be kept undisturbed. \"They lend their service to keep these pools clean,\" he says. \"They have come because you were in need of their help.\""

