[sub_resource type="Resource" id="Resource_wlgbr"]
script = ExtResource("6_u77yp")
markedup_text = "Actors from the Dragonfly Troupe are visiting."
outcome = SubResource("Resource_65ovt")
markedup_result_text = "A group of actors from the famous Dragonfly troupe arrives at the baths, making enough racket to echo all through the surrounding valleys.

Halfway through their soak, they decide to put on an impromptu show for the other guests.

They spend the rest of the day running around, yelling jokes, and playing on their biwa lutes, mostly to the mild annoyance and bemusement of their audience."

[sub_resource type="Resource" id="Resource_i8dwd"]
script = ExtResource("4_5spi0")
markedup_text = "The onsen retreat has quickly gained popularity among locals and visitors alike.

A cluster of wooden buildings has sprung up around the hot pools. They not only house the bath attendants, but also serve as lodges for guests. There's even a dedicated dining hall. A head bath-keeper now oversees the little community.

On this misty morning the onsen is receiving an unusual group of guests."
background_image = SubResource("Resource_ygity")
choices = Array[ExtResource("6_u77yp")]([SubResource("Resource_bekio"), SubResource("Resource_u3064"), SubResource("Resource_52vmw"), SubResource("Resource_k1ms5")])
exit_choice = SubResource("Resource_wlgbr")

