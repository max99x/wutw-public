[sub_resource type="Resource" id="Resource_u3064"]
script = ExtResource("6_u77yp")
markedup_text = "Monks from the Order of Growth are visiting."
requirement = SubResource("Resource_nwgvh")
outcome = SubResource("Resource_xdj3e")
markedup_result_text = "The bath-keeper leads the monks from the Order of Growth to the baths while boasting about the cedars surrounding the pool.

When he returns later to check on the visitors, he finds the bath filled with bright yellow yuzu fruits floating in the hot water.

\"These fruits offer much beyond their aroma,\" one of the monks explains. \"They will relax the sore muscles of the elderly, and the tireless workers who visit your retreat.\""

[sub_resource type="Resource" id="Resource_xdn5a"]
