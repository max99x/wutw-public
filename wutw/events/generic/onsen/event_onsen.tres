[sub_resource type="Resource" id="Resource_52vmw"]
script = ExtResource("6_u77yp")
markedup_text = "Monks from the Ember Order are visiting."
requirement = SubResource("Resource_51axc")
outcome = SubResource("Resource_xdn5a")
markedup_result_text = "A group of monks and nuns from the Ember Order arrive at the hot springs, faces stern and eyes gleaming.

They soak in the springs until past dark.

One of the nuns approaches the bath-keeper on her way out and points to a rocky outcropping several paces from the main spring. “We saw steam rising from that crack, and the ground was warm,\" she says. \"Dig there, and you will have a bath hotter than the ones at our monastery.\""

