[sub_resource type="Resource" id="Resource_mv6ao"]
script = ExtResource("6_2cahw")
markedup_text = "Start teaching instead."
requirement = SubResource("Resource_xpc6o")
outcome = SubResource("Resource_4un3v")
markedup_result_text = "The master agrees to leave the cutting and measuring to the apprentices, but insists on holding regular carpentry classes, open to all.

It would be a tragedy to let all his accumulated wisdom go to waste just because his eyesight is gone."

[sub_resource type="Resource" id="Resource_njdss"]
script = ExtResource("12_3tjnj")
card_type = ExtResource("20_ltmgi")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_k6skd"]
script = ExtResource("6_2cahw")
markedup_text = "Refuse to retire."
outcome = SubResource("Resource_njdss")
markedup_result_text = "The master refuses to retire. Carpentry has been his life for decades, and he'd rather die a carpenter than spend his days sitting around.

The apprentices will be forced to redo much of his work, but they are too timid to force the point."

[sub_resource type="Resource" id="Resource_je5w8"]
script = ExtResource("4_vp2do")
markedup_text = "The settlement's master carpenter is slowly but surely going blind. His techniques remain unrivaled, but it won't be long before he will be unable to put any of them into practice.

His apprentices gather for their monthly meeting with apprehension. It isn't easy to ask their master to put down his tools and retire.

The master listens without saying a word, and stops to consider their suggestion."
background_image = SubResource("Resource_coyvd")
background_credit = ExtResource("5_gdi4t")
choices = Array[ExtResource("6_2cahw")]([SubResource("Resource_cyfme"), SubResource("Resource_rymnn"), SubResource("Resource_mv6ao")])
exit_choice = SubResource("Resource_k6skd")

