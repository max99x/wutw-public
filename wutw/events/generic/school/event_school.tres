[sub_resource type="Resource" id="Resource_6qx3d"]
script = ExtResource("5_qts6t")
markedup_text = "Choose the beekeeper."
requirement = SubResource("Resource_5xwl3")
outcome = SubResource("Resource_smijh")
markedup_result_text = "The parents prioritize the children's peace of mind, and hope that by choosing the wise woman, they would preserve the old folk wisdom.

The new teacher is gentle. She gives extra attention to the most anxious students, and brings honeycomb to class.

The more ambitious pupils, however, soon grow restless."

[sub_resource type="Resource" id="Resource_i5ayw"]
script = ExtResource("15_yxknh")
result_text = "The children spend a week with each teacher, and are then asked to choose who they like best.

The majority choose the gentle teacher, whose warmth makes the school feel joyful. She gives extra attention to the most anxious students, and brings honeycomb to class.

Some parents grumble, worried that their children will grow up lacking discipline."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"

