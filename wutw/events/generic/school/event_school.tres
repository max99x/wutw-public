[sub_resource type="Resource" id="Resource_k0xtm"]
script = ExtResource("5_qts6t")
markedup_text = "Ask them to share the duties."
outcome = SubResource("Resource_6at2x")
markedup_result_text = "The parents ask the two candidates to teach together.

By the third day, half of the lesson is taken up by the teachers arguing about the best way to run a school.

The constant disagreement leaves the children confused, eroding their trust in education before they have a chance to start learning."

[sub_resource type="Resource" id="Resource_3xt1n"]
script = ExtResource("3_24xmn")
markedup_text = "A ruin has been renovated into a brand new school, and all that remains is to choose the head teacher.

One option is the local beekeeper, a soft-spoken woman who knows songs and stories, and has herbs to soothe any ailment.

The other candidate is a monk trained at the Haven, a master of rhetoric and arithmetic. He believes the children are capable of more, but he is strict and often impatient."
background_image = SubResource("Resource_jxohx")
background_credit = ExtResource("4_gcfm2")
choices = Array[ExtResource("5_qts6t")]([SubResource("Resource_2ui5q"), SubResource("Resource_6qx3d"), SubResource("Resource_gmlto")])
exit_choice = SubResource("Resource_k0xtm")

