[sub_resource type="Resource" id="Resource_h14ge"]
script = ExtResource("15_yxknh")
result_text = "The children spend a week with each teacher, and are then asked to choose who they like best.

Impressed by the monk's scholarly credentials, they decide to choose him as their instructor. They are rewarded with extra assignments to work on at home.

Some parents grumble, worried that their children will have no time left to experience real life, the kind not found in archives and scrolls."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"

