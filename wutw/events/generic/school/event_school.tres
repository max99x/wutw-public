[sub_resource type="Resource" id="Resource_2ui5q"]
script = ExtResource("5_qts6t")
markedup_text = "Choose the scholar."
requirement = SubResource("Resource_uvutl")
outcome = SubResource("Resource_128l5")
markedup_result_text = "The parents decide to invest in rigor, discipline, and a future outside of the settlement.

The cleverest students thrive under the monk's strict instruction, but the ones less interested in scholarship begin to dread their lessons, and resent being sent home with scrolls full of assignments."

[sub_resource type="Resource" id="Resource_smijh"]
script = ExtResource("7_b2pox")
relic = ExtResource("10_1l37i")
