[sub_resource type="Resource" id="Resource_n3lb7"]
script = ExtResource("5_8wwhx")
markedup_text = "Dig into the waterfall."
requirement = SubResource("Resource_0b2jx")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The settlers chisel away at the frozen falls, ignoring the cracking sound coming from the ice.

They have only a moment to rush out as the wall suddenly shatters and freezing water begins to fill the chambers."

