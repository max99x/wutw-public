[sub_resource type="Resource" id="Resource_4p6fn"]
script = ExtResource("5_8wwhx")
markedup_text = "Search for the waterfall's source. "
requirement = SubResource("Resource_tfvaq")
outcome = SubResource("Resource_d174p")
markedup_result_text = "Curious about where the stream feeding the falls originates, the settlers climb deeper into the cave, crawling through tiny, freezing crevices and climbing up slippery shafts until they reach a staircase cut into the rock.

It leads to a small chamber with several statuettes standing in small alcoves. The origin of the falls remains a mystery, but perhaps this discovery is even more illuminating."

[sub_resource type="Resource" id="Resource_a6ufw"]
script = ExtResource("11_su3v8")
bonus_type = ExtResource("17_yhrae")
amount = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_ybifv"]
script = ExtResource("5_8wwhx")
markedup_text = "Leave the waterfall be."
outcome = SubResource("Resource_a6ufw")
markedup_result_text = "The settlers leave the waterfall alone, afraid of flooding the whole cave system.

Now settlers store their food within the caverns, rather than harvesting ice for the purpose."

[sub_resource type="Resource" id="Resource_vk82q"]
script = ExtResource("3_g3i8v")
markedup_text = "When the first houses were still being raised in this settlement, surveyors found frozen caves with smooth, glassy walls, full of ice stalagmites. Soon, huge chunks of ice were cut and hauled back to the town for preserving food.

The settlers cut away the frozen treasure piece by piece, filling the cavern with a maze of wooden platforms and staircases.

It wasn't long, however, before the ice ran out. The only remaining wall deep in the cave hides a raging waterfall."
background_image = SubResource("Resource_kl0gs")
choices = Array[ExtResource("5_8wwhx")]([SubResource("Resource_n3lb7"), SubResource("Resource_0gr1a"), SubResource("Resource_4p6fn")])
exit_choice = SubResource("Resource_ybifv")

