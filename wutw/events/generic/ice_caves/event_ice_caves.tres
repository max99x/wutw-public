[sub_resource type="Resource" id="Resource_0gr1a"]
script = ExtResource("5_8wwhx")
markedup_text = "Cut little holes to let water escape and refreeze."
requirement = SubResource("Resource_4sd6d")
outcome = SubResource("Resource_0eiya")
markedup_result_text = "The settlers carefully crack tiny holes in the wall to let a thin stream of water escape the falls.

The settlers plug the hole once the water fills half of the chamber, letting it freeze over before extracting the newly formed ice and repeating the process. The harvest is humble, but it's safe, and it won't run out anytime soon."

