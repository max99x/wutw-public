[sub_resource type="Resource" id="Resource_xtxwj"]
script = ExtResource("14_c3etr")
aspect_type = ExtResource("16_nxdde")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_i1mfw"]
script = ExtResource("6_rlsqx")
markedup_text = "Graft longer-blooming varieties onto existing trees."
requirement = SubResource("Resource_xtxwj")
outcome = SubResource("Resource_s13el")
markedup_result_text = "The horticulturists carefully choose branches to replace, making sure to match them in size to the scion branches.

They make interlocking cuts, then seal and bind the wounds.

In time, this will double the length of the blooming season, even if the result may be somewhat patchy."

