[sub_resource type="Resource" id="Resource_2s4jx"]
script = ExtResource("6_rlsqx")
markedup_text = "Replant with varieties that bloom at different times."
requirement = SubResource("Resource_vthxo")
outcome = SubResource("Resource_d1arc")
markedup_result_text = "The horticulturists cut down most of the existing cherry trees and plant new varieties brought from distant shards.

Each one will bloom at a different time, letting the sakura season last for a month or more.

Still, it will be years before the new trees will mature, much to the disppointment of the locals."

[sub_resource type="Resource" id="Resource_s13el"]
