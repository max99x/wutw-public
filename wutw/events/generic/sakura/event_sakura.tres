[sub_resource type="Resource" id="Resource_qhnyi"]
script = ExtResource("6_rlsqx")
markedup_text = "Highlight the beauty in the blooms' transience."
requirement = SubResource("Resource_6c24b")
outcome = SubResource("Resource_8isx0")
markedup_result_text = "The horticulturists' ambitions are overriden by an old poet, who sings praises to the transience of the blooms.

The joy of the cherry blossom viewing tradition lies in its transience, he declares. If these trees bloomed all year long, they wouldn't be special anymore. He even recites a poem to support his point:

Falling sakura...
The blooms that remain are still;
Falling sakura."

[sub_resource type="Resource" id="Resource_k5mxp"]
script = ExtResource("6_rlsqx")
markedup_text = "Leave the trees alone."
markedup_result_text = "The horticulturists decide against harming the existing trees, and they are left to bloom in peace, even if for only a short while."

[sub_resource type="Resource" id="Resource_f4vqu"]
script = ExtResource("3_8tvs8")
markedup_text = "The cherry trees lining the riverbank enjoy a great popularity among the the locals, but despite their beauty, they bloom for only a few days.

Once the brief blooming season ends, the petals fall, covering the banks in a pink blanket.

Local horticulturists think they may be able to solve the problem with enough effort."
background_image = SubResource("Resource_tq8ra")
background_credit = ExtResource("4_j0evi")
choices = Array[ExtResource("6_rlsqx")]([SubResource("Resource_2s4jx"), SubResource("Resource_i1mfw"), SubResource("Resource_qhnyi")])
exit_choice = SubResource("Resource_k5mxp")

