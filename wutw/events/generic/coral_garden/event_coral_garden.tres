[sub_resource type="Resource" id="Resource_ag53m"]
script = ExtResource("6_5aymh")
markedup_text = "Make jewelry out of other materials."
requirement = SubResource("Resource_7iagp")
outcome = SubResource("Resource_mxpny")
markedup_result_text = "The settlers collect smooth stones, colorful seashells, and driftwood, polishing them until they gleam, and carving them into delicate ornaments.

Although the new jewelry doesn't prove to be as successful, the settlers still eke out a modest trade.

Stones carved into swirling vortex shapes are especially popular."

