[sub_resource type="Resource" id="Resource_1n263"]
script = ExtResource("6_5aymh")
markedup_text = "Continue using only the washed-up coral."
outcome = SubResource("Resource_5so36")
markedup_result_text = "The settlers continue to gather the coral that washes up onto shore, and stay away from the whirlpools.

Their jewelry trade remains modest, but the reef will maintain its beauty for generations to come."

[sub_resource type="Resource" id="Resource_cs0i7"]
script = ExtResource("4_e51mh")
markedup_text = "Swirling whirlpools churn the waters off the settlement's coast, right above a forest of bright coral.

The resulting currents occasionally snap off coral branches, and carry them ashore, where settlers gather them up.

The jewelry made from these fragments has become the town's signature export, but demand far outpaces supply."
