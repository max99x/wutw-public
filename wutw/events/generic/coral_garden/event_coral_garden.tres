[sub_resource type="Resource" id="Resource_425v5"]
script = ExtResource("6_5aymh")
markedup_text = "Devise a way to avoid the whirlpools."
requirement = SubResource("Resource_tiogh")
outcome = SubResource("Resource_3xh8f")
markedup_result_text = "The settlers observe the whirlpools, recording the changes in their movement hourly. They find a few vortices that weaken at dawn.

Gatherers dive with baskets as the sun rises, collecting the dead coral that ends up on the sea floor.

The work is dangerous and slow, but it's enough to guarantee a steady supply of jewelry."

