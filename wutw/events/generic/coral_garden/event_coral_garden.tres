[sub_resource type="Resource" id="Resource_vsjxl"]
script = ExtResource("6_5aymh")
markedup_text = "Harvest living coral."
requirement = SubResource("Resource_03wcp")
outcome = SubResource("Resource_5u84d")
markedup_result_text = "The settlers, eager to expand their trade, devise a plan to break off pieces of coral without entering the rushing currents.

They attach hooks to long poles and break off pieces from the reef from a distance.

This yields enough coral to double their exports, but the reef suffers as a consequence. Turtles and fish will soon become a rare sight around these parts."

