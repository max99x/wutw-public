[sub_resource type="Resource" id="Resource_2rpah"]
script = ExtResource("6_q4imu")
markedup_text = "Scare the orcas with loud drumming."
requirement = SubResource("Resource_4fpj6")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The settlers, unwilling to risk getting too close to the orcas, loudly pound their oars on the hulls of their boats, letting the noise echo into the waves.

The orcas dash away, but the whale calves are just as startled and quickly flee in a different direction, with their mothers following.

The celebration is cut short, but at least everyone is safe."

