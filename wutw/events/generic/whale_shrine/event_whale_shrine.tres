[sub_resource type="Resource" id="Resource_o44fc"]
script = ExtResource("4_5u84d")
markedup_text = "The settlers are celebrating the beginning of whale season, watching as they come to the warm shallows to give birth.

Today the first newborn calf is spotted drifting alongside its mother, but the cheers are interrupted by a troubling sight: a pod of orcas heading straight for the two whales.

Although fish are their usual prey, they can pose a serious threat to a young whale."
background_image = SubResource("Resource_hxi3y")
choices = Array[ExtResource("6_q4imu")]([SubResource("Resource_2rpah"), SubResource("Resource_ijqs6"), SubResource("Resource_eyvo4")])
exit_choice = SubResource("Resource_658i2")

