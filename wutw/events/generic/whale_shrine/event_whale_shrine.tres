[sub_resource type="Resource" id="Resource_eyvo4"]
script = ExtResource("6_q4imu")
markedup_text = "Guide the whales away."
requirement = SubResource("Resource_pf411")
outcome = SubResource("Resource_bgisj")
markedup_result_text = "The settlers split into two groups and surround the whales from two sides, in the hope of herding them towards a sheltered bay.

The whales are hesitant at first, but they soon seem to recognize the offer of help. They swim carefully between the boats and safely leave the orcas behind."

[sub_resource type="Resource" id="Resource_agcm7"]
script = ExtResource("19_05lm0")
result_text = "The settlers decide to let nature take its course, remaining at a distance.

The orcas soon surround the whales and manage to separate them, capturing the calf."
