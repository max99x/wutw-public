[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("9_et50i")
markedup_text = "Offer cloth instead."
requirement = SubResource("Resource_06ahh")
outcome = SubResource("Resource_5syih")
markedup_result_text = "The weaver offers to sell her his finest cloth instead. The merchant reluctantly agrees, on the condition that he sell only to her.

And so the deal is sealed, the master earning a small fortune in the process.

In time, the workshop will expand to employ much of the town's workforce, yet none will be able to wear garments made from the cloth they produce."

[sub_resource type="Resource" id="Resource_2i40o"]
script = ExtResource("18_8udv6")
relic = ExtResource("17_aban3")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("16_55a32")
aspect_type = ExtResource("19_fipn2")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("9_et50i")
markedup_text = "Explain how to build such looms."
requirement = SubResource("Resource_nthfn")
outcome = SubResource("Resource_2i40o")
markedup_result_text = "The weaver offers to teach the merchant how to build her own great looms instead. She seems reluctant at first, but agrees after the master refuses to sell the loom for any sum.

The woman will bring schematics and spare parts back to her home shard, and perhaps the technology will continue to spread."

[sub_resource type="Resource" id="Resource_qmdva"]
script = ExtResource("21_musrc")
card_type = ExtResource("20_khg3v")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("9_et50i")
markedup_text = "Accept the offer."
outcome = SubResource("Resource_qmdva")
markedup_result_text = "The master weaver, tempted by the large sum which the merchant is offering, agrees to sell her the loom. He can always construct a new one, he reasons.

The loom is deconstructed, packed into crates, and shipped off to a distant shard.

It won't be long before off-shard cloth becomes cheaper than anything the town manages to produce."

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("9_et50i")
markedup_text = "Refuse the offer."
markedup_result_text = "The merchant's arrogance doesn't sit well with the weaver, and besides, he doesn't need any more money.

He politely but firmly refuses her offer and sends the woman on her way."

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("7_ocbfa")
markedup_text = "The head weaver surveys his workshop while his assistant is hard at work at the great loom, a massive construction only recently invented by local carpenters.

Thanks to this loom, the workshop's reputation is already spreading throughout the shard.

Today, an unusual visitor is at the door: a tall, well-dressed woman, accompanied by a young attendant. She speaks in an unusual accent, and offers a great sum in return for selling her the loom."
background_image = SubResource("Resource_dpp3j")
background_credit = ExtResource("8_emydf")
choices = Array[ExtResource("9_et50i")]([SubResource("Resource_ciwob"), SubResource("Resource_2myy3"), SubResource("Resource_w2hpu")])
exit_choice = SubResource("Resource_3sdrw")

