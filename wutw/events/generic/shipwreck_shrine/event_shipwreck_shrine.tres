[sub_resource type="Resource" id="Resource_htnkq"]
script = ExtResource("6_oigu6")
markedup_text = "Let the adventurers dive into the hold."
requirement = SubResource("Resource_vuo78")
outcome = SubResource("Resource_3ct8e")
markedup_result_text = "The priests agree, and the adventurers immediately dive into the waves.

As they make their way into the hold through a hole in the hull they are greeted by darkness and octopuses.

Feeling around the barrels and shattered crates, they find them empty. Whatever the ship carried must have long since been plundered by the denizens of the sea.

They do locate a small copper plate, however, with markings indicating auspicious directions."

[sub_resource type="Resource" id="Resource_axjcl"]
script = ExtResource("12_0c4yk")
card_type = ExtResource("11_cadcw")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_0r5k4"]
script = ExtResource("14_0y4jv")
aspect_type = ExtResource("13_hfieh")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2f1fw"]
script = ExtResource("6_oigu6")
markedup_text = "Let the adventurers examine the ship from a distance."
requirement = SubResource("Resource_0r5k4")
outcome = SubResource("Resource_axjcl")
markedup_result_text = "The priests permit the dive, as long as the ship itself remains untouched.

The adventurers find the ship's decomposing hull teeming with life. Barnacles have covered the whole surface, and octopuses peek from holes in the hull.

As they are about to rise back up, a huge turtle swims out from inside the hold, trailing a cape of seaweed behind it."

