aspect_type = ExtResource("17_2ctyi")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_csk7j"]
script = ExtResource("6_oigu6")
markedup_text = "Ask the adventurers to clear barnacles off the hull instead."
requirement = SubResource("Resource_d63ke")
outcome = SubResource("Resource_uoc2g")
markedup_result_text = "The priests don't permit an exploration of the interior, but ask the adventurers to clear off the barnacles that cover much of the hull, hoping to delay the ship's inevitable collapse.

The adventurers dive with iron bars, prying the fragile shells off the decaying wood.

The barnacles now lie on the sea floor in a helpless pile, and the wood is covered in gouges."

[sub_resource type="Resource" id="Resource_yfe6x"]
script = ExtResource("6_oigu6")
markedup_text = "Forbid the investigation."
markedup_result_text = "The priests worry that a careless investigation could damage the decaying wood and decide to forbid the adventurers from approaching the ship."

[sub_resource type="Resource" id="Resource_rpahn"]
script = ExtResource("3_vxqyw")
markedup_text = "A group of adventurers has arrived at the shipwreck shrine asking the priests for permission to investigate the shipwreck.

Although not a sacred object itself, the sunken vessel has long been a focus for the priests' prayers."
background_image = SubResource("Resource_5b400")
background_credit = ExtResource("4_q3deg")
choices = Array[ExtResource("6_oigu6")]([SubResource("Resource_htnkq"), SubResource("Resource_2f1fw"), SubResource("Resource_csk7j")])
exit_choice = SubResource("Resource_yfe6x")

