restrict_to_jobs = Array[ExtResource("3_qknup")]([ExtResource("4_3r4h5"), ExtResource("5_ho412"), ExtResource("6_hfpq8")])
restrict_to_ages = Array[int]([1, 2])
quest_id = "settler_philosophers"
category = 2
name = "A Philosophy School"
metadata/_custom_type_script = "uid://1na7ymvvvbby"
