[resource]
script = ExtResource("20_00nsm")
intro_text = "My colleagues and I represent a philosophy advocating non-action. We believe that enlightenment can only be reached through discussing the nature of reality, rather than doing things that may disrupt its natural order. We'd like someone to set up schools for us to teach the next generation."
challenges = Array[ExtResource("1_b6kn5")]([SubResource("Resource_ffuxc")])
settler_goals = Array[ExtResource("21_l0s2m")]([SubResource("Resource_qwm32")])
