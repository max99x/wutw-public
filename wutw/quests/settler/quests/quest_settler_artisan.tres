[resource]
script = ExtResource("18_gpm8m")
intro_text = "I feel true mastery is disappearing day by day. Modern craftspeople have no standards. They use whatever materials they have on hand and don't even bother checking their work. I yearn for the returen of real, traditional artisanship."
