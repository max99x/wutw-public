offset_right = 609.08093
offset_bottom = 33.0
mouse_default_cursor_shape = 2
theme_override_styles/panel = SubResource("StyleBoxTexture_io5eh")
script = ExtResource("4_we3yf")
era_name = "Kamakura"
start_year = 1185
end_year = 1333
tooltip = "A militant period that gave rise to the [i]samurai[/i], ruled by shōguns (warrior chieftains) through the feudal [i]bakufu[/i] government from Kamakura (new modern-day Tōkyō), with emperors acting as figureheads.

During this era the refined aristocracy was left behind, replaced by the practical, martial samurai class. Courtly aesthetics likewise gave way to rugged values of loyalty, discipline, and honor.

Religion also evolved. While Buddhism was previously a complex, ritualistic practice reserved for the elite, it was now simplified and began to spread among commoners. In particular, Zen Buddhism arose from its Chinese counterpart (Chan), and promoted the austere self-control that fit samurai values.

At this time, literature shifted away from romantic court intrigues, focusing instead on warrior bravery and the impermanence of life, and visual arts gained a measure of realism."

