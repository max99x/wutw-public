script = ExtResource("4_we3yf")
era_name = "Taishō"
start_year = 1912
end_year = 1926
tooltip = "A brief, vibrant era known for the \"Taishō Democracy\", marked by liberal ideals, mass media, and cosmopolitan urban culture.

Japan's booming economy led to a growing middle class which embraced a consumer lifestyle. The cities filled with [i]mobo[/i] (modern boys) and [i]moga[/i] (modern girls) who defied traditional norms by wearing Western clothes, listening to jazz, and frequenting cafés, dance halls, and cinemas.

Political liberalism also surged, with expanding mass media supporting labor movements and political reform, eventually leading to the passage of universal male suffrage."

[node name="ShouwaLine" type="Panel" parent="Control" unique_id=87578056]
