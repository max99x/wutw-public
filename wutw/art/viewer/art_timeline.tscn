script = ExtResource("4_we3yf")
era_name = "Heian"
start_year = 794
end_year = 1185
tooltip = "The golden age of classical Japan, centered in Heian-kyō (modern-day Kyōto), and known for extreme emphasis on aesthetics among the ruling class.

During this time the Chinese-inspired aristocratic culture took on a distinctive Japanese character, with emphasis on refined poetry and fashion, such as subtle seasonal color choices for their many-layered silk robes. Murasaki Shikibu's The Tale of Genji, often considered the world's first novel, was written during this time. It used [i]hiragana[/i], a native phonetic script developed by the noblewomen of the court, and still in use today.

While little is known about the life of Heian commoners, we know that the rulers mostly neglected the lands outside the capital, which led to the rise of regional warrior clans which eventually took over."

[node name="KamakuraLine" type="Panel" parent="Control" unique_id=91565094]
unique_name_in_owner = true
modulate = Color(0.355, 0.43191665, 0.71, 1)
