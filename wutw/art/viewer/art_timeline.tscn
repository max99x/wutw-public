theme_override_styles/panel = SubResource("StyleBoxTexture_io5eh")
script = ExtResource("4_we3yf")
era_name = "Heisei"
start_year = 1989
end_year = 2019
tooltip = "An era defined by economic stagnation but a global explosion of cultural influence.

After the economy crashed in 1989, the country entered into the Lost Decades, where middle class ideals and the promise of lifetime corporate employment began to unravel, giving rise to part-time workers, a rapidly aging population, and the emergence of [i]hikikomori[/i] (extreme social withdrawal).

Compounded by natural disasters, most notably the 2011 Tōhoku earthquake and tsunami, the national mood shifted away from corporate ambition toward a desire for stability and healing. Art and media from this period often explores societal collapse and existential dread, as well as post-apocalyptic recovery and critiques of consumerism. The latter are a major influence for Worlds Upon the Wind.

Despite domestic struggles, Japan gained major international influence, with anime, manga, video games, and the [i]kawaii[/i] (cute) style becoming global phenomenons."

[node name="ReiwaLine" type="Panel" parent="Control" unique_id=2131222722]
unique_name_in_owner = true
