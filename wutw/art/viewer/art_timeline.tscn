script = ExtResource("4_we3yf")
era_name = "Meiji"
start_year = 1868
end_year = 1912
tooltip = "An era of rapid modernization and Westernization, marking Japan's transformation from an isolated feudal state into a global industrial power under a restored emperor.

During this time, the strict class system was dismantled, stripping the samurai of their status, stipends, and the right to wear swords. Social mobility became possible, driven by compulsory education, a national conscript army, and a shift of workforce from rural agriculture to urban industry.

A philosophy of \"wakon yosai\" (Japanese spirit, Western learning) became the era's slogan, and Western technology, architecture, and fashion were rapidly integrated. Railways, brick architecture, and gas lamps flooded the cities, and the elites started wearing Western hairstyles and clothes.

Buddhism lost some of its influence, with its taboo on eating meat being lifted, and Shinto was remade into a state religion to unify the populace around the new emperor."

