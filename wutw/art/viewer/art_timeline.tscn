theme_override_styles/panel = SubResource("StyleBoxTexture_io5eh")
script = ExtResource("4_we3yf")
era_name = "Edo"
start_year = 1600
end_year = 1868
tooltip = "An era of unprecedented peace and strict national isolation, ruled from Edo (modern-day Tōkyō) by a powerful shogunate.

With no wars to fight, the samurai transitioned into educated bureaucrats. While the class system remained enforced, the peaceful economy allowed merchants to amass immense wealth and invest it into entertainment districts, the [i]ukiyo[/i] (floating worlds), where art and hedonism prospered.

Both arts and literacy became accessible to commoners, leading to the development of many new art forms. The Kabuki theater, geisha entertainment, haiku poetry, and the ukiyo-e genre of woodblock printing arose during this period."

[node name="MeijiLine" type="Panel" parent="Control" unique_id=168150355]
