theme_override_styles/panel = SubResource("StyleBoxTexture_io5eh")
script = ExtResource("4_we3yf")
era_name = "Azuchi-Momoyama"
start_year = 1573
end_year = 1600
tooltip = "A brief period that centralized political power and established the class system that would endure until the end of the 19th century.

During this time, the ruling samurai class gained a monopoly on violence through \"sword hunts\", which confiscated weapons from peasants and warrior-monks. Class distinctions were further formalized by requiring different classes to live separately in different areas of each town.

The samurai built massive castles, decorated in a lavish, ostentatious style. These were full of elaborately painted folding screens and sliding doors, often decorated with gold leaf. To contrast this, the tea ceremony reached its apex, with the famous tea master Sen no Rikyū popularizing a highly ritualized, spiritual version among the elites."

[node name="EdoLine" type="Panel" parent="Control" unique_id=1474485889]
unique_name_in_owner = true
