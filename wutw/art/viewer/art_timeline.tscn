theme_override_styles/panel = SubResource("StyleBoxTexture_io5eh")
script = ExtResource("4_we3yf")
era_name = "Shōwa"
start_year = 1926
end_year = 1989
tooltip = "An era starting with extreme nationalism, culminating in Japan's role in World War II, followed by a miraculous economic recovery.

In the early decades, the liberal Taishō culture was crushed by militarism, strict state censorship, and a unifying emperor cult. Daily life became heavily regimented and austere as all resources were funneled into a massive war machine.

Following the war, a new democratic constitution and rapid economic growth reshaped the country. The concept of the loyal corporate \"salaryman\" and the nuclear family living in concrete apartment complexes became the new middle class ideal, and modern Japanese culture including manga, anime and video games developed.

Today, the Shōwa period carries a nostalgic appeal as a simpler, warmer, and more community-oriented time before the digital age."

[node name="HeiseiLine" type="Panel" parent="Control" unique_id=1096424804]
unique_name_in_owner = true
