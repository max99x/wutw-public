[resource]
script = ExtResource("3_7nn2t")
original_image = SubResource("Resource_bcsnl")
piece_name = "Minamoto no Tametomo Shoots an Enemy Ship with an Arrow"
artist = ExtResource("1_kbdvm")
styles = Array[ExtResource("4_r5r0d")]([ExtResource("5_kbdvm")])
actual_start_year = 1843
actual_end_year = 1846
date_type = 1
edits_description = "The image was cropped and extra ships and the text were removed."
final_image_tex = SubResource("Resource_am1kv")
province = 56
blurb = "Depicts a legendary scene of the famous 12th-century samurai [url=https://en.wikipedia.org/wiki/Minamoto_no_Tametomo]Minamoto no Tametomo[/url] (far left) sinking an enemy ship by firing a single arrow.

The legend goes that instead of dying in exile on Izu Ōshima (near modern Tōkyō), he traveled to the Ryūkyū islands (of which Okinawa is the most famous), took on a second wife, Sasarae (shown in the center of this print), and became the ancestor of the islands' ruling family. This tale was sometimes used to support Japanese rights to the Ryūkyū islands.

The figure on the far right is Tametomo's retainer Oniyasha."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"
