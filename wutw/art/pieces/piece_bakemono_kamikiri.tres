original_image = SubResource("Resource_bcsnl")
piece_name = "Kamikiri"
series = ExtResource("3_jgnjs")
styles = Array[ExtResource("4_3mexg")]([ExtResource("5_naxk8"), ExtResource("6_yas2e")])
actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/File:33.Kamikiri.jpg"
edits_description = "The background was edited out and the white spots were toned down."
final_image_tex = SubResource("Resource_5vv68")
blurb = "Depicts Kamikiri (\"hair cutter\"), an insect-like yōkai with a long beak and scissor-like hands, used to cut unsuspecting victims' hair off without warning or motive. They were said to infest dark alleys, bedrooms, and, most commonly, bathrooms.

Hair in the Edo period was an important status symbol, and cutting it was symbolic of becoming a monk or nun, so to have one's hair cut against one's will would have been a major ordeal."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"
