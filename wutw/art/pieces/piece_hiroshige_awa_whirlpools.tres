[resource]
script = ExtResource("3_fy4is")
original_image = SubResource("Resource_bcsnl")
piece_name = "View of Whirlpools at Awa"
series = ExtResource("4_235wk")
artist = ExtResource("1_235wk")
styles = Array[ExtResource("5_yfrwj")]([ExtResource("6_xipxh")])
actual_start_year = 1857
edits_description = "Only the middle panel was used and the stamps were removed."
final_image_tex = SubResource("Resource_x4myr")
province = 15
blurb = "Depicts the swirling eddies comprising the [url=https://en.wikipedia.org/wiki/Naruto_whirlpools]Naruto whirlpools[/url], a channel between Naruto in Tokushima and Awaji Island in present-day Hyōgo prefecture.

These whirlpools are caused by the difference in sea levels between the Pacific Ocean and the Seto Inland Sea. They form as the water rushes through the narrow Naruto strait, and are especially noticeable during spring and autumn.

Hiroshige completed this design one year before his death as part of a set of three triptychs on the theme known as setsugetsuka (\"snow-moon-flowers\"). Flowers are the theme here, as represented by the shape of the whirlpools, while snow and the moon are the theme of the other two triptychs. These late Hiroshige works often avoided focusing on human figures and instead focused purely on vast landscapes."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"
