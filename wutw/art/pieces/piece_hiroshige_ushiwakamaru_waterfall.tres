[resource]
script = ExtResource("3_6xfvw")
original_image = SubResource("Resource_bcsnl")
piece_name = "Ushiwakamaru by a Waterfall"
artist = ExtResource("1_w068e")
styles = Array[ExtResource("4_x416p")]([ExtResource("5_w068e")])
actual_start_year = 1843
actual_end_year = 1846
date_type = 1
custom_link = "https://commons.wikimedia.org/wiki/File:Ushiwakamaru_bij_de_waterval-Rijksmuseum_AK-MAK-1605.jpeg"
edits_description = "Only the rocks and splashing water were used."
final_image_tex = SubResource("Resource_jg17w")
province = 70
blurb = "Depicts a scene from chapter 2 of the fictionalized biography of Minamoto no Yoshitsune, a famous 12th-century samurai general. In this night scene, the 13 years old Yoshitsune (still using his birth name, Ushiwakamaru) is holding a bell between his teeth and preparing to purify himself in a cold waterfall. In the background a staircase leading to the Kifune shrine.

Yoshitsune's life was defined by a dramatic rise to military glory and a tragic end. After surviving the Heiji Rebellion, he was raised in a temple then left to launch a war campaign before being betrayed and forced to commit suicide by his brother, Minamoto no Yoritomo, the first shōgun of the Kamakura shogunate."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"
