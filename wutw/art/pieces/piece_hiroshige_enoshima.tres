[resource]
script = ExtResource("3_83bnj")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Cave at Enoshima in Sagami Province"
artist = ExtResource("1_fdn2c")
styles = Array[ExtResource("5_2kctt")]([ExtResource("6_fbvbj")])
actual_start_year = 1836
actual_end_year = 1836
date_type = 1
edits_description = "Only the cave opening was used, rotated to depict a sinkhole."
final_image_tex = SubResource("Resource_jg17w")
province = 57
blurb = "Depicts the entrance to one of the two Enoshima Iwaya Caves, located at the southern tip of Enoshima Island in present-day Kanagawa prefecture. These are naturally formed sea caves shaped by centuries of wave erosion.

A famous legend associated with the caves tells of a five-headed dragon who repented from evil after encountering a heavenly maiden. The dragon became the island's protector, symbolizing inner transformation.

The caves are also known as the site of a prayer from Minamoto no Yoritomo, the founder of the Kamakura shogunate.

As of 2026, the caves are open to visitors.

This print is an [url=https://en.wikipedia.org/wiki/Uchiwa-e]uchiwa-e[/url] (\"fan print\"). These were intended to be cut out and pasted on paddle-shaped hand fans known as uchiwa. Such prints are rarely well-preserved, as the fans were articles of daily use, causing considerable wear and tear to the artwork."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"
