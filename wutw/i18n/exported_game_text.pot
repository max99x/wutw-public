#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_add_card.tres
msgid "Add"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_add_card.tres
msgid "Adding Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_add_card.tres
msgid "Adding a <term:glyph> to your <term:card_deck> for the rest of an <term:run>, for example by choosing one at the end of a <term:foray>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_advanced_aspect.tres
msgid "Advanced Essence"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_advanced_aspect.tres
msgid "One of the four reflected <term:aspect>s: <term:aspect.craft>, <term:aspect.spirit>, <term:aspect.illumination>, and <term:aspect.connection>. Advanced <term:spot> <term:spot_upgrade>s require these."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_aspect.tres
msgid "The elemental force used to create <term:spot_upgrade>s in <term:spot>s, usually provided by <term:slot_card>ting <term_lower:glyph>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_aspect_slot.tres
msgid "Essence Slot"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_aspect_slot.tres
msgid "A requirement within a <term:spot_upgrade> or <term:task> that must be <term_lower:fill>ed with a matching <term:aspect>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_basic_aspect.tres
msgid "Basic Essence"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_basic_aspect.tres
msgid "One of the three fundamental <term:aspect>s of the world: <term:aspect.stability>, <term:aspect.change>, and <term:aspect.life>. All <term:spot> require one basic essence for their initial <term:spot_upgrade>s."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_bonus.tres
msgid "The results of your <term:spot_upgrade>s, such as <term:bonus.food> or <term:bonus.knowledge>, which can be gathered over the course of the <term:run>, spent at <term:shop>s, and used during <term:event>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_capital.tres
#: map/capital.gd:192
#: map/settlement_list/settlement_list.gd:46
#: map/settlement_list/settlement_list.tscn
msgid "Shard Capital"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_capital.tres
msgid "A central hub that shares <term_lower:bonus>s with <term_lower:connect_settlement>ed <term_lower:settlement>s, growing stronger as more are linked. Its state carries over between <term_lower:season>s."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_card_ability.tres
msgid "A spell-like ability <term_lower:cast_card> from a <term:glyph> instead of <term_lower:slot_card>ting it into an <term:aspect_slot>. Glyphs with multiple Invocations cast them all in order."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_card_deck.tres
msgid "The collection of <term:glyph>s you bring into an <term:run> and <term_lower:draw> from during <term:stage>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_card_rarity_tier.tres
msgid "Rarity Tier"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_card_rarity_tier.tres
msgid "Glyph Rarity Tier"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_card_rarity_tier.tres
msgid "The rarity tier of <term:glyph>s determines their power. Higher tier <term:glyph>s provide more <term:aspect>s and stronger <term:card_ability>s. Higher tier <term:glyph>s are found later in an <term:run>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_cast_card.tres
msgid "Cast"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_cast_card.tres
msgid "Casting Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_cast_card.tres
msgid "Using a <term_lower:glyph> for its <term:card_ability>s instead of <term_lower:slot_card>ting it into an <term:aspect_slot>. When a <term_lower:glyph> is cast, all of its <term:card_ability>s are cast."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_companion.tres
#: hub/run_setup/run_setup.tscn
msgid "Companion"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_companion.tres
msgid "Animal Companions"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_companion.tres
msgid "Animal spirits which can join you during your <term_lower:run>s and provide unique abilities."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_connect_settlement.tres
msgid "Connect"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_connect_settlement.tres
msgid "Connecting Settlements"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_connect_settlement.tres
msgid "Completing a <term:harmonization_recipe> during <term:harmonization> to connect a <term:settlement> to the <term:capital>."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_craft.tres
#: hub/crafting/crafting.tscn
msgid "Inscribe"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_craft.tres
msgid "Inscribing Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_craft.tres
msgid "Creating new <term:glyph>s to use as <term:signature_card>s at the start of an <term:run>, by combining <term:stroke>s in the <term:hub>."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_discard.tres
msgid "Discarding"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_discard.tres
msgid "Moving a <term_lower:glyph> to the <term:discard_pile> for any reason. Not limited to the <term:card_ability.discard> <term_lower:card_ability>."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_discard_pile.tres
msgid "<term:glyph>s that have already been <term_lower:discard>ed, but will be reshuffled into the <term_lower:draw_pile> when it is exhausted. They can be retrieved to your <term_lower:hand> using <term:card_ability.recycle>."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_draw.tres
msgid "Drawing"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_draw.tres
msgid "Moving a <term_lower:glyph> from the <term:draw_pile> to your <term:hand>."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_draw_pile.tres
msgid "The stack of <term_lower:glyph>s waiting to be drawn during a <term:stage>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_encounter.tres
msgid "Encounter"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_encounter.tres
msgid "Survey Encounter"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_encounter.tres
msgid "A dilemma encountered during <term:survey>s resolved using <term_lower:glyph>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_event.tres
msgid "Event"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_event.tres
msgid "An interactive vignette that can lead to a variety of outcomes."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_explorer_trip.tres
msgid "Explorer Trip"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_explorer_trip.tres
msgid "A trip which the Explorer takes to a previously settled shard. Such trips take one <term_lower:season> and may reveal new <term_lower:skill>s or <term_lower:relic>s."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_fill.tres
msgid "Filling Slots"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_fill.tres
msgid "Filling an <term:aspect_slot> with <term:aspect>, in order to activate <term:spot_upgrade>s or <term:task>s."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_foray.tres
msgid "A focused effort to establish a new <term:settlement>, where you play <term_lower:glyph>s to develop <term:spot>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_glyph.tres
msgid "Glyph"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_glyph.tres
msgid "A card used to shape <term:spot_upgrade>s or <term_lower:cast_card> <term:card_ability>s."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_hand.tres
msgid "The current set of <term:glyph>s available to <term_lower:play_card> in a <term:stage>."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: label
#: glossary/terms/standalone/term_hand_size.tres
#: pause_menu/stats_dialog.tscn
#: stage/survey/survey.tscn
msgid "Hand Size"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_hand_size.tres
msgid "The number of <term_lower:glyph>s <term_lower:draw>n into your <term:hand> at the beginning of a <term:stage>, and on each <term:redraw>."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_harmonization.tres
msgid "A key moment at the end of each <term:season> where you make up for your <term:settlement>s' <term:lack>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_harmonization_recipe.tres
msgid "Convergence Task"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_harmonization_recipe.tres
msgid "A task during <term:harmonization> that requires <term:aspect> to accomplish, such as <term_lower:connect_settlement>ing <term:settlement>s or <term_lower:satisfy_lack>ing <term:lack>s."
msgstr ""

#. TRANSLATORS: Property: realistic_term_name
#: glossary/terms/standalone/term_haunting.tres
#: hub/museum/museum_detail_haunting.gd:67
#: pause_menu/stats_dialog.gd:36
msgid "Challenge"
msgstr ""

#. TRANSLATORS: Property: realistic_markedup_description
#: glossary/terms/standalone/term_haunting.tres
msgid "Extra challenges during <term_lower:foray>s, attributed to hauntings in ages past. Challenges can affect a specific <term_lower:spot> or the whole settlement. They can be countered by <term_lower:fill>ing their associated <term_lower:aspect_slot>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_haunting.tres
#: hub/museum/museum_detail_haunting.gd:67
#: pause_menu/stats_dialog.gd:36
msgid "Haunting"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_haunting.tres
msgid "Restless spirits posing extra challenges during <term_lower:foray>s. Hauntings can affect a specific <term_lower:spot> or the whole settlement. They can be pacified by <term_lower:fill>ing their associated <term_lower:aspect_slot>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_hub.tres
msgid "Haven"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_hub.tres
msgid "Your resting place between <term:run>s, where you prepare, reflect, and grow."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_inherit_card.tres
msgid "Keep"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_inherit_card.tres
msgid "Keeping Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_inherit_card.tres
msgid "Marking a <term:glyph> as Kept at the end of an <term:run>, which will add it to your starting <term:card_deck> on your next <term:run>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_innate.tres
msgid "Innate"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_innate.tres
msgid "Innate Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_innate.tres
msgid "<term:glyph>s that are guaranteed to be drawn first at the beginning of a <term:stage>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_insight.tres
msgid "[img width=1.375em height=1.375em]res://hub/insights/enso.png[/img][font_size=4] [/font_size]Insight"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_insight.tres
msgid "Insights"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_insight.tres
msgid "Points earned by completing <term:stage>s. You can spend them in the <term:hub> to permanently unlock new <term:skill>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_inspiration.tres
msgid "[img width=1.5em height=1.5em]res://run/inspiration.png[/img]Inspiration"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_inspiration.tres
msgid "Your guiding resolve. If it runs out, the <term:run> ends prematurely and you forfeit bonus <term:insight>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_lack.tres
#: harmonization/harmonization_recipe.tscn
msgid "Shortage"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_lack.tres
msgid "Settlement Shortage"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_lack.tres
msgid "A type of <term:bonus> that a <term:settlement> is lacking. During <term:harmonization>, you can <term:satisfy_lack> these directly or by <term_lower:connect_settlement>ing the <term:settlement>. Each un<term_lower:satisfy_lack>ed shortage results in a loss of 5 <term_lower:inspiration>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_location.tres
msgid "Location"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_location.tres
msgid "A place on the <term:world_shard> waiting to be settled, chosen to begin a new <term:foray>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_negative_glyph.tres
msgid "Negative Glyph"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_negative_glyph.tres
msgid "Negative Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_negative_glyph.tres
msgid "<term:glyph>s with harmful <term:card_ability>s, such as <term:card.tears>. Any such <term_lower:glyph>s remaining in the <term_lower:hand> at the end of a <term_lower:turn> are <term_lower:cast_card> automatically."
msgstr ""

#. TRANSLATORS: Property: realistic_long_term_name
#: glossary/terms/standalone/term_pacify.tres
msgid "Mitigate Challenge"
msgstr ""

#. TRANSLATORS: Property: realistic_markedup_description
#: glossary/terms/standalone/term_pacify.tres
msgid "Mitigating a <term_lower:haunting>, usually by <term_lower:fill>ing its associated <term_lower:aspect_slot>s."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_pacify.tres
msgid "Pacify Haunting"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_pacify.tres
msgid "Laying a <term_lower:haunting> spirit to rest, usually by <term_lower:fill>ing their associated <term_lower:aspect_slot>s."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_play_card.tres
msgid "Playing Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_play_card.tres
msgid "Using a <term_lower:glyph> either to <term_lower:slot_card> into an <term:aspect_slot> or to <term_lower:cast_card> its <term:card_ability>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_redraw.tres
#: hub/crafting/crafting.tscn
msgid "Redraw"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_redraw.tres
msgid "Redrawing"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_redraw.tres
msgid "<term:draw>ing a new set of <term_lower:glyph>s into your <term:hand>, according to your <term:hand_size>."
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_refugee.tres
msgid "A survivor of the shattered world, ready to create new life on the <term:world_shard>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_relic.tres
msgid "Relic"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_relic.tres
msgid "A symbolic item that grants a special effect during an <term:run>, usually acquired from <term:event>s or at the end of a <term:season>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_remove_card.tres
msgid "Remove"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_remove_card.tres
msgid "Removing Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_remove_card.tres
msgid "Removing a <term:glyph> from your <term:card_deck> for the rest of an <term:run>. By default, the minimum size of your <term:card_deck> is 10 <term_lower:glyph>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_reroll.tres
#: stage/card_reward_choice.tscn
#: stage/stage_goal_tracker.gd:145
#: stage/stage_goal_tracker.tscn
msgid "Reroll"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_reroll.tres
msgid "Rerolling"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_reroll.tres
msgid "Getting new random choices when offered to choose a <term:glyph> or <term:relic>. Rerolls can be gained by unlocking <term:skill>s, but can only be used a limited number of times per <term:run>."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_reserve_card.tres
#: stage/card_reward_choice.gd:147
#: stage/card_reward_choice.tscn
msgid "Reserve"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_reserve_card.tres
msgid "Reserving Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_reserve_card.tres
msgid "Marking a <term:glyph> reward option as reserved. This will guarantee that the same <term:glyph> will appear the next time you are offered a <term:glyph> to choose."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_run.tres
msgid "Expedition"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_run.tres
msgid "A full journey to restore a <term:world_shard>, made up of multiple <term:season>s."
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_salvage.tres
msgid "Salvaging Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_salvage.tres
msgid "Choosing a <term:glyph> from your <term:card_deck> at the end of a completed <term:run> to convert into <term:stroke>s which can be used to <term:craft> new <term:glyph>s in the <term:hub>."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: title
#: glossary/terms/standalone/term_satisfy_lack.tres
#: map/settlement.tscn
msgid "Fulfill"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_satisfy_lack.tres
msgid "Fulfilling Shortages"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_satisfy_lack.tres
msgid "Fulfilling a <term:settlement>'s <term:lack> by completing a <term:harmonization_recipe> during <term:harmonization>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_season.tres
msgid "Phase"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_season.tres
msgid "One part of an <term:run>, where you establish several <term:settlement>s then <term_lower:connect_settlement> them to the <term:capital>."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_settlement.tres
#: map/settlement.tscn
msgid "Settlement"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_settlement.tres
msgid "A <term:location> that has been settled after a <term:foray> and now contributes to the <term:world_shard>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_settler_quest.tres
msgid "Settler Quest"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_settler_quest.tres
msgid "A task offered by a settler that lasts a single <term_lower:run> and adds a difficulty modifier."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_shard_type.tres
msgid "Shard Culture"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_shard_type.tres
msgid "The type of society a given <term:world_shard> can develop. Shards with notable cultures are revealed at the end of an <term:run>, based on the yields, narrative choices, or other decisions made by its settlers."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: text
#: glossary/terms/standalone/term_shop.tres
#: map/settlement.tscn
msgid "Landmark"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_shop.tres
msgid "A permanent unique development in a <term_lower:settlement> where you can invest <term:bonus>s to gain powerful benefits or upgrades."
msgstr ""

#. TRANSLATORS: Property: term_name
#. Property: skill_name
#: glossary/terms/standalone/term_signature_card.tres
#: skills/craft/skill_craft_signature_1.tres
msgid "Signature Glyph"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_signature_card.tres
msgid "A <term:glyph> which you choose to add to your <term:card_deck> at the beginning of an <term:run>. You can only choose <term:glyph>s which you have previously <term:craft>d."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_simple.tres
msgid "Simple"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_simple.tres
msgid "Simple Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_simple.tres
msgid "<term:glyph>s with one <term:aspect> and no <term:card_ability>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_skill.tres
msgid "Skill"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_skill.tres
msgid "An ability permanently unlocked in the <term:hub> by spending <term:insight>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_slot_card.tres
msgid "Slot"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_slot_card.tres
msgid "Slotting Glyphs"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_slot_card.tres
msgid "Using a <term_lower:glyph> for its <term:aspect> to <term_lower:fill> an <term:aspect_slot>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_spot.tres
msgid "Site"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_spot.tres
msgid "A small feature within a <term:foray>, like a forest or a ruin, which serves as a base for <term:spot_upgrade>s that produce <term:bonus>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_spot_upgrade.tres
msgid "Development"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_spot_upgrade.tres
msgid "A specific transformation of a <term:spot>, shaped by <term:aspect>s and providing various <term:bonus>s. You can only choose one Development per tier. Higher-tier upgrades for that path stay open."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_stage.tres
msgid "Stage"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_stage.tres
msgid "A <term:foray>, <term:harmonization>, or <term:survey>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_stage_goal.tres
msgid "Foray Goal"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_stage_goal.tres
msgid "A type of <term:bonus> required to complete a <term:foray> without losing <term:inspiration>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_stage_specialization.tres
msgid "Specialization"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_stage_specialization.tres
msgid "Settlement Specialization"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_stage_specialization.tres
msgid "A type of <term:bonus> that a <term:settlement> can provide. <term:connect_settlement> this <term:settlement> to the <term:capital> to share the <term_lower:bonus> with <term_lower:settlement>s that have a <term_lower:lack> of this <term_lower:bonus>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_stroke.tres
msgid "Stroke"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#: glossary/terms/standalone/term_stroke.tres
msgid "Glyph Stroke"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_stroke.tres
msgid "Pieces of a <term_lower:glyph> that can be used to <term_lower:craft> new <term_lower:glyph>s in the <term:hub>, to use as <term:signature_card>s at the start of an <term_lower:run>. Strokes are acquired when you <term_lower:salvage> <term_lower:glyph>s at the end of a completed <term_lower:season>."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_survey.tres
#: pause_menu/pause_menu.gd:209
msgid "Survey"
msgstr ""

#. TRANSLATORS: Property: long_term_name
#. Property: text
#: glossary/terms/standalone/term_survey.tres
#: hub/shard_explorer/past_run_survey.tscn
msgid "Regional Survey"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_survey.tres
msgid "A brief exploration of a map region, where a survey team scouts the wilderness in preparation for future forays. Consists of several <term:encounter>s resolved using <term_lower:glyph>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_task.tres
msgid "Task"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_task.tres
msgid "A task that requires <term_lower:aspect>s to accomplish, encountered during <term_lower:survey>s and <term_lower:harmonization>s."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_turn.tres
msgid "Turn"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_turn.tres
msgid "The period during which you play a single <term_lower:hand> of <term_lower:glyph>s before <term_lower:redraw>ing or finishing a <term_lower:stage>. By default, each <term_lower:stage> consists of two turns."
msgstr ""

#. TRANSLATORS: Property: term_name
#: glossary/terms/standalone/term_world_shard.tres
msgid "World Shard"
msgstr ""

#. TRANSLATORS: Property: markedup_description
#: glossary/terms/standalone/term_world_shard.tres
msgid "A broken fragment of the Old World, floating in the Cloud Sea, now ready to be restored into a new home for <term:refugee>s."
msgstr ""

