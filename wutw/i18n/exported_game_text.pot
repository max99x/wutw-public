#: stage/spots/swamp/upgrade_swamp_2_mud_brick_works.tres
msgid "Mud Brick Works"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_mud_brick_works.tres
msgid "What some see as filth, brickmakers see as future walls."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_reed_weaver_lodge.tres
msgid "Reed Weaver's Hut"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_reed_weaver_lodge.tres
msgid "Reeds are woven into huts, and huts into communities, or occasionally into stories of gracefully collapsing roofs."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_3_alchemist_retreat.tres
msgid "Alchemist's Retreat"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_3_alchemist_retreat.tres
msgid "Here dwells the sort of person who considers a minor explosion to be the sign of a job well done."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_3_sunken_fortress.tres
msgid "Sunken Fortress"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_3_sunken_fortress.tres
msgid "Moss-covered walls rise from the murky depths, a testament to ancient stubbornness."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/spot_wasteland.tres
msgid "The follies of the past have sapped this land of life, yet it still holds many a lesson in survival."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_1_boneyard.tres
msgid "Boneyard"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_1_boneyard.tres
msgid "Bleached remains of beasts whose hooves once thundered here."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_1_rock_garden.tres
msgid "Rock Garden"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_1_rock_garden.tres
msgid "A quilt of pebbles in intricate patterns, bound by a vow of stillness."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_1_salt_flat.tres
msgid "Salt Flats"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_1_salt_flat.tres
msgid "A tasty crystalline mirror sparkling beneath the sun."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_2_glass_dunes.tres
msgid "Glass Dunes"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_2_glass_dunes.tres
msgid "No one knows what melted the sands to make these dunes, but perhaps it is knowledge best forgotten."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_2_outpost.tres
msgid "Ruined Outpost"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_2_outpost.tres
msgid "Half-collapsed ramparts bristle with new scaffolds, making for a charming mess of a shelter."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_2_storm_camp.tres
msgid "Storm Chaser Camp"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_2_storm_camp.tres
msgid "The scholars gathered here believe that the Shattering can be understood by studying the storms."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_2_wreck.tres
msgid "Iron Wreck"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_2_wreck.tres
msgid "Curiously, these giants are found in wastelands all across the shards."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_3_endless_ruin.tres
msgid "This warren of caves teases scholars and treasure hunters with gleaming fragments of lost technology."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/wasteland/upgrade_wasteland_3_storm_castle.tres
msgid "Stormwatch Citadel"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/wasteland/upgrade_wasteland_3_storm_castle.tres
msgid "A stern fortress scarred by the storms, ramparts covered with lightning rods."
msgstr ""

