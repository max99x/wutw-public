#: stage/spots/building_large/upgrade_building_large_2_library.tres
msgid "Archives"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/building_large/upgrade_building_large_2_library.tres
msgid "Scrolls from the Old World sit snugly next to new census records and poetry compilations."
msgstr ""

