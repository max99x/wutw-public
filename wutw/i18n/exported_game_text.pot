msgstr ""

#. TRANSLATORS: Property: paths[]
#: shard_types/resourcegroup_shard_types.tres
msgid "res://shard_types/food_heaven/shard_type_food_heaven.tres"
msgstr ""

#. TRANSLATORS: Property: paths[]
