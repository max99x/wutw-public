msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/spot_square.tres
msgid "The heart of a community long gone. Who knows what sizzling morsels dripped upon its cobbles in ages past."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_1_festival_grounds.tres
msgid "Festival Grounds"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_1_festival_grounds.tres
msgid "A place to forget the toils of the year, and lose oneself in the rush of the crowd."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_1_notice_board.tres
msgid "Notice Board"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_1_notice_board.tres
msgid "Need a job? Lost a cat? Seeking a reliable matchmaker? The board is here for you."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_1_well.tres
msgid "Public Well"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_1_well.tres
msgid "A hole in the ground becomes the core of the town, once water starts seeping in."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_bathhouse.tres
msgid "Steam rises, beckoning the weary. Modesty is not tolerated here."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_2_market.tres
msgid "Marketplace"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_market.tres
msgid "Stalls groan under baskets of fruit, crates of hammers, and the most fashionable kimonos."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_monument.tres
msgid "Our ancestors rest in the carvings on this stone."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_2_philosophy_corner.tres
msgid "Philosophy Corner"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_philosophy_corner.tres
msgid "Those who linger too long may leave with more questions than they arrived with."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_poet_arena.tres
msgid "Here, words strike, parry, and dance, eager to earn the audience's tears."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_2_sumo_ring.tres
msgid "Sumo Ring"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_2_sumo_ring.tres
msgid "A contest of strength and balance, fueled by many a hearty stew."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/square/upgrade_square_3_theater.tres
msgid "Dragonfly Theater"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/square/upgrade_square_3_theater.tres
msgid "Every shard has its own Dragonfly troupe, preserving a tradition from before the Shattering."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/spot_steppe.tres
msgid "The song of the wind rustles through this sea of grass, in harmony with birds, crickets, and maybe one day chimes."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_1_clay_pits.tres
msgid "Clay Pits"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_1_clay_pits.tres
msgid "The shard's flesh is soft here, waiting for patient hands to shape it."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_1_painted_pillars.tres
msgid "Painted Pillars"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_1_painted_pillars.tres
msgid "In the Old World, rulers commissioned these to leave their mark on the earth."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_1_thistle_fields.tres
msgid "Thistle Fields"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_1_thistle_fields.tres
msgid "Little balls of spines, better admired from afar."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_ant_colony.tres
msgid "Ant Colony"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_ant_colony.tres
msgid "Ten thousand tiny workers, perfectly organized. If only people were this reliable."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_cricket_choir.tres
msgid "Cricket Choir"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_cricket_choir.tres
msgid "Every evening the great insect orchestra performs a concert, whether they have an audience or not."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_dancing_windsocks.tres
msgid "Dancing Windsocks"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_dancing_windsocks.tres
msgid "The wind has pets. They are long, colorful, and very bad at staying still."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_lonely_cairns.tres
msgid "Lonely Cairns"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_lonely_cairns.tres
msgid "Each passerby adds a rock, reminding the next that they are not alone."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_pottery_kiln.tres
msgid "Pottery Kiln"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_pottery_kiln.tres
msgid "Once the timid clay decides on its shape, this fire gives it backbone."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_2_wind_chimes.tres
msgid "Wind Chimes"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_2_wind_chimes.tres
msgid "Simple devices to turn wind into music. Somehow always in tune."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_3_migratory_crossroads.tres
msgid "Avian Crossroads"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_3_migratory_crossroads.tres
msgid "Birds gather here to refuel and exchange directions before migration."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/steppe/upgrade_steppe_3_painted_ceramics_workshop.tres
msgid "Painted Ceramics Workshop"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/steppe/upgrade_steppe_3_painted_ceramics_workshop.tres
msgid "A cup may quench thirst, but a painted cup quenches the thirst of the soul."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/spot_swamp.tres
msgid "This soggy land holds much bounty, if one is careful, daring, or unruffled by a little mud."
msgstr ""

