#: stage/settlement_names.tres
#: stage/spots/desert/upgrade_desert_2_mirage_gate.tres
msgid "Mirage Gate"
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_composed_nojukubi.tres
msgid "Wildfire"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_composed_nojukubi.tres
msgid "The grass blades were taken from the kappa image, and the flames from the sun and flames image."
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_composed_shards_from_a_balcony.tres
msgid "Shards from a Balcony"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_composed_shards_from_a_balcony.tres
msgid "This takes the overall frame from [url=art_piece:Production of Bogwood Carvings in Matsushima]the Bogwood Carvings print[/url], crops out the floor, edits out the text overlays and the second woman, then replaces the sea and ships with an expanse of clouds from [url=art_piece:Fine Wind, Clear Morning]the Red Fuji print[/url]."
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_composed_shard_maps.tres
msgid "Shard Maps"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_composed_shard_maps.tres
msgid ""
"The shard maps in Worlds Upon The Wind are composed from an endless remix of elements, based on [url=https://kmalexander.com/2023/12/13/moronobu-mokuhanga-a-free-17th-century-cartography-brush-set-for-fantasy-maps/]K.M. Alexander's brushes[/url], which were made by isolating elements from [url=artist:Hishikawa Moronobu]Hishikawa Moronobu[/url]'s travel guide called [url=art_piece:A Charted Map of the Tōkaidō]A Charted Map of the Tōkaidō[/url].\n"
"\n"
"Although the map started by reusing these brushes, most of the artwork was later redrawn, and many new elements were added while trying to maintain a consistent style."
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_composed_spider_cave.tres
msgid "Spider Cave"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_composed_spider_cave.tres
msgid "The image was composed by taking the actor print as the base and layering the spiderwebs from the shrike print over the dark background behind the subject."
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_composed_stalls.tres
msgid "Stalls"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_composed_stalls.tres
msgid "The image was composed by cutting out characters from the many pieces in the series and rearranging them to fit the desired size. The background was redone, weapons were edited out, and some facial expressions were edited to look happier."
msgstr ""

#. TRANSLATORS: Property: name
#. Property: event_name
#. Property: title
#. Property: text
#: art/pieces/piece_composed_stone_of_remembrance.tres
