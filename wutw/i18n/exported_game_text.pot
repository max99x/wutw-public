#: stage/spots/brushland/upgrade_brushland_3_paper_artisan_studio.tres
msgid "Paper Studio"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_3_paper_artisan_studio.tres
msgid "These trees are special. The bark they shed will last generations."
msgstr ""

