#: stage/spots/brushland/upgrade_brushland_2_indigo_shrub_patch.tres
msgid "Indigo Shrub Patch"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_2_indigo_shrub_patch.tres
msgid "The first steps towards the deep blue start with this humble shrubbery."
msgstr ""

