#: stage/spots/swamp/upgrade_swamp_1_murky_trail.tres
msgid "Murky Trail"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_1_murky_trail.tres
msgid "A path barely worthy of the name, guaranteed to leave your sandals full of mud."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_1_peat_bog.tres
msgid "Peat Bog"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_1_peat_bog.tres
msgid "The wise cutter knows which ground yields warmth and which swallows feet."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_1_rice_paddy.tres
msgid "Turns out stagnant puddles can feed a whole town if treated properly."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_apothecary_hut.tres
msgid "Apothecary Hut"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_apothecary_hut.tres
msgid "Roots, herbs, and mushrooms are mixed here in auspicious ratios to keep illness at bay."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_charcoal_burner_camp.tres
msgid "Charcoal Burners Camp"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_charcoal_burner_camp.tres
msgid "The locals may grumble about the soot, yet the complaints stop when the weather turns chilly."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_footbridge_network.tres
msgid "Footbridge Network"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_footbridge_network.tres
msgid "The planks are mismatched and the footing is narrow, but it beats navigating the muck."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_fungal_garden.tres
msgid "Fungal Garden"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_fungal_garden.tres
msgid "Old logs are collected here, soon to erupt into flushes of tasty mushrooms."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/swamp/upgrade_swamp_2_glowing_lantern_path.tres
msgid "Glowing Lantern Path"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/swamp/upgrade_swamp_2_glowing_lantern_path.tres
msgid "Lanterns lead deep into the bog, far past the safe trails."
msgstr ""

