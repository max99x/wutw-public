msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_chapter33.tres
msgid "Depicts a scenes from chapter 33 of the Tale of Genji, a wisteria-viewing banquet where the marriage of Genji's son Yugiri is arranged."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_chapter44.tres
msgid "Chapter 44: Bamboo River (Takegawa)"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_chapter44.tres
msgid "Text and cloud overlays were edited out, and a campfire was added."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_chapter44.tres
msgid ""
"Depicts a scene from chapter 44 of the Tale of Genji, where Kaoru (nominally Genji's son, but in reality the son of his nephew) sits with Fujiwara Chamberlain. The scenery of the wisteria-draped pine tree likely references Kaoru's poem:\n"
"\n"
"[i]If it were a thing\n"
"that one could take in the hand,\n"
"the wisteria,\n"
"would I have ever seen the\n"
"color that outdoes the pine.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_chimneys.tres
msgid "100 Views of Mount Fuji, #61"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_cranes_on_beach.tres
msgid "Cranes on a Branch"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_deer_on_bridge.tres
msgid "Deer on a Bridge"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_dragon_priest.tres
msgid "Holy Man Genku at Sakura-ga-ike"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_dragon_priest.tres
msgid "The text and the dragon were edited out, and the image was flipped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_dragon_priest.tres
msgid "Depicts a legendary Dragon King appearing before a Buddhist priest, Genku Honen (1133-1212) at lake Sakura-ga-ike. These lakes in the mountains, often with hot streams or caves, were often associated with the appearance of dragons and deities."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_emperor_go_daigo.tres
msgid "Emperor Go-Daigo"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_emperor_go_daigo.tres
msgid "The text overlay and dreamed silhouettes were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_emperor_go_daigo.tres
msgid "Emperor Go-Daigo dreaming of ghosts at the imperial palace on Mount Kasagi."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_enoshima.tres
msgid "Enoshima"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_enoshima.tres
#: art/pieces/piece_gekkou_yamabushi.tres
msgid "The background was edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_foxes_shrine.tres
msgid "Foxes with Lanterns Leave a Forest Shrine on a Foggy Night"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_foxes_shrine.tres
msgid "Depicts a procession of fox spirits, often considered messengers of the Shinto deity Inari. There are multiple folk tales in Japan that speak of foxes putting on clothes, carrying lanterns, and visiting forest shrines at night."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_fuji_24.tres
msgid "100 Views of Mount Fuji, #24"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_masaaki.tres
msgid "Mase Kyudayu Masaaki"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_masaaki.tres
msgid "Depicts Mase Kyudayu Masaaki, one of the 47 Ronin (masterless samurai), applying his fingerprint to a document. The label describes Masaaki as ometsuke rank, with a 200-koku stipend, and aged 62 at death."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_momotarou.tres
msgid "Momotarō"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_momotarou.tres
msgid "Depicts Momotarō (\"peach son\"), a popular hero of Japanese folklore. He is born from a peach and grows up to fight various monsters with his animal companions."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_morning_glory.tres
msgid "Morning Glory"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_onodera_koemon_hidetomi.tres
msgid "Onodera Koemon Hidetomi"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_onodera_koemon_hidetomi.tres
#: art/pieces/piece_gekkou_shunkan_in_exile.tres
msgid "The background and the weapons were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_onodera_koemon_hidetomi.tres
msgid "Onodera Koemon Hidetomi, one of the 47 Ronin (masterless samurai). The label describes Hidetomi as an adopted son of Hidekazu, a younger brother of Otaka Tadao, and aged 28 at death."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_plum_and_flycatcher.tres
msgid "Plum and Flycatcher"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_priest_saigyo.tres
msgid "Priest Saigyō Hōshi"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_priest_saigyo.tres
msgid "Depicts Saigyō Hōshi (1118-1190), a Japanese poet and monk who lived during the late Heian and early Kamakura period. He lived much of his life as a hermit, but is known for the many long, poetic journeys he took to Northern Honshū that would later inspire the great poet Matsuo Bashō."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: card_name
#: art/pieces/piece_gekkou_rainbow.tres
#: cards/tier4/card_rainbow.tres
msgid "Rainbow"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_sewing.tres
msgid "Sewing"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_shinto_dancer.tres
msgid "Shinto Dancer"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_shinto_shrine.tres
msgid "Usa Hachiman Shrine: Wake no Kiyomaro"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_shinto_shrine.tres
msgid "Only the person is cut out and used within a larger composition."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_shinto_shrine.tres
msgid "Depicts a famous aristocrat, Wake no Kiyomaro, kneeling before a Shinto altar at Usa Hachiman Shrine. He wears a flowing brown tunic over a red robe with silver mica accents, and white pants. The altar is set with bowls and pots containing offerings, and a vase holding evergreen foliage."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_shrine_in_forest.tres
msgid "Shrine and Branch"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_shunkan_in_exile.tres
msgid "Shunkan in Exile"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_shunkan_in_exile.tres
msgid "Depicts a scene from Tales of the Heike, where Shunkan, a 12th-century Buddhist priest is exiled to a remote island after a failed plot against Taira no Kiyomori. He is known for being left behind alone in ultimate despair while his companions are pardoned."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_sotoori_spider.tres
msgid "Princess Soto'ori and Spider"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_sotoori_spider.tres
#: art/pieces/piece_hiroshige_2_asukayama.tres
#: art/pieces/piece_unknown_cat_and_toad.tres
msgid "The text overlays were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_sotoori_spider.tres
msgid ""
"Depicts the legendary [url=https://en.wikipedia.org/wiki/Princess_Sotoorihime]princess Soto'ori[/url], considered to be one of the three Gods of Poetry.\n"
"\n"
"This print is likely inspired by a famous poem attributed to her:\n"
"\n"
"This is the night\n"
"my husband will come.\n"
"The little crab-\n"
"spider's action\n"
"tonight is manifest.\n"
"\n"
"According to the legend, while she was waiting for a late-night visit from Emperor Ingyō, she noticed a spider descending from the ceiling. At the time it was believed that the arrival of a spider was an omen that a lover was coming to visit."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_takarabune.tres
msgid "Treasure Boat"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_takarabune.tres
msgid "Depicts a takarabune (\"treasure ship\"), a mythical vessel from Japanese folklore, believed to sail into port during the first three days of the New Year, carrying the Seven Lucky Gods. It symbolizes good fortune, wealth, and prosperity, with roots in the Edo period when people placed pictures of it under their pillows for a lucky first dream."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_takenouchi_sukune.tres
msgid "Statesman Take-no-uchi no Sukune"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_gekkou_takenouchi_sukune.tres
msgid "The person in the background was edited out and a branch was added."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_takenouchi_sukune.tres
msgid ""
"Depicts Take-no-uchi no Sukune proving his innocence by putting his hand into boiling water without getting burns.\n"
"\n"
"Sukune was a legendary hero and statesman of the 1st century, enshrined as a divine figure. He is recorded in Japan's earliest literary texts, the Kojiki (ca. 712) and the Nihon Shoki (720). He reportedly served under 5 legendary emperors, but is best known as the Grand Minister to the Regent Empress Jingū, with whom he supposedly invaded Korea. While Jingu was regent to her son, Ōjin, Takenouchi was accused of treason. He underwent the \"ordeal of boiling water\" as a way to prove his innocence."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_temple_bell.tres
#: art/pieces/piece_kouhou_temple_bell.tres
msgid "Temple Bell"
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: companion_name
#: art/pieces/piece_gekkou_tiger.tres
#: art/pieces/piece_oukyo_tiger.tres
#: art/pieces/piece_raijirou_tiger.tres
#: companions/tiger/companion_tiger.tres
msgid "Tiger"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_gekkou_yamabushi.tres
msgid "Yamabushi"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_gekkou_yamabushi.tres
msgid ""
"Depicts a [url=https://en.wikipedia.org/wiki/Yamabushi]yamabushi[/url] (\"one who prostrates oneself on the mountain\"), a mountain ascetic hermit, heading for Myōgisan temple.\n"
"\n"
"The hermit is accompanied by another person, who is listed as his servant. Allegedly, at the time such hermits could have acolytes or hired porters, and one of such people may be depicted here."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_ginkou_mayumi.tres
msgid "Mayumi the Brave Woman"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_ginkou_mayumi.tres
msgid "The stamps and the weapons were edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_ginkou_mayumi.tres
msgid "Depicts a female samurai dragging a man who is begging for mercy. I was unable to find any reference to a historical or fictional character named Mayumi that could fit this depiction."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_goyou_yabakei_rain.tres
msgid "Rain at Yabakei"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_goyou_yabakei_rain.tres
msgid "The huts, the horse, and the distant figure were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_goyou_yabakei_rain.tres
msgid ""
"Depicts a horse-drawn cart in the rain on a road near Yabakei, Ōita prefecture. The cart has a large umbrella attached, and a child nearby is holding a small one. The color scheme is notable, as the foreground uses an unusually vivid palette, while the background is muted.\n"
"\n"
"The composition is considered a masterpiece and was inspired by Goyō's journey to Beppu and Yabakei in 1910. The early sketches were titled Running in the Rain along the Yamakuni River.\n"
"\n"
"This print was Goyō's first work as both artist and publisher. He hired an engraver, Takano Shichinosuke, and a printer, Somekawa Kanzō, and the whole team lived together."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hanko_karabitsu.tres
msgid "Mount Karabitsu Kuchi-e"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hanko_karabitsu.tres
msgid ""
"Depicts a woman reading a letter while resting in a hammock against a lush background.\n"
"\n"
"This print is a frontispiece illustration for the book Mount Karabitsu, published in vol. 6 no. 9 of Bungei Kurabu, a popular literary magazine in Meiji-Taishō period. The mountain is fictional."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_harunobu_leap.tres
msgid "Young Woman Jumping from the Kiyomizu Temple Balcony with an Umbrella"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_harunobu_leap.tres
#: art/pieces/piece_shuntei_oomukade.tres
#: art/pieces/piece_yoshitoshi_priest_raigo.tres
msgid "The background was removed and the image was recolored."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_harunobu_leap.tres
msgid ""
"Depicts a young woman falling through the air holding an umbrella. The origin of her jump is a platform in the Kiyomizu Dera, one of the main Buddhist temples in Kyōto, established in 778. The temple is still active today, serving as a major tourist destination, but given the crowds, I can't recommend it unless you go in the off-season.\n"
"\n"
"The expression \"to jump off the stage at Kiyomizu\" is the Japanese equivalent of the English expression \"to take the plunge\". This refers to an Edo-period tradition that held that if one survived a 13-meter jump from the stage, one's wish would be granted. During the Edo period, 234 jumps were recorded, and of the jumpers, 85% survived. The practice was banned in 1872."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_harunobu_vinegar_tasters.tres
msgid "Parody of the Three Vinegar Tasters"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_harunobu_vinegar_tasters.tres
msgid ""
"Depicts three women around a large jar of vinegar. This is a parody of the famous subject of multiple Chinese paintings [url=https://en.wikipedia.org/wiki/Vinegar_tasters]The Vinegar Tasters[/url], where three men are tasting vinegar and reacting with sour, bitter, and sweet expressions.\n"
"\n"
"It is an allegory, and the identity of the 3 subjects is interpreted in several different ways. The variation relevant in our case is to have them represent Confucius, Buddha, and Laozi, the respective founders of Confucianism, Buddhism, and Taoism. Each man's expression represents the attitude of his philosophy: Confucianism saw life as sour and in need of correction, Buddha saw life as bitter due to desire (arguable), and Laozi saw life as sweet because the natural state is perfection.\n"
"\n"
"Some museums (e.g. MFA Boston) attribute this print to a different artist, Komatsuken, but the version displayed here carries a clear Harunobu signature."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_harunobu_yamabe.tres
msgid "Poem by Yamabe no Akahito, from One Hundred Poems by One Hundred Poets"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_harunobu_yamabe.tres
#: art/pieces/piece_hasui_ryugashima.tres
#: art/pieces/piece_hiroshige_3_wicker_trunks.tres
#: art/pieces/piece_hiroshige_higo.tres
#: art/pieces/piece_hiroshige_kirifuri.tres
#: art/pieces/piece_koson_playing_monkeys.tres
#: art/pieces/piece_kuniyoshi_calligraphy_gathering.tres
#: art/pieces/piece_kyosai_tiger_screen.tres
#: art/pieces/piece_shoutei_night_rain.tres
msgid "The image was cropped and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_harunobu_yamabe.tres
msgid ""
"Depicts two young women collecting brine in buckets at Tago Bay (present-day Shizuoka prefecture), with Mount Fuji in the distance. Although the exact location is unknown, it was a scenic coastal inlet famous for its salt flats, turbulent waters, and iconic views of Mount Fuji, as well as being the subject of many ukiyo-e prints.\n"
"\n"
"The inscription at the top is a poem about the area by Yamabe no Akahito, a famous 8th-century poet:\n"
"\n"
"[i]In Tago Bay,\n"
"if you look in the distance,\n"
"on the pure white\n"
"peaks of Mount Fuji\n"
"the snow continues to fall.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_arayu_road.tres
msgid "Arayu Road, Shiobara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_arayu_road.tres
msgid "Only the ground texture was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_arayu_road.tres
msgid ""
"Depicts a field in Shiobara, in Tochigi prefecture.\n"
"\n"
"Hasui's notes state: \"This plateau of mostly oak trees is located at the top of the road leading from the town of Furumachi to Arayu Spa. It was mid-autumn; the oak leaves were turning red and the field was completely yellow. I tried to express the grandiose beauty of nature in autumn by contrasting the distinct cobalt-blue mountains with the floating clouds in an infinite sky.\""
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_asahi_peak.tres
msgid "Mount Asahi seen from Mount Hakuba"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_asahi_peak.tres
msgid "Depicts a view of Mount Asahi near Nagano prefecture. The depiction is more realistic than the typical ukiyo-e style, being [url=art_style:shin-hanga]shin-hanga[/url], and does not include any sign of human impact."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_autumn_garden.tres
msgid "Autumn Garden"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_autumn_garden.tres
#: art/pieces/piece_hasui_hinomisuki.tres
#: art/pieces/piece_hiroshige_nissaka2.tres
msgid "The text was removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_autumn_garden.tres
msgid ""
"Depicts a small wooden bridge over a garden pond.\n"
"\n"
"This was part of a series illustrating the estate of the Iwasaki family, founders of the Mitsubishi conglomerate. The series was allegedly commissioned by the company as gifts for their clients, though I have not been able to reliably confirm this.\n"
"\n"
"Today, this location in the Fukagawa district of Tōkyō is part of [url=https://www.japan-guide.com/e/e3034_006.html]Kiyosumi Garden[/url], which is open to visitors."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_deer.tres
msgid "The Kasuga Shrine in Nara"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_deer.tres
#: art/pieces/piece_yoshida_deer.tres
msgid "Depicts deer by the Kasuga shrine in Nara. These deer are still around today, and are notorious for pestering tourists. Yours truly has almost had his ice cream stolen by one of them."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_harbor_at_night.tres
msgid "Harbor at Night, Otaru"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_harbor_at_night.tres
msgid ""
"Two figures standing on the dock enjoying the harbor at night in Otaru, near the Northern tip of Japan.\n"
"\n"
"According to Kendall Brown in Visions of Japan, Hasui considered this one of his best works."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_hinomisuki.tres
msgid "Hinomisuki, Izumo"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_hinomisuki.tres
msgid ""
"Depicts a night scene along the coast of Izumo (present-day Shimane prefecture), showing a cluster of weathered pines against a stormy sea.\n"
"\n"
"Although this is a 20th-century [url=art_style:shin-hanga]shin-hanga[/url] print, it was printed entirely in shades of blue, similar to the 19th-century [url=art_style:aizuri]aizuri[/url] style."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_ioridani.tres
msgid "Ioridani Pass, Etchū"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_ioridani.tres
msgid "The buildings and bridges were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_ioridani.tres
msgid ""
"Depicts a bird's eye view of the Iori Valley pass in Etchū (present-day Toyama prefecture).\n"
"\n"
"The river (which I believe is called Jinzu now) weaves through the valley, surrounded by high walls dotted with buildings, appearing as nothing more than points of light. Several bridge hang across the river.\n"
"\n"
"The background features distant wooded mountains, against a hint of setting sun."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_irises.tres
msgid "Irises"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_irises.tres
msgid ""
"Depicts a thick patch of irises, with maroon, purple, and white flowers.\n"
"\n"
"Several museums list this as the only purely floral design by Hasui."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_karatsu_ruins.tres
msgid "Ruins of Rice Warehouses, Karatsu"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_karatsu_ruins.tres
msgid "The boat was removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_karatsu_ruins.tres
msgid "Depicts a ruined rice warehouse in the coastal town of Karatsu in Saga prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_lotus.tres
msgid "Shiba Benten Pond"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_nigatsu_hall.tres
msgid "Nigatsu Hall, Nara"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_nigatsu_hall.tres
msgid ""
"Depicts a view from the veranda of Nigatsu-dō (\"second month hall\"), one of the important structures of Tōdai-ji, the main temple complex in Nara, the ancient capital of Japan. Nigatsu-dō was first established in 752, but has been rebuild numerous times since.\n"
"\n"
"It is best known for Omizutori, a fire and water ceremony held annually on the 12th of March. It includes monks holding huge flaming torches from the temple balcony, and on the next day drawing sacred water from a well under the temple. The ceremony has been held without a break for over 1200 years."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_nikko_day.tres
msgid "An Avenue at Nikko"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_nikko_day.tres
msgid "The man was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_nikko_day.tres
msgid ""
"Depicts a a man carrying a basket through a cedar-lined road.\n"
"\n"
"The location is the famous Nikko Cedar Avenue, the longest tree-lined road in the world, with 12,000 cedars still there today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_nikko_night.tres
msgid "An Avenue of Cryptomerias, Nikko"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_nikko_night.tres
msgid "The man and animal were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_nikko_night.tres
msgid ""
"Depicts a night-time scene of a man leading a pack animal loaded with firewood through a cedar-lined road.\n"
"\n"
"The location is the famous Nikko Cedar Avenue, the longest tree-lined road in the world, with 12,000 cedars still there today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_omiya.tres
msgid "Rain at Omiya"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_omiya.tres
msgid "One of the huts was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_omiya.tres
msgid "Depicts a rainy night scene in a marshy area of Ōmiya, a ward of Saitama city in Saitama prefecture. The warm glow in the windows of two huts is reflected in the water."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_pine_island.tres
msgid "Evening Rain on the Pine Island"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_pine_island.tres
msgid "The supports were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_pine_island.tres
msgid ""
"Depicts a large pine on a small islet in a pond within a garden.\n"
"\n"
"This was part of a series illustrating the estate of the Iwasaki family, founders of the Mitsubishi conglomerate. The series was allegedly commissioned by the company as gifts for their clients, though I have not been able to reliably confirm this.\n"
"\n"
"Today, this location in the Fukagawa district of Tōkyō is part of [url=https://www.japan-guide.com/e/e3034_006.html]Kiyosumi Garden[/url], which is open to visitors."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_ryugashima.tres
msgid "Ryūga Island, Oga Peninsula"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_ryugashima.tres
msgid ""
"Depicts a rock formation surrounded by serene waters in Oga Quasi-National Park on the coast of Akita prefecture. The rock are painted red by the rising (or possibly setting) sun.\n"
"\n"
"This rock formation is called ryū-ga-shima (\"dragon island\"), possibly due to its resemblance to a dragon's jaw. Part of it collapsed during the 1939 Oga earthquake."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_sanpoji_pond.tres
msgid "Sanpoji Pond, Shakujii"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_sanpoji_pond.tres
msgid "Depicts a night scene of an old pond in Shakujii, Tōkyō in front of a forest."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_torii_and_lantern.tres
msgid "Evening at Miyajima"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_torii_and_lantern.tres
msgid "Shows the famous half-submerged Itsukushima Shrine Torii Gate on Miyajima Island, still standing today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_tsukumojima.tres
msgid "Kujukushima, Shimabara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hasui_tsukumojima.tres
#: art/pieces/piece_hiroshige_2_rock_tripe.tres
#: art/pieces/piece_hiroshige_hakone.tres
#: art/pieces/piece_hiroshige_hida.tres
#: art/pieces/piece_hiroshige_otsukihara.tres
#: art/pieces/piece_hiroshige_sakanoshita.tres
#: art/pieces/piece_hiroshige_secret_scroll.tres
#: art/pieces/piece_hiroshige_tsuchiyama.tres
#: art/pieces/piece_hiroshige_tsurumaki.tres
#: art/pieces/piece_hokkei_snake_melons.tres
#: art/pieces/piece_hokusai_bunya_asayasu.tres
#: art/pieces/piece_kuniyoshi_tang_long.tres
#: art/pieces/piece_oukyo_tiger.tres
#: art/pieces/piece_shoutei_ashitakayama.tres
msgid "The text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hasui_tsukumojima.tres
msgid "Depicts two people in a boat approaching one of the Kujukushima (\"99 islands\"), a group of islands on the west coast of Kitamatsuura peninsula in Nagasaki prefecture. Although named 99 islands, the official count is 208."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hasui_yuhi_waterfall.tres
msgid "Yuhi Waterfall in Shiobara"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hirokage_foxes.tres
msgid "The Fox Fires of Ōji"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hirokage_foxes.tres
msgid "The foxes in the foreground and the fox-fires were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hirokage_foxes.tres
msgid "Depicts fox spirits acting out a comical version of a daimyō's (feudal lord's) procession. They are carrying pumpkin instead of travelling bags and holding a bamboo stick with hanging corn instead of a spear. The man sitting in a bamboo basket seems to be delighted, bewitched by the foxes to feel as if he were a feudal lord. The place is near the Ōji Inari Shrine. It was said that foxes gathered to the Shrine on New Year's Eve, and farmers forecasted next year's harvest by the number of fox fires they saw."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hirosada_ducks.tres
msgid "Actors as Mandarin Ducks"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hirosada_ducks.tres
msgid "Only the right panel was used, and the text was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hirosada_ducks.tres
msgid ""
"Depicts three actors as mandarin ducks: Nakamura Tamashichi (R), Arashi Rikaku II (C), and Sawamura Kitō (L).\n"
"\n"
"The piece was allegedly used to promote the play Aratamaru Oshi no Omoiba (To Think How the Mandarin Ducks Have Changed)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_asukayama.tres
msgid "Cherry-blossom Viewing at Mount Asuka"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_bellflower_field.tres
msgid "Bellflower Meadow, Shinshū Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_bellflower_field.tres
msgid "Only the field and sky were used, extended to cover all other parts of the image. Additional versions add on various layers on top."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_burdock.tres
msgid "Burdock Harvest in Iyo Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_burdock.tres
msgid "The image was cropped, the text was removed, and the background was recolored to fit into a desert scene."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_burdock.tres
msgid "Depicts farmers harvesting burdock roots in Iyo Province (modern-day Ehime prefecture). The text in the top right corner explains that although burdock is grown throughout Japan, it is a specialty of Iyo. It claims that the largest roots reach over 1.2 meters in length, and 9 to 12 centimeters in diameter, but remain tender and flavorful despite the size."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_enoshima_genji.tres
msgid "Enoshima Seen from the Beach"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_enoshima_genji.tres
msgid "Only the forest in the background was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_enoshima_genji.tres
msgid ""
"Depicts Mitsuuji (a reimagined, Edo-period version of [url=art_style:genji-e]Prince Genji[/url]) atop an ox being led by a young woman along the Shichirigahama beach in Enoshima (present-day Kanagawa Prefecture). This is an artistic liberty, as the story is technically set around Kyōto, far from Enoshima.\n"
"\n"
"At the time, Enoshima was connected to the mainland at low tide, and it was customary to visit the island on oxen. In reality, children like those seen on the right led the oxen, but in this picture, a fashionable young woman is depicted instead.\n"
"\n"
"Mitsuuji's distinctive ebi-chasen-mage (\"shrimp tea whisk topknot\") hairstyle was popular in Edo-period Genji-related art.\n"
"\n"
"Several museums incorrectly attribute this print to the original Hiroshige."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_kites.tres
msgid "Fukuroi Kites and Distant View of Akiba"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_kites.tres
msgid "Text overlays were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_kites.tres
msgid "Kites and distant view of Mount Akiba as seen from Fukuroi, Enshū (Tōtōmi) Province."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_kokura_coast.tres
msgid "View of the Coast, Kokura District, Buzen"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_kokura_coast.tres
msgid "The large structure in the foreground is the memorial to Miyamoto Musashi."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_mount_hirakido.tres
msgid "Mount Hirakido in Iga Province "
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_mount_hirakido.tres
msgid "The road and the traveler were replaced by a glowing red and black path."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_mt_asama.tres
msgid "A View of a Smoking Mount Asama"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_2_mt_asama.tres
msgid "Only the smoking tip of the volcano is used, with the background removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_mt_asama.tres
msgid "An imagined view of a smoking Mount Asama, in Shinano Province, during its eruption in 1783."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_2_rock_tripe.tres
msgid "Gathering Rock Tripe at Kumano in Kii Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_2_rock_tripe.tres
msgid ""
"Depicts workers scraping rock tripe off a cliff face, while suspended in baskets above a gorge.\n"
"\n"
"Although rock tripe is called iwatake (\"rock mushroom\") in Japanese, it is actually an edible lichen (Umbilicaria esculenta) that grows on sheer, exposed mountain cliffs. Although considered at best a starvation food in most of the world, Japanese cuisine appreciates its elastic texture and earthy flavor. It requires extensive processing by repeated boiling to reduce bitterness, and is sometimes prepared with sugar and soy sauce or baked into cakes."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_bear_hunting.tres
msgid "Bear Hunting for Gall, Kashū Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_bear_hunting.tres
msgid "The text was removed and replaced with more background elements."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_bear_hunting.tres
msgid "The text describes the habitat of the bears in the deep, snowy mountains of Kashū (modern-day Ishikawa prefecture). It details how hunters track the bears to their winter dens and explains that while the meat and fur are valuable, the gallbladder (used for medicine) is the most prized product."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_butterbur.tres
msgid "Giant Butterbur in Akita"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_butterbur.tres
#: art/pieces/piece_hiroshige_3_silkworms_5.tres
msgid "The text was edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_butterbur.tres
msgid "The text explains that the butterbur in Akita grew to an extraordinary height of one jō (about 3 meters), and the leaves were the size of an umbrella. It claims that the hole in the stalks could fit three herrings. Both the stalk and flower were edible, but the taste was inferior to the smaller varieties."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_coal_mine.tres
msgid "Coal Mining in Iga Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_coal_mine.tres
msgid "The text and people were edited out and the image was cropped. Several versions are used, some with additional layers on top."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_coal_mine.tres
msgid "Depicts coal miners entering a mine with pickaxes and exiting carrying yoked baskets of coal. Iga was a province in the area that is today Mie prefecture. The mountains which bordered Iga were noted for their coal reserves."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_crafting_bogwood_carvings.tres
msgid "Production of Bogwood Carvings in Matsushima"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_crafting_bogwood_carvings.tres
msgid "This piece illustrates the production of umoregi-zaiku, carvings of dishes, boxes, and art made out of fossilized \"bogwood\" found near the Natori River. The embedded description scroll mentions that the area is famous for its hundreds of pine-clad islands."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_daffodils.tres
msgid "Daffodil Flowers in Awa Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_daffodils.tres
msgid "The text overlay was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_daffodils.tres
msgid ""
"Depicts a daffodil farm in Awa (modern-day Bōsō peninsula in the Chiba prefecture). Because the area is protected by the Kazusa mountains, it has an unusually warm climate, allowing for daffodils to bloom at the end of autumn and all through December.\n"
"\n"
"The text describes the daffodils as having four leaves forming a single cluster from which a stalk rises, and opening into a six-petaled flower with a pure fragrance. It mentions that these flowers are sent to the capital for flower arranging (ikebana).\n"
"\n"
"Even today, southern Chiba supplies winter flowers and holds annual daffodils festivals."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_gold_mine.tres
msgid "Gold Mine in Sado Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_gold_mine.tres
#: art/pieces/piece_hiroshige_3_gold_mining_sado_province.tres
msgid "Several edited versions are used in the game, including ones with just the text removed, and cropped ones with some people removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_gold_mine.tres
msgid ""
"Depicts miners at the entrance of a gold mine in Sado province (modern-day Niigata prefecture). The mines in this area, founded around 1600, were the primary source of gold in Japan for centuries, only closing in 1989.\n"
"\n"
"The text on the top right praises the quality of the gold produced by this mine, and claims that about 500,000 [i]me[/i] (1.9 tons) of gold was produced annually. Other historical records suggest that the real annual production at this time was closer to 400kg.\n"
"\n"
"It also mentions that gold was first discovered in Japan in 749, during the reign of the 46th emperor (Empress Kōken), which appears to be inaccurate. More reliable sources state that it was during the reign of the 45th emperor (Emperor Shōmu)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_gold_mining_sado_province.tres
msgid "Gold Mining in Sado Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_gold_mining_sado_province.tres
msgid ""
"Depicts miners underground digging for gold in Sado province (modern-day Niigata prefecture).\n"
"\n"
"This text explains the nature of gold in Sado. It mentions that gold is found as either sand gold (alluvial) or within rock veins. It describes the arduous process of extracting the ore from deep within the mountains and the refinement required to produce pure gold. The red labels highlight specific tasks like drainage."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_honey.tres
msgid "Honey Making in Tanba Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_honey.tres
msgid "The image was cropped, some people were edited and moved, and a swarm of bees was added."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_honey.tres
msgid "The text mentions several varieties of honey bees: earth bees, wood bees, and mountain bees. It then describes the raising of domesticated bees in boxes and tubs pierced with holes. The bees collected nectar from the end of spring until the end of autumn, at which point two thirds of the honeycombs were taken and boiled to produce \"ripe honey\"."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_imari_porcelain.tres
msgid "Manufacturing Imari Porcelain, Hizen"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_imari_porcelain.tres
msgid "Each of the two panels was cropped and used in different contexts. Some people were moved from one panel to the other."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_imari_porcelain.tres
msgid "The print illustrates the step-by-step manufacturing process of Arita porcelain (Imari ware) in Hizen Province (modern-day Saga prefecture). Between the second half of the 17th century and the first half of the 18th century, these ceramics were one of Japan's most vital exports to the West."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_kudzu.tres
msgid "Digging Kudzu Root, Yamato Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_kudzu.tres
msgid "The text explains that Kudzu is a vine plant that grows naturally in the mountains and fields. The roots are described as being as large as an arm, and white in color. These roots were dug up from winter until the time of spring budding, crushed on top of a stone board, washed in a barrel of water, and strained to remove the dregs. The result was dried and made into kudzu starch."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_nishikie.tres
msgid "Making Nishiki-e in Tōkyō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_nishikie.tres
msgid "The image was cropped and artifacts were cleaned up."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_nishikie.tres
msgid "The caption details the process of making nishiki-e (multi-colored woodblock prints). It mentions using cherry wood for the blocks, layering multiple colors, and sizing the paper to prepare for inking."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_nori.tres
msgid "Drying Nori in Musashi Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_nori.tres
msgid "The image was cropped and the boats were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_nori.tres
msgid ""
"Depicts the process of drying seaweed to make nori in Musashi province (around present-day Tōkyō).\n"
"\n"
"The text on the top right explains that nori is a major Japanese specialty product and explains the production process.\n"
"\n"
"During the winter season, tree branches are set up on the beach, and after the tide recedes, the seaweed that gets snagged on the branches is harvested. The result is cleaned and spread out on bamboo mats to dry in sheets, similar to how paper is made."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_planting_rushes.tres
msgid "Planting Rush in Bingo Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_planting_rushes.tres
msgid "The text overlays were edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_planting_rushes.tres
msgid "The caption details the process of planting igusa (rush). It mentions that these rushes, used to make tatami mats, are a specialty of the Bingo Province (modern-day Hiroshima), which allegedly has thinner grass that produces smoother mats. It details the categorization of the fibers by length and their preparation, and the practice of steaming them to make them shine."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_saltern.tres
msgid "Saltern in the Ako District, Harima Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_saltern.tres
msgid "The image was cropped and boars were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_saltern.tres
msgid "The text describes the salt-production process in Akō. It explains how seawater is drawn and spread over the sand on clear days. Once the water evaporates, the concentrated salty sand is gathered. Brine is extracted from this sand and boiled down in flat kettles to produce high-quality salt \"as white as snow\"."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_silkworms_5.tres
msgid "Sericulture in Rikuzen Province, Figure 5"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_silkworms_5.tres
msgid ""
"Depicts women preparing mulberry leaves for silkworms in Rikuzen province (present-day Miyagi prefecture).\n"
"\n"
"The text explains that silkworms go through 4 molting stages:\"lion\", \"hawk\", \"boat\", and \"garden\". It describes the preparation of mulberry leaves, being cut into coarser and coarser pieces to match the size of the worms, and winnowed to remove dust.\n"
"\n"
"The text then compares \"dense raising\" (depicted) to \"sparse raising\". In the former, the insects and their cocoons are smaller, but by feeding them mulberry leaves with a high moisture content, the yield of silk thread is increased.\n"
"\n"
"When this print was issued in 1877 silk was Japan's leading export, and by 1909 Japan surpassed China as the world's top silk producer."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_tatami.tres
msgid "Manufacturing Tatami in Bingo Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_tatami.tres
msgid "The image was cropped and the horse was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_tatami.tres
msgid ""
"Depicts a workshop for making tatami mats in Bingo province (present-day eastern Hiroshima prefecture).\n"
"\n"
"The text in the top right explains the production process. Rushes are planted in autumn and harvested in June. They are dyed in a hole in the ground by rubbing with a mxture of white clay and water. They are then dried in the sun, sorted, and rubbed again with clay after an outer layer is removed. Using hemp thread as the warp, the rushes are woven using a loom, rolled up tightly, and shipped out."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_tie_dying.tres
msgid "Tie-dyeing, Arimatsu, Owari Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_tie_dying.tres
msgid "The image was cropped and the fluttering cloth from the cropped out portion was reinserted."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_tie_dying.tres
msgid "This text explains the history of the Arimatsu tie-dyeing. It mentions that Arimatsu and Narumi (located in modern-day Nagoya) are the centers of this industry. It describes the intricate process of tying the cloth to create patterns like \"spider\" (kumo) and \"fawn spot\" (kanoko), and mentions the use of high-quality indigo dye."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_toothpicks.tres
msgid "Selling Toothpicks, Itsukushima, Aki Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_toothpicks.tres
msgid "The image was cropped and the frame was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_toothpicks.tres
msgid ""
"Depicts the veranda of the Great Sutra Hall of the famous Itsukushima shrine in Aki Province (present-day western Hiroshima), with visitors and animals roaming around.\n"
"\n"
"The text explains that this hall is exceedingly large (36 by 26 meters in modern measurements), and that the veranda has railings on all four sides. It also mentions that toothpicks made from willow wood were sold inside, a local specialty product, and that these were dyed in five beautiful colors. Furthermore, it claims that thousands of monkeys and deer roam around, and will happily eat mochi right out of people's hands."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_whetstone.tres
msgid "Quarrying Whetstone in Nagura, Mikawa Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_whetstone.tres
msgid ""
"Depicts quarriers extracting stone to use as whetstones in Mikawa province (present-day Aichi prefecture). These are not a specific mineral, but a sedimentary rock mostly composed of quartz. Nagura stones, named after the area, are a type of whetstone still used today.\n"
"\n"
"The text on the top right explains that people find veins of whetstone in the mountains, dig them out, and cut the stone into long, square blocks. They are then loaded, four at a time, onto horses and hauled down to the village.\n"
"\n"
"It describes the stone as blue-white and slightly black, with a spotted pattern and exceptionally smooth texture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_wicker_trunks.tres
msgid "Making Willow Trunks in Tajima Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_wicker_trunks.tres
msgid ""
"Depicts a group of people making yanagi-gōri (\"willow trunks\") in Tajima province (present-day northern Hyōgo prefecture).\n"
"\n"
"The text explains that these trunks are produced in large quantities in the city of Toyooka. The willow branches are split finely, bleached in the sun, and woven into trunks. They are also sometimes crafted into bento boxes and winnowing baskets. The text further claims that the trunks are durable and appropriate for travel over long distances."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_3_woven_items.tres
msgid "Woven Items from Hakata"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_3_woven_items.tres
msgid "The image was cropped and the face of the main subject was replaced by a masculine one."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_3_woven_items.tres
msgid "The text introduces Hakata-ori (Hakata weaving) as unparalleled throughout the country. It lists several types, including five-color, brown-gray, alternating stripes, and tokko (Buddhist vajra) patterns. The product is described as sturdy, long-lasting, and having lustrous colors, often sewn into obi (sashes) for both men and women."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_agematsu.tres
msgid "Agematsu"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_agematsu.tres
msgid "The text, the hut, and one of the people were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_agematsu.tres
msgid "Depicts travelers marveling at the Ono Waterfall near the Agematsu post station, in present-day Kiso district, Nagano prefecture. Agematsu originally flourished as a logging town under the protection of the Owari branch of the Tokugawa clan."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_akasaka.tres
msgid "Akasaka"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_akasaka.tres
msgid "Text overlays were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_akasaka.tres
msgid "The print illustrates the interior and exterior of a bustling inn at Akasaka, showing travelers being welcomed by staff."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_akasaka_inn.tres
msgid "Akasaka: Inn with Serving Maids"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_akasaka_inn.tres
msgid ""
"A look from behind a sago palm and stone lantern, above a neighboring thatched roof, into the goings-on at an unidentified teahouse in Akasaka, one station past Goyu (present-day Toyokawa City in Aichi).\n"
"\n"
"Waitresses are serving tea in the room to the left. A country geisha is applying makeup in the room to the right."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_asakusa.tres
msgid "Asakusa Ricefields and Tori no Machi Festival"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_asakusa.tres
msgid "The image was cropped and text overlays were edited out. In some usages, the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_asakusa.tres
msgid ""
"Depicts a back view of a cat looking through a window with a grid frame at revelers returning from the Tori no Machi festival.\n"
"\n"
"The style of the window suggests that the room is probably on the second floor of the Yoshiwara red light district. Since the ceramic bowl and towel appear to have been set out for morning washing, the guest must have spent the night here.\n"
"\n"
"The Tori no Machi/Ichi (Rooster Market) festival is still held several times each November to celebrate good fortune and business prosperity. It is famous for selling kumade, decorative bamboo rakes meant to \"rake in\" wealth and luck. One such rake is seen on the floor in this print."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_asakusa_market.tres
msgid "Asakusa Fair"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_asakusa_market.tres
msgid "The text overlays were edited out and the image was edited into layers."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_asakusa_market.tres
msgid "Depicts the busy end-of-the-year market at the Asakusa Sensō-ji temple."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_boar.tres
msgid "Boar with Waterfall and Bush Clover"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_boar.tres
msgid "Only the boar and the ground were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_boar.tres
msgid ""
"Depicts a wild boar in front of a waterfall. This was likely part of a set of twelve zodiacal signs. Other known prints from this group are: Ox, Dog, Hare, Tiger, Monkey, and Horse.\n"
"\n"
"The inscription is a poem:\n"
"\n"
"[i][Like] a maiden's\n"
"flower-dyed robe's\n"
"swinging sleeve\n"
"unstitch\n"
"the cherry blossoms.[/i]\n"
"\n"
"It is unclear how this related to the image."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_carp.tres
msgid "Carp Ascending a Waterfall"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_carp.tres
msgid "The text was removed, and the background on the left was extended and replaced."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_carp.tres
msgid ""
"This print illustrates the Chinese legend known in Japanese as Tōryūmon (\"Climbing the Dragon Gate\"). According to the myth, thousands of carp would swim up the Yellow River, but only the strongest could leap over a massive, treacherous waterfall at the Dragon Gate. Any carp that successfully cleared the falls was instantly transformed into a powerful, celestial dragon.\n"
"\n"
"Because of this legend, the carp became an enduring symbol of perseverance, martial spirit, courage, and ultimate success through hard work.\n"
"\n"
"In Edo-period Japan, this imagery was heavily tied to the Tango no Sekku festival (now celebrated as Children's Day on May 5th). Families with sons would fly koinobori (carp streamers) outside their homes to pray that their boys would grow up with the strength and resilience of the carp swimming up the waterfall."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_dreaming_courtesan.tres
msgid "Dreaming Courtesan"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_dreaming_courtesan.tres
msgid "This print on the front of an envelope depicts a sleeping maid in front of a screen. A dream bubble emerges from behind the screen, where the maid's mistress, a courtesan, is presumed to be sleeping. In the bubble is a man reading a letter."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_ebisu_festival.tres
msgid "The Ebisu Festival on the Tenth Day of the First Month at Imamiya"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_ebisu_festival.tres
msgid "Text overlays were removed and some facial expressions were altered."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_ebisu_festival.tres
msgid ""
"Depicts people gathering for the Tenth Day Ebisu Festival near the Imamiya Ebisu shrine in Ōsaka, a popular celebration around January 10th to honor Ebisu, the god of commerce and prosperity.\n"
"\n"
"Historically, town markets would be held on the 1st, 10th, and 20th of each month, and since no market was held on January 1st due to New Year celebrations, the market on January 10th was considered particularly important.\n"
"\n"
"This festival is still held today, especially in the Kansai region (around Kyōto and Ōsaka), and remains popular with people involved in commerce."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_eijiri_koyoshida_bridge.tres
msgid "Ejiri: Koyoshida Bridge"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_enoshima.tres
#: art/pieces/piece_hiroshige_enoshima_cave.tres
msgid "The Cave at Enoshima in Sagami Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_enoshima.tres
msgid "Only the cave opening was used, rotated to depict a sinkhole."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_enoshima.tres
msgid ""
"Depicts the entrance to one of the two Enoshima Iwaya Caves, located at the southern tip of Enoshima Island in present-day Kanagawa prefecture. These are naturally formed sea caves shaped by centuries of wave erosion.\n"
"\n"
"A famous legend associated with the caves tells of a five-headed dragon who repented from evil after encountering a heavenly maiden. The dragon became the island's protector, symbolizing inner transformation.\n"
"\n"
"The caves are also known as the site of a prayer from Minamoto no Yoritomo, the founder of the Kamakura shogunate.\n"
"\n"
"As of 2026, the caves are open to visitors.\n"
"\n"
"This print is an [url=https://en.wikipedia.org/wiki/Uchiwa-e]uchiwa-e[/url] (\"fan print\"). These were intended to be cut out and pasted on paddle-shaped hand fans known as uchiwa. Such prints are rarely well-preserved, as the fans were articles of daily use, causing considerable wear and tear to the artwork."
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_enoshima_cave.tres
msgid "In some uses, the image was cropped and the sea was edited out."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_fox_fire_at_oji.tres
msgid "Fox Fires on New Year's Night under the Enoki Tree near Ōji"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_fox_fire_at_oji.tres
msgid "It was believed that on New Year's Eve all the foxes of the surrounding provinces would gather at a particular tree near Ōji Inari Shrine, the headquarters of the regional cult of the god Inari. There the foxes would put on clothes for a visit to the shrine, where they would be given orders for the coming year. On the way, the animals would emit distinctive flames by which local farmers were able to predict the crops of the coming year."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_fujikawa.tres
msgid "The Boundary Marker near Fujikawa"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_fujikawa.tres
msgid "Some people were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_fujikawa.tres
msgid "Depicts the head of a daimyō's (feudal lord's) procession at the entrance to a village, and three peasants bowing as it passes. The most frequent users of such highways were the feudal lords with their retinues. Commoners who came across a procession had to kneel down on the ground to pay their respects and stay there until the procession had passed."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_fujimi_teahouse.tres
msgid "Fuji-view Teahouse at Zōshigaya"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_fujimi_teahouse.tres
#: art/pieces/piece_hiroshige_kii.tres
#: art/pieces/piece_hiroshige_mikawashima.tres
#: art/pieces/piece_hiroshige_nagato.tres
#: art/pieces/piece_kuniyoshi_fukurokuju.tres
msgid "The text overlays were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_fujimi_teahouse.tres
msgid ""
"This print shows two young ladies stopping to admire the distant view of Mount Fuji from an outdoor tea stall at Zōshigaya, an outlying district of Edo.\n"
"\n"
"Tea stalls like this were strategically located throughout the Japanese countryside and within cities so they could do business along major thoroughfares and at popular tourist destinations."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_fuji_marsh.tres
msgid "Fuji Marsh in Suruga Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_fuji_marsh.tres
msgid "The image was cropped and the huts in the background were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_fuji_marsh.tres
msgid ""
"Depicts two tiny fishing boats in a marsh in Suruga province (present-day central Shizuoka Prefecture).\n"
"\n"
"This low-lying region is set against the backdrop of a huge Mount Fuji, towering over the smaller mountains in the middle ground. Fuji's height is further emphasized by extending beyond the edges of the frame."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_genji_in_suma.tres
msgid "The Elegant Prince Genji at Suma"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_genji_in_suma.tres
msgid "Only the left frame was used, and the ships were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_genji_in_suma.tres
msgid ""
"This depicts a scene from chapter 12 of the Tale of Genji, a classic work written in the Heian period (11th century) by the noblewoman Murasaki Shikibu, and often considered the world's first novel.\n"
"\n"
"In this chapter, Hikaru Genji goes on a year-long voluntary exile to the rustic Suma coast following one too many scandalous affairs.\n"
"\n"
"The landscape portion of the triptych was designed by Hiroshige, while the figure is the work of [url=artist:Utagawa Kunisada]Utagawa Kunisada (Toyokuni III)[/url]."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hakone.tres
msgid "Hakone: The Sea at Izu"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hakone.tres
msgid "Depicts travelers passing through a mountainous region near the Hakone station in the early parts of the Tōkaidō Road."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hakone_torches.tres
msgid "Hakone: Holding Pine Torches at Night"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_hakone_torches.tres
msgid "The text and the palanquin were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hakone_torches.tres
msgid ""
"Depicts a group of porters carrying their client in a palanquin, accompanied by torchbearers to light the cedar-lined mountain path.\n"
"\n"
"The scene is in Hakone, a mountainous area best known today for its hot springs."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hara.tres
msgid "Hara: Mount Fuji in the Morning"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hara.tres
msgid ""
"Depicts two female travelers and a porter carrying their boxes, passing by rice fields in the early morning. Two red-crowned cranes are pecking at the rice stalks behind them.\n"
"\n"
"The background is dominated by the huge snowy mass of Mount Fuji, its loftiness highlighted by extending beyond the frame of the print.\n"
"\n"
"Hara was a smaller post town on the coast of Suruga Bay between Numazu and Yoshiwara. The area is in present-day Numazu, Shizuoka prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hara_reisho.tres
#: art/pieces/piece_hiroshige_yoemon.tres
msgid "Hara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_hara_reisho.tres
msgid "The huts, trees, and text were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hara_reisho.tres
msgid ""
"Depicts Mount Fuji towering above Hara (literally \"field\"). The peak is cut off by the frame to emphasize the mountain's altitude.\n"
"\n"
"Hara was a smaller post town on the coast of Suruga Bay between Numazu and Yoshiwara. The area is in present-day Numazu, Shizuoka prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hida.tres
msgid "The Basket Ferry in Hida Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hida.tres
msgid ""
"Depicts a basket ferry in Hida Province (present-day northern Gifu prefecture). Depicts men using ropes to pull travelers in baskets between two platforms to cross a deep river gorge.\n"
"\n"
"The earliest mentions of aerial ropeways in Japanese history are found in the Taiheiki (Chronicle of The Great Peace), written in the late 14th century."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_higo.tres
msgid "Goka no Shō in Higo Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_higo.tres
msgid ""
"Depicts a small figure carrying bundles of firewood crossing a bridge formed by a tree growing over a gorge. In the background is a mountain peak shrouded in clouds.\n"
"\n"
"The village of Goka no Shō is in present-day Kumamoto prefecture. According to legend, the area provided safe haven to surviving members of the Taira clan following their defeat by the Minamoto clan in the 12th century."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hiratsuka.tres
msgid "Hiratsuka"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_hiratsuka.tres
msgid "The huts and text were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_hiratsuka.tres
msgid "Depicts travelers on a zig-zag road above marshy fields, approaching the post station town of Hiratsuka (in present-day Kanagawa prefecture). At the time the town had only a few thousand inhabitants. Today it has over 250 thousand."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_hodagaya.tres
msgid "Hodogaya"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_hodagaya.tres
msgid "Only the background and benches were kept. A tree layer was added."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_houraiji.tres
msgid "Pilgrims Climbing Up at Hōrai-ji Temple in Mikawa Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_houraiji.tres
msgid "In some uses, the background, the people, and the little statues were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_houraiji.tres
msgid ""
"Depicts people climbing up to the Hōrai-ji temple, in present-day Aichi prefecture.\n"
"\n"
"This Shingon Buddhist temple was allegedly founded in 702 AD by an ascetic and sculptor Ryūshū Sennin. It is located on the 695 meters high Mount Hōrai and is accessed by a flight of 1425 steps.\n"
"\n"
"The temple has been rebuilt multiple times over the centuries, and still stands today. The grounds have been designated a Place of Scenic Beauty and Natural Monument in 1931."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_izu_seashore.tres
msgid "The Seashore in Izu Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_izu_seashore.tres
msgid "The text and some of the trees were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_izu_seashore.tres
msgid ""
"Depicts a natural rock arch on the seashore of Izu province (present-day Shizuoka prefecture). Several such arches still exist in the area, though I was unable to verify which one in particular is depicted here.\n"
"\n"
"The faint shape of Mount Fuji can be seen through the arch."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_1.tres
msgid "Bush Warbler Sweets Vendor and Others"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_joruri_town_1.tres
#: art/pieces/piece_hiroshige_joruri_town_2.tres
#: art/pieces/piece_hiroshige_joruri_town_3.tres
#: art/pieces/piece_hiroshige_joruri_town_4.tres
#: art/pieces/piece_hiroshige_joruri_town_5.tres
#: art/pieces/piece_hiroshige_joruri_town_6.tres
#: art/pieces/piece_hiroshige_joruri_town_7.tres
#: art/pieces/piece_hiroshige_joruri_town_8.tres
msgid "The people and stalls were cut out to be used in a composition."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_1.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The Bush Warbler Sweet being mentioned (uguisu mochi) is a sweet and soft rice cake dusted with green roasted soybean flour (kinako). The shape and color are meant to resemble the Japanese bush warbler (uguisu), a bird associated with the arrival of spring. The shop selling these is in the top right of the image."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_2.tres
msgid "Hairdresser and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_2.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The hairdresser (髪結, kamiyui, \"hair-tier\") shop is in the top right of the image. Hairstyles during the Edo period were highly elaborate and strictly dictated by class, age, and profession, such as the topknot (chonmage) for samurai. Because citizens had to get their hair done frequently, such shops had bustling business during this period."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_3.tres
msgid "Woven Mats Vendor and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_3.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"Goza (ござ) refers to woven rush mats. While tatami mats were thick and permanent fixtures in homes, goza were often used as the top layer of tatami or as portable, rollable seating for picnics, travelers, and vendors. The mat shop is in the top right of the image."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_4.tres
msgid "Game Fowl Hot Pot Restaurant and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_4.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"Shamo (軍鶏) is a strange-looking breed of Japanese game fowl originally brought from Thailand for cockfighting. It was apparently eaten, cooked in a hotpot dish, during the Edo period."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_5.tres
msgid "Distilled Liquor Vendor and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_5.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The stall in the top right of the image is selling Shōchū (焼酎), a traditional distilled liquor. It is a stronger, cheaper alternative to sake (rice wine)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_6.tres
msgid "Tool Vendor and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_6.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The shop in the top right of the image is a dōguya (道具屋, \"tool shop\"), which sold various household implements, utensils, and tools. However, they often also functioned as general dealers of second-hand items."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_7.tres
msgid "Fruit Vendor and Others"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_7.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The vendor in the top right of the image sells fruit. Although today fruit is usually called kudamono (\"fruit thing\"), in the Edo period it was called mizugashi (水菓子, \"water sweets\"), to distinguish naturally sweet, watery fruits from manufactured confectioneries."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_joruri_town_8.tres
msgid "Comical Merchants in Jōruri Town"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_joruri_town_8.tres
msgid ""
"Like the rest of the series, this print depicts famous theatrical characters comically reimagined at a market.\n"
"\n"
"The 五大力 (\"five great powers\") inscription on the top left stall may refer to an 18th-century bunraku and kabuki play about a jealousy-inspired murder of five people in Ōsaka."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kakegawa_akibayama_fork.tres
msgid "Kakegawa: Akibayama Fork"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_kakegawa_akibayama_fork.tres
msgid "The text overlays were removed. In some uses, some people were edited out and the image was flipped horizontally."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kanaya.tres
msgid "Kanaya: Kanaya Slope and the Ōi River"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_kanaya.tres
msgid "The text and the huts were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kanaya.tres
msgid ""
"Depicts a hillside near Kanaya (in present-day Shizuoka prefecture), looking southeast across the Ōi river. Carrying people across this wide river was major business in Kanaya at the time.\n"
"\n"
"The choice of angle for this view is unusual, as it leaves Mount Fuji just out of frame on the left."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kii.tres
msgid "Waka Bay in Kii Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kii.tres
msgid "Depicts the tidal flats of Waka Bay (present-day Wakayama prefecture) from a crane's eye view."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kirifuri.tres
msgid "The Kirifuri Waterfall in the Kurokami Mountains in Shimotsuke Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kirifuri.tres
msgid ""
"Depicts two members of a hiking party crossing a stream below the Kirifuri (\"falling mist\") Waterfall, while others are taking in the view from the opposite side.\n"
"\n"
"The Kirifuri Waterfall, still existing today, is located north of Nikkō City in present-day Tochigi prefecture, on the southeastern foothills of Mount Akanagi. The waterfall is over 75 meters high, and descends in three steps, first dropping vertically, then gliding almost horizontally, before again plunging and breaking into numerous writhing streams as it rushes over craggy rocks."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kiso_mountain_snow.tres
msgid "Kiso Mountains in Snow"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_kiso_mountain_snow.tres
msgid "The triptych was merged and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kiso_mountain_snow.tres
msgid ""
"Depicts a snow-covered mountain, flanked by bridges on both sides, near the Kiso river (which flows through present-day Nagano, Gifu, Aichi, and Mie prefectures).\n"
"\n"
"Hiroshige completed this design one year before his death as part of a set of three triptychs on the theme known as setsugetsuka (\"snow-moon-flowers\"). Snow is the theme here, while the moon and flowers are the theme of the other two triptychs. These late Hiroshige works often avoided focusing on human figures and instead focused purely on vast landscapes."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kiyomizu_hall.tres
msgid "The Kiyomizu Hall and Shinobazu Pond at Ueno"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kiyomizu_hall.tres
msgid ""
"Depicts the Kiyomizu Kannon Hall, a temple hall dedicated to the Buddhist deity of mercy Kannon. It was built in Ueno Park in 1631 as part of an ambitious plan to establish a great Buddhist temple complex in Edo. Allegedly the goal was to provide spiritual defense from the northeast, the direction from which evil spirits were thought to come.\n"
"\n"
"The hall is famous even today for its view and surrounding cherry blossoms, although the print is exaggerated. Just outside the hall's outer platform is the Moon Pine, named for the circle made by one of its branches. The original pine was destroyed by a typhoon in the 1860s, but was recreated in the 2010s using deliberate horticultural techniques."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kogane.tres
msgid "Kogane Plain in Shimōsa Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kogane.tres
msgid "This depicts a shogunate-managed horse pasture in Kogane Plain, in today's Chiba prefecture. For the people of Edo, the Kogane plain was strongly associated with horses."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_kuroto_bay.tres
msgid "Kuroto Bay in Kazusa Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_kuroto_bay.tres
msgid "The image was cropped, and the large ships as well as Mount Fuji itself were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_kuroto_bay.tres
msgid "This print depicts boats in the Kazusa Bay, present-day Chiba prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_mariko_teahouse.tres
msgid "The Famous Teahouse at Mariko"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_mariko_teahouse.tres
msgid ""
"Mariko, a tea house and rest stop on the Tōkaidō, the Eastern Sea Road connecting Kyōto and Edo (present-day Tōkyō).\n"
"\n"
"The white vertical sign in front of the teahouse advertises the house's meibutsu, or specialty: tororo-jiru, a soup made from grated mountain potatoes. Mariko's specialty was immortalized in a haiku by Matsuo Bashō, Japan's greatest poet, and was well known throughout the Edo period."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_mikawashima.tres
msgid "Minowa, Kanasugi, Mikawashima"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_mikawashima.tres
msgid ""
"Depicts two red-crowned cranes, one about to land, in a marsh.\n"
"\n"
"The title of the print lists three villages northwest of the Yoshiwara pleasure quarters. The viewer is looking from Minowa and Kanasugi toward Mikawashima, to the west or northwest.\n"
"\n"
"Mikawashima was where the shōgun's Crane Hunt occurred almost every year during the winter months, when cranes migrated to Japan. Aside from the one or two birds taken on each hunt, the cranes of Mikawashima were carefully protected. The figure in the background is carrying buckets filled with rice to feed them.\n"
"\n"
"The crane's feathers feature karazuri (\"empty printing\"), or \"gauffrage\", a technique of embossing paper by pressing a block into the paper without ink."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_minakuchi.tres
msgid "Minakuchi: Pine Trees at Mount Hiramatsu"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_minakuchi.tres
msgid "The ox, its owner, and the text were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_minakuchi.tres
msgid "Depicts travelers on a mountain pass near the Minakuchi post station (present-day Kōka, Shiga prefecture)known for its Minakuchi Castle, which still stands today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_motoyama.tres
msgid "Motoyama"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_motoyama.tres
msgid "The children were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_motoyama.tres
msgid "Depicts two loggers relaxing on a felled tree. Another trunk leans across the path supported by a trestle. Motoyama (in present-day Shiojiri, Nagano prefecture) was a post station on the Kisokaidō. This area supplied timber for Edo."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_musashi_chofu.tres
msgid "The Chōfu Jewel River in Musashi Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_musashi_chofu.tres
msgid "The image was cropped, the text was removed, and some of the land was replaced with more water."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_musashi_chofu.tres
msgid ""
"Depicts women washing clothes in the Chōfu river in Musashi province (present-day Tōkyō and Saitama area).\n"
"\n"
"Chōfu is one of the Six Crystal Rivers (\"mu tamagawa\"), which are a theme covered by several ukiyo-e artists.\n"
"\n"
"The inset in the top left depicts flowering bush clover over another of the jewel rivers, the Noji Jewel River in Ōmi Province."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_nagato.tres
msgid "Nagato Province: Shimonoseki"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_nagato.tres
msgid ""
"Depicts a ship in harbor at Shimonoseki in Nagato Province (present-day Yamaguchi prefecture) on the west tip of Japan's main island.\n"
"\n"
"The ship appears to be a benzaisen, a large coastal cargo vessel. Such ships were often called sengokubune (\"thousand-koku ship\"), referring to their ability to carry a thousand koku worth of cargo (about 150 tons).\n"
"\n"
"The koku is a unit of volume used to measure rice, equivalent to about 180 liters, or 150kg of rice. It was considered to be enough rice to feed one person for a year, and as such by the 1660s it became a standard unit for salaries and taxation. Feudal domains were often measured in terms of how many koku of rice they produced (\"kokudaka\"), and to be a daimyō (feudal lord) required one's domain to produce at least 10,000 koku of rice."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_nakanotake.tres
msgid "Distant View of Naka-no-take in Kōzuke Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_nakanotake.tres
msgid "The image was cropped and the buildings in the forest were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_nakanotake.tres
msgid ""
"Depicts travelers descending a steep mountain path in Kōzuke Province (present-day Gunma prefecture). In the background is the naka-no-take (\"middle peak\") of Mount Myōgi, known for its unusual rock formations and steep, jagged spires.\n"
"\n"
"This is not to be confused with Mount Nakano in Hokkaidō, which is also sometimes called naka-no-take."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_nissaka.tres
msgid "Nissaka: Sayo Pass, the Night-crying Stone, and Mount Mugen"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_nissaka.tres
msgid "The text was removed. In one use, the rock was edited to look buried."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_nissaka.tres
msgid ""
"The boulder in the center is the \"night-crying stone\", so named after the legend of a pregnant woman who was murdered by bandits and spilled her blood on the stone. In one interpretation of the legend it is said that her spirit was contained in the stone and she wept each night. In another version the stone cries every night for the murdered woman.\n"
"\n"
"The partially legible writing on the stone is a veneration, likely \"Namu Amida Butsu\", or \"I take refuge in Amida Buddha\". This sutra is most commonly associated with the Pure Land school of Buddhism."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_nissaka2.tres
msgid "Nissaka, Sayo Mountain Pass"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_nissaka2.tres
msgid ""
"Depicts a steep road in the Sayo Pass in Nissaka (present-day Kakegawa, Shizuoka prefecture), a station on the Tōkaidō. At the foot of the trail, people are examining a large boulder.\n"
"\n"
"This boulder was a well-known landmark called the \"night-crying stone\". It is named after the legend of a pregnant woman who was murdered by bandits and spilled her blood on the stone. In one interpretation of the legend it is said that her spirit was contained in the stone and she wept each night. In another version the stone cries every night for the murdered woman.\n"
"\n"
"The famous poet Bashō wrote a haiku about the Sayo pass:\n"
"\n"
"[i]Asleep on horseback\n"
"dreams linger, moon distant\n"
"smoke [from a fire] for tea[/i]\n"
"\n"
"The poem is an allusion to a verse by the Chinese Tang dynasty poet Du Mu called Early Departure:\n"
"\n"
"[i]I keep my whip hanging and trust the way my horse walks.\n"
"For several li, no rooster is heard.\n"
"We move through a grove, still half-dreaming,\n"
"when the leaves suddenly fall on me.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_noda_river.tres
msgid "The Noda Jewel River in Mutsu Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_noda_river.tres
msgid "The image was cropped and the text, the sword, and the sails on the horizon were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_noda_river.tres
msgid ""
"Depicts two women and their attendant pointing at a flock of little white birds, likely plovers, on the banks of the Noda river in Mutsu province. The area is in present-day Iwate prefecture.\n"
"\n"
"Noda is one of the Six Crystal Rivers (\"mu tamagawa\"), which are a theme covered by several ukiyo-e artists.\n"
"\n"
"The inscription in the top left appears to be a poem by Priest Nōin (988–1050):\n"
"\n"
"[i]As evening descends,\n"
"briny winds pass\n"
"Michinoku's\n"
"Noda Jewel River;\n"
"the plovers cry.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_noji_river.tres
msgid "The Noji Jewel River in Ōmi Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_noji_river.tres
msgid "Only a piece of the hill in the background was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_noji_river.tres
msgid ""
"Depicts nighttime travelers along the Noji river in Yamato province (present-day Nara prefecture). At the top is a poem by Minamoto no Toshiyori (1055–1129):\n"
"\n"
"[i]Tomorrow again,\n"
"the Jewel River of Noji,\n"
"where the bush clover grows,\n"
"and ripples reflect the moon.[/i]\n"
"\n"
"Noji is one of the Six Crystal Rivers (\"mu tamagawa\"), which are a theme covered by several ukiyo-e artists."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_odai.tres
msgid "Odai"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_odai.tres
msgid "The text and the baby were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_odai.tres
msgid ""
"Depicts three pilgrims and a monk walking among the pampas grass on a marshy plain near the Odai (sometimes spelled Otai) station on the Kisokaidō. This location is in the present-day town of Miyota, Nagano prefecture.\n"
"\n"
"One of the pilgrims on the left is holding a baby. The person on the right is a fundraising monk carrying a banner saying \"Construction of the Main Hall\". Such monks would travel the country collecting donations for their temples.\n"
"\n"
"In the background is Mount Hirao, a 1,156-meter-tall dormant volcano overlooking the Saku plains."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_odawara.tres
msgid "Odawara: Sakawa River"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_odawara.tres
msgid "The litters and some of the people were edited out. The text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_odawara.tres
msgid "Depicts the Sakawa River by the flourishing town of Odawara, whose castle is seen at the foot of the mountains of Hakone in the distance. Some travelers are carried across the river on a litter. This station flourished in its position at the entrance to Hakone pass, the most arduous part of the highway."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_okabe_mount_utsu.tres
msgid "Okabe: Mount Utsu"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_okabe_mount_utsu.tres
msgid "The text was removed, and the people were cut into a separate layer."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_okabe_mount_utsu.tres
msgid ""
"Depicts the Utsunoya Pass by the post station of Okabe (in present-day Shizuoka prefecture) on the Tōkaidō. Hiroshige published numerous prints depicting different views of the pass.\n"
"\n"
"The print features the Edo period (1603-1868) path, but an alternative path through the same pass was famous since the Heian period (794–1185) under the name [i]tsuta no hosomichi[/i] (\"narrow ivy road\"), appearing in poetry and classic literature, and in 2010 being declared a National Historic Site."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_otsu.tres
msgid "Ōtsu: Running Well Tea House"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_otsu.tres
msgid "Only the well was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_otsu.tres
msgid "Depicts ox carts passing by a teahouse in Ōtsu (present-day Shiga prefecture). The eponymous well is in the bottom left, so called because of the water that gushed from it. Located on the south-western shore of Lake Biwa, it is the last station on the Tōkaidō before it ends in Kyōto."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_otsue_obon_dance.tres
msgid "Otsu-e of Obon Dance"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_otsue_obon_dance.tres
msgid "Depicts people dressed as characters dancing Bon Odori, a dance performed during Obon, a summertime festival which honors ancestral spirits. The festival and dancing style still exist today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_otsukihara.tres
msgid "Ōtsuki Plain in Kai Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_otsukihara.tres
msgid "Depicts a lone traveler gazing at a snow-covered Mount Fuji, surrounded by a vast flat empty plain near Ōtsuki (in present-day Yamanashi prefecture). The area is considered a classic Mount Fuji viewing spot."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_pontoons.tres
msgid "Toyama Pontoon Bridge in Etchū Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_pontoons.tres
msgid ""
"This print depicts the famous funabashi (floating bridge) of Toyama in Etchū Province (modern-day Toyama prefecture), which was constructed using boats to cross the Jinzu River.\n"
"\n"
"The bridge was set up by the ruling Maeda clan around 1639 by chaining 64 riverboats together and laying wooden planks over them to form a roadway.\n"
"\n"
"The bridge was highly dynamic. During heavy rains or spring snowmelt from the Japanese Alps, the river's current would become too strong. To prevent the bridge from being destroyed, officials would temporarily dismantle it, unchaining the boats and securing them to the banks until the waters receded."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_reservoir.tres
msgid "The Reservoir and the Sannō Shrine"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_ronin_act8.tres
msgid "Act 8"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_ronin_act8.tres
msgid ""
"Depicts a scene from act 8 of the Tale of the 47 Ronin.\n"
"\n"
"In this part of the story, Wakasa's Wife Tonase journeys with her daughter Konami from Edo to Yamashima in search of Yuranosuke's son Rikiya, hoping to reaffirm the betrothal of the young couple amidst the tragic fallout of their clan's downfall.\n"
"\n"
"In the print, the two women are walking on a hilly path, in front of a huge pine tree, wreathed in an autumn-colored ivy. A woman is crouched to tie Konami's sandal. Behind them is their porter and another traveler, mounted on a horse.\n"
"\n"
"In the background, over a wooded hill, is Mount Fuji, white against a blue sky."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_sagami_oyama.tres
msgid "The Raigo Valley at Ōyama in Sagami Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_sagami_oyama.tres
msgid "The text and the person were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_sagami_oyama.tres
msgid ""
"Depicts the Raigo (\"descent\") valley in Ōyama (\"big mountain\") in Sagami province, today's Isehara city, Kanagawa prefecture.\n"
"\n"
"In the Edo period, Ōyama was a very popular pilgrimage site. Pilgrimages to it were called Ōyama-mairi.\n"
"\n"
"In the center, framed by the valley, is Mount Fuji. In the upper right is a torii gate, likely leading to either the Ōyama Temple or the Ōyama Afuri Shrine."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_sakanoshita.tres
msgid "Sakanoshita: View of Mount Fudesute"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_sakanoshita.tres
msgid ""
"Depicts travelers looking out at Mount Fudesute on the Tōkaidō near the Saka no Shita post station (present-day Kameyama, Mie prefecture).\n"
"\n"
"The name \"fudesute\" literally means \"to throw away the brush\". According to folklore, during the Muromachi period, when the famed painter Kanō Motonobu attempted to paint this mountain with its landscape of strongly-shaped rocks and groves of maple, pine, and azaleas, the shifting light caused by clouds and haze caused him to throw down his paintbrush in frustration.\n"
"\n"
"Today, there are only a few private residences left at the site of the former post station, and very little historical architecture. The only thing that marks the former site is a stone marker built by the former town of Seki, now part of the city of Kameyama."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_satta.tres
msgid "Mount Fuji from Satta"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_satta.tres
msgid "The sails and the text were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_satta.tres
msgid ""
"Depicts a view of Mount Fuji from the Satta Pass in present-day Shizuoka.\n"
"\n"
"Today an observation deck at this spot is open to tourists."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_secret_scroll.tres
msgid "Ushiwakamaru Stealthily Looks at the Secret Book of Kiichi Hōgen"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_secret_scroll.tres
msgid ""
"Depicts a scene from the fictionalized biography of Minamoto no Yoshitsune, a famous 12th-century samurai general. In this scene, the young Yoshitsune (still using his birth name, Ushiwakamaru) finds a military treatise by Kiichi Hōgen (literally \"first demon priest\"), a legendary warrior monk, and gains supernatural power from it.\n"
"\n"
"Yoshitsune's life was defined by a dramatic rise to military glory and a tragic end. After surviving the Heiji Rebellion, he was raised in a temple then left to launch a war campaign before being betrayed and forced to commit suicide by his brother, Minamoto no Yoritomo, the first shōgun of the Kamakura shogunate."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_shimabara.tres
msgid "The Willow at the Exit of Shimabara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_shimabara.tres
msgid "Only the people on the left were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_shimabara.tres
msgid ""
"Depicts the gate of Shimabara, the walled brothel district of Kyoto, at dawn. A drunken customer is being helped home. A courtesan with her attendants are seen on the right.\n"
"\n"
"Shimabara was the only officially licensed pleasure quarter in Kyōto during the Edo period, removed from the Rokujo Misujimachi in 1640 to a more isolated location on the Tamba Highway, surrounded by fields. The main gate on the east side was marked with a willow tree.\n"
"\n"
"This design appears to be based on an illustration by Takehara Shunchōsai in a geographical dictionary from 1780. For example, the group of figures surrounding a drunken customer appears just inside the gate in Shunchōsai's illustration."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_shirasuka.tres
msgid "Shirasuka: Tide-view Hill"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_shirasuka.tres
msgid "The text, huts, and boats were removed, and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_shirasuka.tres
msgid "Depicts a hill by the ocean near the Shirasuka post station (present-day Kosai, Shizuoka prefecture)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_shokintei_in_yushima.tres
msgid "Shokintei in Yushima"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_shokintei_in_yushima.tres
msgid "Some uses of this image crop out the right part and edit out one of the people."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_shokintei_in_yushima.tres
msgid "Shows women serving tea to men in a second-story tearoom. The men are drinking, reading, and writing. Some sources describe them as poets. The background is a view of Edo (present-day Tōkyō)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_sumidagawa.tres
msgid "Tile Kilns and Hashiba Ferry, Sumida River"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_sumidagawa.tres
msgid "The boats and the text were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_sumidagawa.tres
msgid ""
"Depicts two boats crossing the Sumida River at the Hashiba Ferry, one of the oldest ferries in Edo (present-day Tōkyō). The plume of smoke that dominates the design is from kilns producing Imado ware, famous for tiles and pottery toys.\n"
"\n"
"The small white gulls in the foreground are miyakodori (\"capital birds\") famous from the 10th-century epic Tales of Ise, in which a lonely Kyōto courtier learns the birds' name from a ferryman and composes a poem:\n"
"\n"
"[i]If you are what your name implies,\n"
"let me ask you, capital-bird,\n"
"Does all go well\n"
"With my beloved?[/i]\n"
"\n"
"In the background, the forest of Suijin Shrine and the silhouette of Mount Tsukuba stand out. In antiquity, this mountain served as a location for kagai, harvest festivals associated with fertility. A poem by Takahashi no Mushimaro in the classic anthology Manyōshū describes them thus:\n"
"\n"
"[i]On the Mountain of Tsukuba, where the eagles dwell\n"
"Near the Wells of Mohakitsu, seeking each other, in song of Kagai,\n"
"I will seek the wives of other men, and let other men woo my own.\n"
"The gods dwelling in these mountains have allowed this since olden times.\n"
"Do not make exceptions today, do not reproach the lovers, and blame them not.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tamachi_moon.tres
msgid "Autumn Moon over Tamachi"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_tamachi_moon.tres
msgid "The boats were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tamachi_moon.tres
msgid ""
"Depicts the [url=https://en.wikipedia.org/wiki/Mita_Hachiman_Shrine]Mita Hachiman Shrine[/url] at Tamachi in the Shiba district (within present-day Tōkyō) atop a wooded hill. Several visitors pause in the courtyard to view the full moon overhead.\n"
"\n"
"The shrine was allegedly founded in 1365, and a shrine rebuilt in 1957 still stands on the same site. A guardian dog statue on the grounds was dedicated in 1696.\n"
"\n"
"From the series Eight Views of Shiba in the Eastern Capital."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_theater.tres
msgid "The Kawarazaki Theater"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_theater.tres
msgid "Weapons were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_theater.tres
msgid "The Ichimura-za, the Nakamura-za and the Morita-za were the three main theaters of Edo which were given licenses by the government officials."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tsuchiyama.tres
msgid "Tsuchiyama: The Suzuka Mountains in the Rain"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tsuchiyama.tres
msgid "Depicts two porters in straw capes carrying loads on their back as they make their way through ankle-deep mud on a mountain path. It is raining, but the porters seem to be in good humor despite the rain and mud. One of them carries what looks like a wrapped banner. Behind them are the people whose belongings the men may be carrying."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tsuchiyama_reisho.tres
msgid "Tsuchiyama"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_tsuchiyama_reisho.tres
msgid "The text, the shrine, and the pipes were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tsuchiyama_reisho.tres
msgid "Depicts three figures smoking by a river near the Tsuchiyama station of the Tōkaidō (in present-day Shiga prefecture). In the background is a tiny shrine surrounded by wooded hills."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tsuchiyama_suzuka.tres
msgid "Tsuchiyama: Suzuka Mountains"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_tsuchiyama_suzuka.tres
msgid " The text and huts where removed, a cloak was recolored, and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tsuchiyama_suzuka.tres
msgid ""
"Depicts a rainy scene of the Suzuka Pass near Tsuchiyama (in present-day Shiga prefecture), an area which was known to be unusually rainy.\n"
"\n"
"Like the rest of the prints in this series, it has a kyōka (comic poem) inscribed:\n"
"\n"
"[i]Even if you are in a hurry,\n"
"go with caution.\n"
"If you slip,\n"
"you will slide back down\n"
"rainy Tsuchiyama.[/i]\n"
"\n"
"The attribution next to the poem states \"Teahouse Girl at the Brushwood Gate\", not a specific real poet, suggesting that this is generic advice given by someone at a tea house rest stop along the Tōkaidō."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tsumago.tres
msgid "Tsumago"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_tsumago.tres
msgid "The image was cropped and the text, along with several people, were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tsumago.tres
msgid ""
"Depicts travelers on a road cut into the side of a mountain near the Tsumago post station, in present-day Nagano prefecture.\n"
"\n"
"Today it is common for tourists to hike this section of the Kisokaidō (which later became the Nakasendō), as there's a well-maintained 8-kilometer hiking trail between Tsumago and the next station, Magome. I can personally attest that this area is even more spectacular in real life than in the prints."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_tsurumaki.tres
msgid "The Spring in Tsuruma Gorge"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_tsurumaki.tres
msgid ""
"Depicts a small spring nestled in a narrow gorge surrounded by lush hills in Kanazawa, an area of the Musashi province, present-day Kanagawa prefecture.\n"
"\n"
"Note that this is not the more famous modern city of Kanazawa, the capital of Ishikawa prefecture.\n"
"\n"
"The inscription at the top appears to be a Chinese poem that I was unable to reliably translate or attribute."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_ushijima.tres
msgid "Ushijima: The Musashiya Restaurant"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_ushijima.tres
msgid "The image was cropped. In some usages, the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_ushijima.tres
msgid ""
"In a private room of the restaurant, reserved for the wealthier commoners, a man and a woman dressed in light summer kimono are dining. A female servant approaches from the garden, carrying a tray of food, while a man seated on the porch enjoys the garden view.\n"
"\n"
"Here one can see commoners enjoying the sort of entertainment, good food, and pleasant atmosphere that had previously been restricted to the upper classes, but became more widely accessible during the Edo period."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_ushiwakamaru_waterfall.tres
msgid "Ushiwakamaru by a Waterfall"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_ushiwakamaru_waterfall.tres
msgid "Only the rocks and splashing water were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_ushiwakamaru_waterfall.tres
msgid ""
"Depicts a scene from chapter 2 of the fictionalized biography of Minamoto no Yoshitsune, a famous 12th-century samurai general. In this night scene, the 13 years old Yoshitsune (still using his birth name, Ushiwakamaru) is holding a bell between his teeth and preparing to purify himself in a cold waterfall. In the background a staircase leading to the Kifune shrine.\n"
"\n"
"Yoshitsune's life was defined by a dramatic rise to military glory and a tragic end. After surviving the Heiji Rebellion, he was raised in a temple then left to launch a war campaign before being betrayed and forced to commit suicide by his brother, Minamoto no Yoritomo, the first shōgun of the Kamakura shogunate."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_yase.tres
msgid "Yase Village"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_yase.tres
msgid "The image was cropped and only part of the field was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_yase.tres
msgid ""
"Depicts village women carrying kindling, tools and a ladder. The location is yase village in Kyōto, still standing at the foot of Mount Hiei today.\n"
"\n"
"The women are [url=https://www.japan-experience.com/all-about-japan/kyoto/temples-shrines/oharame-the-peddler-maidens-of-ohara-kyoto]\"ōharame\"[/url], female peddlers of kindling from the nearby village of Ōhara. They had elaborate hairstyles around which they wrapped towels, placing the kindling on top of it to make the trek to Kyōto. They blackened their teeth and wore tight-sleeved kimonos with white leggings underneath.\n"
"\n"
"Tourists today can visit the village's visitor center to dress up as ōharame, and there's an annual Ōharame Festival as well."
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_yoemon.tres
msgid "Only the main figure's upper body was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_yoemon.tres
msgid ""
"Depicts a moonlit scene of Harajuku Yoemon in a chequered robe attacking a person labeled as \"villain\" against the backgrop of pine trees. The location is the Hara station of the Tōkaidō, in present-day Shizuoka prefecture.\n"
"\n"
"One source claims that this was a private commission by the prominent Uematsu family, descendants of this Yoemon, who may have in reality been a bandit. The inscription at the top reads:\n"
"\n"
"[i]Yoemon was a farmer from Harajuku. By nature gentle and compassionate, he stood up to the powerful and aided the weak, coming to own numerous estates. Though his family prospered, he remained humble and unpretentious, showing kindness to the poor and diligently tending to his work. One night, while walking, he came upon a traveler being harassed by criminals and intervened. His acts of courage and righteousness are too numerous to count. His descendants continue to prosper to this day.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_yoshitada.tres
msgid "Poem by Sone no Yoshitada: Princess Usuyuki and the Ferryman"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_yoshitada.tres
msgid "Only the ferryman was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_yoshitada.tres
msgid ""
"Depicts princess Usuyuki in a traveling robe arriving at a ferry stop. The ferryman is looking at her and scratching his head. At the top is a poem by the 10th-century Heian poet Sone no Yoshitada:\n"
"\n"
"[i]Over the Yura Strait\n"
"cross boatmen\n"
"their oars lost,\n"
"adrift\n"
"on the path of love.[/i]\n"
"\n"
"The scene itself is based on the 17th-century Tale of Usuyuki, which recounts a brief love affair between a married woman (Usuyuki) and her lover (Sonobe no Emon), climaxing with Usuyuki's untimely death after Sonobe departs on a journey.\n"
"\n"
"The love letters featured in this story were so popular that they became a model for letter writing during the seventeenth century, and the story was adapted into several puppet and Kabuki plays.\n"
"\n"
"The inscription in the corner of the image by Ryūkatei Tanekazu, a popular Edo-period fiction writer, describes an alternative ending where Usuyuki follows Sonobe on his journey instead."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_yui.tres
msgid "Yui"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_yui.tres
msgid "The building was edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_yui.tres
msgid "Depicts people on the shore of Suruga Bay in Yui (present-day Shizuoka, Shizuoka prefecture). Today this area hosts the Tōkaidō Hiroshige Museum of Art."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hiroshige_zazanza.tres
msgid "Hamamatsu: Murmuring Pines"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hiroshige_zazanza.tres
msgid "The sails on the horizon and the text were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hiroshige_zazanza.tres
msgid ""
"Depicts the famed pines on the shore near Hamamatsu, for which the town was named (literally \"pine beach\").\n"
"\n"
"The word translated as \"murmuring\" in the title is \"zazanza\", an onomatopeia specifically for wind rustling through the tops of pine trees, most notably used in Edo-period folks songs. Japanese has an endless amount of such onomatopeia words for a variety of meanings, including many having to do with abstract concepts and feelings rather than real sounds."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokkei_frog.tres
msgid "Ono no Tōfū Watching a Frog"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokkei_frog.tres
msgid "The sword and text were edited out and the image was extended."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokkei_frog.tres
msgid ""
"Depicts Ono no Tōfū, a famous calligrapher from the Heian period (794–1185), one of the Sanseki (\"three [brush] traces\").\n"
"\n"
"The scene illustrates a story wherein Ono is feeling inadequate and considers resigning from the court. He stops to watch a determined frog attempt to jump to a willow branch. After countless futile efforts, the frog finally succeeds. Inspired by its perseverance, Ono no Tōfū decides to stay on.\n"
"\n"
"Some Hanafuda cards use variants of this scene in their willow set."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokkei_fudou_pass.tres
msgid "Fudō Pass in Kōzuke Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokkei_fudou_pass.tres
msgid "The image was cropped and the dog's leash was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokkei_fudou_pass.tres
msgid ""
"Depicts travelers climbing Fudō Pass in the Mikuni Mountains of Kōzuke Province (present-day Gunma prefecture).\n"
"\n"
"Clouds rise from gullies on either side of the path, and an orange sun appears in the distance. Two travelers at the right wash their hands in a waterfall, while an image of the Esoteric Buddhist deity Fudō Myō-ō at the upper right watches over the pass.\n"
"\n"
"From the series Famous Views of the Provinces."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokkei_snake_melons.tres
msgid "Snake and Melons"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokkei_snake_melons.tres
msgid "This surimono depicts a snake and a box containing two gourds and a folded paper."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokuju_bonded_rocks.tres
msgid "View of Futami Beach at Ise"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokuju_bonded_rocks.tres
msgid ""
"Depicts two rocks joined by a shimenawa (a heavy rope of rice straw, sacred in Shinto) on the beach near Futami Okitama Shrine in present-day Ise, Mie prefecture.\n"
"\n"
"Several such rock formations exist and are called Meoto Iwa (\"married couple rocks\"). According to Shinto, the rocks represent the union of the creator deities Izanagi and Izanami, and therefore celebrate the idea of union in marriage."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_bamboo.tres
msgid "Fuji from a Bamboo Grove"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_bamboo.tres
msgid ""
"Depicts a view of Mount Fuji from a bamboo grove. The steepness of the mountain is exaggerated, and the bamboo stems are curved into shapes not normally seen in nature.\n"
"\n"
"This is a later colored version of a monochromatic original."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_bunya_asayasu.tres
msgid "Poem by Bunya no Asayasu"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_bunya_asayasu.tres
msgid ""
"Depicts five court pages gathering lotus leaves while trying to keep their boat steady. Scattered across the leaves are white drops of dew, referencing the poem inscribed in the upper right:\n"
"\n"
"[i]The white dewdrops\n"
"in the wind-swept\n"
"autumn fields\n"
"[lb]like[rb] unstrung\n"
"jewels are scattered.[/i]\n"
"\n"
"The poem is the best-known work of the Heian court poet Bunya no Asayasu (active late 9th century - early 10th century)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_cloud_bridge.tres
msgid "Bridge in the Clouds at Mount Gyōdō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_cloud_bridge.tres
#: art/pieces/piece_hokusai_suspended_bridge.tres
msgid "Clouds were edited to make it look more like a floating shard. More shards were added to the horizon."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_cloud_bridge.tres
msgid ""
"A fantastic view of a wooden bridge on Mount Gyōdō, popular with mountaineering ascetics, located north of Ashikaga.\n"
"\n"
"The ascetics' training halls, built on a high rock formation, are connected to a small shrine perched on an isolated crag near a bridge crossing over the gorge, which is enveloped in thick clouds.\n"
"\n"
"This is likely reimagined from historical records, as the bridge did not exist during Hokusai's time."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_ejiri.tres
msgid "Ejiri in Suruga Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_ejiri.tres
msgid "The image was cropped and the text and the little shrine were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_ejiri.tres
msgid ""
"Depicts a group of figures buffeted by a sudden gust of wind on an open marsh road in Suruga province (present-day central Shizuoka Prefecture).\n"
"\n"
"A traveling hat is swept off a man's head, and a stream of papers (likely tissues) whirls away from a woman's backpack, as her face is covered by a wind-tossed cloth.\n"
"\n"
"Mount Fuji is composed of a simple unfinished contour line, letting the focus remain on the dramatic foreground.\n"
"\n"
"This design is an example of Hokusai's theme of natural forces overpowering humans, most famously expressed in the Great Wave Off Kanagawa.\n"
"\n"
"The scene is set in Ejiri, a station on the Tōkaidō, which was located on the west side of the port of Shimizu in Suruga Bay, near modern-day Shimizu City."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_fuji_taiseki.tres
msgid "Mount Fuji from Taiseki Temple"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_fuji_taiseki.tres
msgid ""
"Depicts Mount Fuji as seen by travelers walking along a mountain path near the [url=https://en.wikipedia.org/wiki/Taiseki-ji]Taiseki Temple[/url], in present-day Shizuoka prefecture. It is the head temple of the Nichiren Shoshu sect of Buddhism. It was established in 1290 and still stands today.\n"
"\n"
"A waterfall flows down the rocks on the left, and fog drifts through the valley below.\n"
"\n"
"The mountain is depicted in a more rough and dramatic way than usual, and the clouds are emphasized by embossing."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_great_wave.tres
msgid "The Great Wave Off Kanagawa"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_great_wave.tres
msgid ""
"The print depicts three boats moving through a storm-tossed sea, with a large, cresting wave forming a spiral in the center over the boats and Mount Fuji in the background. The people are shown as tiny figures compared to the might of the sea.\n"
"\n"
"The print is Hokusai's best-known work and likely the most famous artwork in Japanese history. Some sources claim it to be the most reproduced image in the history of all art."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_hakurakuten.tres
msgid "Hakurakuten"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_hakurakuten.tres
msgid "Only the mountains in the background were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_hakurakuten.tres
msgid ""
"This print is based on the 15th-century Noh play Hakurakuten, which is the Japanese reading for the name of the Chinese poet Bai Juyi (772–846), one of the most famous Tang dynasty poets.\n"
"\n"
"In the depicted scene of the play Bai Juyi meets a humble Japanese fisherman, and loses to him in a poetry contest. The fisherman is then revealed to be a sea god who summons a kamikaze (divine wind) to send Bai Juyi's ship back to China. The story is a nationalistic allegory about the superiority of Japanese culture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_inume_pass.tres
msgid "Inume Pass in Kai Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_inume_pass.tres
msgid "The horses and the text were edited out and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_inume_pass.tres
msgid "Depicts travelers and porters with two horses climbing the Inume (\"dog's eye\") Pass (present-day Yamanashi prefecture). Mount Fuji is visible in the distance, covered with heavy fog at the base."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_kirifuri.tres
msgid "Pilgrims at Kirifuri Waterfall on Mount Kurokami in Shimotsuke Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_kirifuri.tres
msgid "The image was cropped and text overlays were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_kirifuri.tres
msgid ""
"The Kirifuri (\"falling mist\") Waterfall, still existing today, is located north of Nikkō City in Tochigi prefecture, on the southeastern foothills of Mount Akanagi. The waterfall is over 75 meters high, and descends in three steps, first dropping vertically, then gliding almost horizontally, before again plunging and breaking into numerous writhing streams as it rushes over craggy rocks.\n"
"\n"
"The falls fill the air with mist and plunge into a pool of choppy waves and foam. The speed and turbulence of the water are conveyed by the lively patterns and lines of contrasting white and blue."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_koishikawa.tres
msgid "Morning After Snow at Koishikawa"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_koishikawa.tres
msgid ""
"A rare example of Hokusai's snow scenes, depicting a winter morning. People excitedly point at Mount Fuji, which is completely cloaked in snow.\n"
"\n"
"Koishikawa is located in present-day Bunkyō ward of Tōkyō. The district is known for its hills, which are suitable for viewing Fuji, and the local inns and teahouses used these views to attract customers."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_loyal_retainers_4.tres
msgid "Act IV"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_loyal_retainers_4.tres
msgid "Weapons and travelers were edited out, and the text overlay was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_loyal_retainers_4.tres
msgid "Kanpei, from the famous tale of the 47 Ronin, is at the house of Yoichibei, about to commit suicide, unrolling a list of conspirators."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_mishima.tres
msgid "Mishima Pass in Kai Province"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_mishima.tres
msgid ""
"Depicts travelers linking arms to measure the circumference of a gigantic tree, upper reaches cut off by the edge of the paper. A seated man is enjoying a puff of tobacco.\n"
"\n"
"In the background is Mount Fuji, surrounded by fluffy clouds. The mountain's left slope is echoed by two diagonal lines: a tree branch hanging down from the edge of the paper, and the hills on the right.\n"
"\n"
"The exact location of Mishima Pass is uncertain. It is speculated that it may be present-day Kagosaka Pass, between the Yamanashi and Shizuoka prefectures, or it could be fictitious."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_mountain_climbers.tres
msgid "Mountain Climbers"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_mountain_climbers.tres
msgid "Some uses of this image crop it and edit out the people from the cave."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_mountain_climbers.tres
msgid "Depicts people climbing the steep slopes of Mount Fuji. In the background is a small cave used as a resting place during the ascent."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_muneyuki.tres
msgid "Poem by Minamoto no Muneyuki Ason"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_muneyuki.tres
#: art/pieces/piece_yoshitoshi_guns.tres
msgid "Only the fire was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_muneyuki.tres
msgid ""
"Depicts five men warming themselves by a fire at night outside a snow-covered hut. A poem by the 10th-century Heian poet [url=https://en.wikipedia.org/wiki/Minamoto_no_Muneyuki]Minamoto no Muneyuki[/url] appears in the top right:\n"
"\n"
"[i]In the mountain village,\n"
"winter is when my loneliness\n"
"increases the most,\n"
"when I think how both have dried up,\n"
"the grasses and people's visits.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_sanjo.tres
msgid "Emperor Sanjō"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_sanjo.tres
msgid ""
"Depicts a high-ranking priest blessing a vessel which is being held aloft by a bowing figure in front of a full moon. The scene is based on a poem by Emperor Sanjō:\n"
"\n"
"Though it is not what is\n"
"in my heart,\n"
"if in this world of pain\n"
"I should linger,\n"
"no doubt I shall remember\n"
"fondly the bright midnight moon!\n"
"\n"
"Emperor Sanjō only reigned for 5 years until his regent, Fujiwara no Michinaga, forced him to abdicate. By the end of his reign he had grown mostly blind, and died at age 42."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_sara_yashiki.tres
msgid "The Plate Mansion"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_sara_yashiki.tres
msgid "Depicts a legend from the 17th century, in which a maid named Okiku breaks a valuable plate from a set of ten, and through several alternative versions of events ends up at the bottom of a well and turns into a ghost. The neighbors hear her voice from that well every night, repeating \"One, two, three... eight, nine. I can't find the last one...\"."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_sazai_hall.tres
msgid "Sazai Hall of the Temple of the Five Hundred Arahants"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_sazai_hall.tres
msgid "The Sazaidō (literally, Turban-shell Tower, owing to its spiral staircase) is a three-story tower that was built in 1741 as a temple dedicated to the five hundred Rakan, or arahants, Buddhists who have achieved enlightenment. Men and women admire the view of Mount Fuji across the marshes from the temple's balcony. Mount Fuji serves here almost as a vanishing point, with the figures spread fan-like below."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_shimo_meguro.tres
msgid "Lower Meguro"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_shimo_meguro.tres
msgid "Depicts a village surrounded by a landscape of hilly fields, with Mount Fuji on the horizon. This location is present-day Meguro City, Tōkyō."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_south_wind_clear_sky.tres
msgid "Fine Wind, Clear Morning"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_south_wind_clear_sky.tres
msgid "Also known as \"Red Fuji\", this is one of the most recognized examples of ukiyo-e. It illustrates the moment in autumn where the rising sun turns Mount Fuji red."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_sparrow_cicadas.tres
msgid "Sparrow, Cicada, and Clematis"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_suruga_street.tres
msgid "Mitsui Store on Suruga Street in Edo"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_suruga_street.tres
msgid "The image was cropped, the text was edited out, and the roof was angled."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_suruga_street.tres
msgid "Shows tilers repairing a roof while kites float in the sky. Mount Fuji is rising above samurai residences and the stone ramparts of the outer moat of Edo Castle."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_suspended_bridge.tres
msgid "Suspension Bridge between Hida and Etchū"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_suspended_bridge.tres
msgid "A peasant couple, each carrying a heavy load, walk across a fragile bridge of bamboo and cord, suspended across a chasm full of pines and mist. The horizon is lowered to bring an intense focus on the figures in their hazardous task.\n"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_tenji.tres
msgid "Emperor Tenji"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_tenji.tres
msgid ""
"The poem in the yellow box on the top right is by Emperor Tenji (628 - 681). In the poem the Emperor takes shelter during an autumn rain in the field hut of a common rice farmer.\n"
"\n"
"Coarse the rush-mat roof\n"
"Sheltering the harvest-hut\n"
"Of the autumn rice-field\n"
"And my sleeves are growing wet\n"
"With the moisture dripping through\n"
"\n"
"Although the poet describes the rain dampening his sleeves, the image of wet sleeves was a common metaphor for weeping (the word tsuyu can mean dewdrops or tears)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_turtles.tres
msgid "Swimming Turtles"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_turtles.tres
msgid "The image was cropped and one of the turtles was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_turtles.tres
msgid ""
"Depicts three generations of turtles: child, parent, and grandparent.\n"
"\n"
"This succession of descendants may be a representation of the longevity associated with turtles in Japanese culture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_waterwheel.tres
msgid "Waterwheel at Onden"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_waterwheel.tres
msgid "The image was cropped and text overlays were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_waterwheel.tres
msgid ""
"Depicts a water wheel which carries water into a wooden flume that cuts horizontally across the foreground. Two farmers carry sacks of unhulled rice. Women are washing hulled rice in the water of the flume. A little boy, bored, leads his pet turtle on a string to the water. Hokusai is contrasting the activities of people completely absorbed in their task with Mount Fuji, remote and untouched.\n"
"\n"
"Such mills for hulling rice were powered by the waters of the Shibuya River in Onden. Located between Harajuku and Aoyama, now one of the posh centers of Tōkyō, Onden was still a sparsely populated rural area in Hokusai's time."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_yamabe.tres
msgid "Poem by Yamabe no Akahito"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_yamabe.tres
msgid "Only the waves were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_yamabe.tres
msgid ""
"Depicts travelers climbing a steep gradient on a coastal path, one carried in a sedan chair. Mount Fuji is visible across Suruga Bay in the background.\n"
"\n"
"The inscription at the top is a poem about the area by Yamabe no Akahito, a famous 8th-century poet:\n"
"\n"
"[i]In Tago Bay,\n"
"if you look in the distance,\n"
"on the pure white\n"
"peaks of Mount Fuji\n"
"the snow continues to fall.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_yatsuhashi.tres
msgid "Ancient View of the Yatsuhashi Bridge in Mikawa Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_yatsuhashi.tres
msgid "The text and one of the people were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_yatsuhashi.tres
msgid ""
"Depicts the yatsuhashi (\"eight [parts] bridge\") in the Mikawa Province (present-day Eastern Aichi prefecture), zig-zagging over a marsh full of wild irises. Workmen and travelers stroll along the narrow walkway, one man taking a break and sitting at the edge with his feet hanging over.\n"
"\n"
"The bridge is historically associated with section 9 of the [url=https://en.wikipedia.org/wiki/The_Tales_of_Ise]Tales of Ise[/url], an 11th-century narrative poetry collection, one of the three fundamental works of the Heian period.\n"
"\n"
"In this scene, Ariwara no Narihira composes an acrostic poem at an eight-planked bridge over a bed of irises (\"kakitsubata\"), starting each of its five lines with a syllable from the word \"kakitsubata\". Translated, it reads:\n"
"\n"
"[i]Traveling far away I recall the days wearing Chinese-style robes and being with my beloved wife.[/i]\n"
"\n"
"According to the 11th-century Sarashina Diary, the bridge had already ceased to exist by the middle Heian period, but the scene inspired many artists, and here Hokusai recreates it with figures contemporary to his time."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_hokusai_yoshida.tres
msgid "Yoshida on the Tōkaidō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_hokusai_yoshida.tres
msgid "The text and some of the foreground figures were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_hokusai_yoshida.tres
msgid ""
"Depicts travelers in the Fujimi Chaya (\"Fuji-viewing Tea House\", see on the sign in the top center). One woman gazes at Mount Fuji through a large open window, and the other may be ordering cups of tea from a waitress. The waitress appears to be pointing at Mount Fuji, advising her clients to view the mountain while drinking their tea.\n"
"\n"
"On the floor to the left is a palanquin, perhaps used by one of the women. An old man in front of the palanquin repairs a straw sandal, pounding the material to soften it. Two men at the right, apparently exhausted after their long walk, sit on the platform near the entrance, puffing tobacco.\n"
"\n"
"Yoshida, part of the present-day city of Toyohashi, was a famous castle town on the Tōkaidō. Hokusai placed his publisher's name, Eijudō, and its marking, on the round hats near the door post."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_ikkei_kanda_shrine.tres
msgid "Kanda Myōjin Shrine"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_ikkei_kanda_shrine.tres
msgid "The crowd and the text overlays were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_ikkei_kanda_shrine.tres
msgid ""
"Depicts a homeless man and his dog sleeping together on a street in front of Kanda Myōjin Shrine, still standing today.\n"
"\n"
"Passersby are laughing at them, while a soba seller is carrying a portable soba stand in the background.\n"
"\n"
"From the Comic Scenes of 36 Famous Places in Tōkyō series."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_keith_malacca.tres
msgid "Night Scene, Malacca"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_keith_malacca.tres
msgid "The lamps and some of the people were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_keith_malacca.tres
msgid ""
"Depicts a food stall in a village in Malacca, Malaysia, warmly lit by incandescent lamps, and surrounded by coconut palms.\n"
"\n"
"Several figures in traditional Malay garments and wearing turbans and songkok hats are gathered at the front. A woman holding a baby can be seen in the window above.\n"
"\n"
"The stall has a raised veranda and a traditional thatched roof made from nipa palm leaves. Bananas hang from the eaves."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_keith_seoul_gate.tres
msgid "East Gate, Seoul by Moonlight"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_keith_seoul_gate.tres
msgid "The person, the pack animal, and the lit buildings in the background were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_keith_seoul_gate.tres
msgid ""
"Depicts the \"Gate of Uplifting Mercy\" (Heunginjimun), the Eastern of the 8 gates of the Seoul City Wall in Seoul, South Korea. Two of the gates are now destroyed, although the others are still standing. This gate was first constructed in 1398, an example of late Joseon period architecture, and rebuilt in 1869.\n"
"\n"
"Elizabth Keith also produced [url=art_piece:East Gate, Seoul by Sunrise]a morning version of this scene[/url] in 1925."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_keith_sunrise_gate.tres
msgid "East Gate, Seoul by Sunrise"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_keith_sunrise_gate.tres
msgid "The image was cropped and the hut in the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_keith_sunrise_gate.tres
msgid ""
"Depicts the \"Gate of Uplifting Mercy\" (Heunginjimun), the Eastern of the 8 gates of the Seoul City Wall in Seoul, South Korea. Two of the gates are now destroyed, although the others are still standing. This gate was first constructed in 1398, an example of late Joseon period architecture, and rebuilt in 1869.\n"
"\n"
"Elizabth Keith also produced [url=art_piece:East Gate, Seoul by Moonlight]a night version of this scene[/url] in 1920."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kiyochika_cherry_tree.tres
msgid "Cherry Tree"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kiyochika_cherry_tree.tres
msgid "Only the tree was cropped out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kiyochika_cherry_tree.tres
msgid ""
"The warrior Taira no Tadanori seated beneath a cherry tree.\n"
"\n"
"Brother to the head of the Taira clan, Tadanori was a general in the Genpei War fought against the Minamoto. Upon his death in the Battle of Ichi-no-Tani, a poem was discovered in his quiver:\n"
"\n"
"Were I, still traveling as night falls,\n"
"to make a sheltering tree my inn,\n"
"then would my host tonight be the blossoms themselves?"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kiyochika_oyashirazu_beach.tres
msgid "Oyashirazu Beach"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kiyochika_oyashirazu_beach.tres
msgid "The cliff was cut out, repeated in several arrangements, and edited to fit together."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kiyochika_oyashirazu_beach.tres
msgid "The expression \"oya shirazu\" means \"not knowing parents\", and allegedly refers to the coastline in this area being unusually dangerous so that sailors (according to one source) or travelers on foot (according to another source) would forget about their own parents or children in the panic to survive incoming waves."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kiyochika_persimmon.tres
msgid "Persimmon Tree and a Pair of Greenfinches"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kiyochika_persimmon.tres
msgid "Depicts the fruiting branches of a persimmon tree, with a pair of greenfinches perched on them. A rare example of [url=art_style:kachō-e]kachō-e[/url] in Kiyochika's work."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kiyochika_sougou.tres
msgid "Sōgorō at the Ferry Landing"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kiyochika_sougou.tres
msgid "The background was removed and the image was flipped. Only the ferryman was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kiyochika_sougou.tres
msgid ""
"Depicts [url=https://en.wikipedia.org/wiki/Sakura_S%C5%8Dgor%C5%8D]Sakura Sōgorō[/url] asking for passage from a ferryman named Jinbei.\n"
"\n"
"Sōgorō is a legendary figure said to have been a 17th-century farmer executed for appealing to the shōgun to reduce the heavy taxation of peasant, for which he was executed.\n"
"\n"
"This scene is based on the kabkui play Toeizan Nofu no Negaisho (A Farmer's Petition at Mt. Toei)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kiyonaga_bathing_beauty.tres
msgid "Bathing Beauty"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kiyonaga_bathing_beauty.tres
msgid "The woman herself was edited out, and only the bath was used."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kogyo_noh_stage.tres
msgid "Frontispiece of Pictures of Noh Performances"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kogyo_noh_stage.tres
msgid "The image was cropped and a cloud was edited out."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kokunimasa_tsunami_disaster.tres
msgid "Tsunami Disaster in Meiji Era"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kokunimasa_tsunami_disaster.tres
msgid "Modern elements like telephone poles were removed, the page seams were cleaned up, and a rain layer was added to make the style fit better with older prints used in the same intro cutscene."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kokunimasa_tsunami_disaster.tres
msgid "Depicts the Meiji-Sanriku earthquake and tsunami of 1896, likely an example of visual journalism that surrounded the era of sensō-e (war prints), which were often used as propaganda."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_cicada.tres
msgid "Cicada on Willow Tree"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koson_cicada.tres
msgid "The image was flipped, and the cicada was replaced by the image of the related relic."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_deer.tres
msgid "Deer and Pine Tree in Moonlight"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_fox.tres
msgid "Fox in the Reeds"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_frog.tres
msgid "Frog on Lotus Leaf"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koson_frog.tres
#: art/pieces/piece_koson_nest.tres
msgid "The image was extended and recolored."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_frog.tres
msgid "Depicts a frog perching on a lotus leaf, while soft sheets of rain fall in the background. A tiny puddle has pooled at the center of the leaf."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_monkey_moon.tres
msgid "Monkey and Reflection of the Moon"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_monkey_moon.tres
msgid "Depicts a monkey reaching with a long arm towards the reflection of the moon in the water."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_nest.tres
msgid "Japanese Common Crane on Branch of Pine"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_nest.tres
msgid "Depicts a red-crowned crane, also called the Japanese crane, landing onto its nest in a pine. This crane, famous for its elaborate mating dance, is known in Japanese culture as a symbol of longevity and fidelity, as it mates for life."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_playing_monkeys.tres
msgid "Playing Monkeys"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_playing_monkeys.tres
msgid "Depicts two monkeys play-fighting, with pink petals falling around them."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_rabbits.tres
msgid "Grouchy Rabbits"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koson_rabbits.tres
msgid "In some uses, the background was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_rabbits.tres
msgid "Depicts a pair of white rabbits, looking unusually grumpy."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_red_ivy.tres
msgid "Birds and Red Ivy"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koson_red_ivy.tres
#: art/pieces/piece_koson_silhouetted_bird.tres
msgid "This piece is no longer used in the game."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_red_ivy.tres
msgid "Depicts a bird on the branch of a tree wrapped in red ivy leaves, with other trees disappearing into the mist in the background."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_shrike_spider.tres
msgid "Bull-headed Shrike Watching Spider"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koson_shrike_spider.tres
msgid "Only the spider and its web were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_shrike_spider.tres
msgid "Depicts a bull-headed shrike hunting a spider. These shrikes are predatory songbirds featured in numerous ukiyo-e paintings, usually associated with the arrival of autumn."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_silhouetted_bird.tres
msgid "Silhouetted Bird"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_silhouetted_bird.tres
msgid "Depicts a bird in the rain in the background, and a blooming vine in the foreground."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_tadpoles.tres
msgid "Frog and Tadpoles"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_tadpoles.tres
msgid "Depicts a frog climbing onto a lotus leaf, while tadpoles are swimming nearby. Both blooming and withered lotus flowers appear in the background."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koson_tanuki.tres
msgid "Tanuki and Autumn Grasses"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koson_tanuki.tres
msgid "Depicts a tanuki (Japanese raccoon dog), sitting among pampas grass looking up at the moon. This was a recognized symbol of autumn evenings and numerous ukiyo-e prints depict similar scenes."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_koto_flood.tres
msgid "Illustration of the Disastrous Flood"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_koto_flood.tres
msgid "Only the left frame was used, and people were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_koto_flood.tres
msgid ""
"Depicts a devastating flood which occurred in Tōkyō in September 1896, after weeks of torrential rain caused the city's major rivers to breach their banks. This triptych captures the inundated Mukojima district near the Mimeguri Shrine, where the collapse of the Nakagawa embankment transformed the landscape into a vast, navigable lake.\n"
"\n"
"Beyond its artistic value, the print documents a pivotal moment in Japanese history: the catastrophe spurred the enactment of the 1896 River Law, which shifted the responsibility for large-scale flood control to the central government. Despite engineering and legislative efforts, the low-lying regions depicted here remain a focal point of Tōkyō's urban vulnerability today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kouhou_moonlit_beach.tres
msgid "Woman on a Beach by Moonlight"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kouhou_moonlit_beach.tres
msgid "The woman was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kouhou_moonlit_beach.tres
msgid "This print depicts a woman on a serene nighttime beach. There is an alternative version of this print, with the same linework but different colors, that depicts the same scene in the early morning."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kouhou_morning_mist.tres
msgid "Morning Mist"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kouhou_morning_mist.tres
msgid "The temple and the fishing gear were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kouhou_morning_mist.tres
msgid "Depicts three people fishing in a small boat on a misty day. A red temple compound is seen among the tall trees."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kouhou_river_torii.tres
msgid "Torii in a River"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kouhou_river_torii.tres
msgid "The gate was edited to look like a regular torii gate and the text was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kouhou_river_torii.tres
msgid ""
"This depicts a mihashira (\"three pillars\") torii gate, which is a variation of torii gates that has three pillars and looks like three joined torii gates.\n"
"\n"
"While the origins of the mihashira torii are unclear, some claim that they were built by early Japanese Christians to secretly represent the Holy Trinity, as there's little evidence of such gates in Shinto traditions."
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kouhou_temple_bell.tres
msgid "The monk and the buildings in the background were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kouhou_temple_bell.tres
msgid "Depicts a priest ringing a temple bell at night, with several roofs and a pagoda peeking through the forest canopy in the background."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kunichika_pirate_chief.tres
msgid "Kezori Kuemon"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kunichika_pirate_chief.tres
msgid ""
"Depicts the actor Ichikawa Danjuro IX as Kezori Kuemon, a smuggler captain from the kabuki play Koi Minato Hakata no Hitofushi (also known as Hakata Kojorō Nami Makura).\n"
"\n"
"The play tells the story of a merchant who accidentally boards a smuggler ship while on a trip to see courtesan, and ends up forced to join the gang.\n"
"\n"
"Danjuro is famous for originating an iconic pose, the [i]shiomi no mie[/i] (\"staring at the sea dramatic pose\") in this play.\n"
"\n"
"The poem on the top right reads:\n"
"\n"
"[i]White waves,\n"
"On a night boat\n"
"light blue\n"
"sails raised.\n"
"The sound of waves.[/i]\n"
"\n"
"The \"white waves\" mentioned in the poem are a kabuki keyword that alludes to plays featuring bandits."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kunisada_hannya.tres
msgid "Actor Ichikawa Danjūrō VII as Endō Musha Morichika"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kunisada_hannya.tres
msgid "The background was removed and only the mask was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kunisada_hannya.tres
msgid ""
"Depicts the kabuki actor Ichikawa Danjūrō VII playing the role of Endō Musha Morichika. In the play, Morichika is obsessed with a married noblewoman, and in an attempt to murder her husband, kills her instead. As repentance he becomes the renowned Buddhist monk Mongaku.\n"
"\n"
"The mask which the man is holding is the [url=https://en.wikipedia.org/wiki/Hannya]Hannya[/url], a Noh theater mask representing a jealous female demon.\n"
"\n"
"Several verses are inscribed on the print. The one on the left is by Ichikawa Sanshō, reading:\n"
"\n"
"[i]In the spring field,\n"
"I cross the mist,\n"
"perhaps to revel.[/i]\n"
"\n"
"The one on the right is by Goryūtei Tokushō:\n"
"\n"
"[i]The edge of the mountain\n"
"draws mist,\n"
"iridescent.\n"
"In the hazy shadow,\n"
"Lovers embrace.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kunisada_masatsune.tres
msgid "Poem by Sangi Masatsune"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kunisada_masatsune.tres
msgid ""
"Depicts a woman fulling cloth. This process involved beating it to clean out the impurities and impart a sheen.\n"
"\n"
"The poem in the top right is by Fujiwara no Masatsune:\n"
"\n"
"[i]Yoshino's\n"
"autumn mountain wind\n"
"deepens the night.\n"
"[lb]In[rb] the cold former capital [lb]of Nara[rb],\n"
"cloth is fulled.[/i]\n"
"\n"
"The background shows Genji crests for reasons unclear to me."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kunisada_mochi.tres
msgid "Spring of the Wood Rat Year, Golden Fresh Mochi"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kunisada_mochi.tres
msgid "Only the second panel was used, and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kunisada_mochi.tres
msgid ""
"This five-panel print depicts the lively custom of mochitsuki (\"pounding mochi\") in preparation for the New Year. The custom has existed for millennia, and is still practiced today.\n"
"\n"
"On the right side, men are using a large mortar to pound steaming glutinous rice, while on the left the resulting sticky mass is shaped into individual cakes. In the bottom left corner is a woman grating daikon radish, which is sometimes used as a mochi topping.\n"
"\n"
"The people in the print are actually popular Kabuki actors of the era. It was common in ukiyo-e prints of the era to use celebrities as stand-ins for common people."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kunisada_mushrooms.tres
msgid "Mitsuuji Enjoys a Mushroom Hunt"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kunisada_mushrooms.tres
msgid "Only the left panel was used, the text was removed, and the colors were adjusted."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kunisada_mushrooms.tres
msgid ""
"Depicts the fictional Ashikaga Mitsuuji on a picnic, with attendants bringing mushrooms for the meal.\n"
"\n"
"Mitsuuji is the protagonist of a 19th-century serial novel A Fraudulent Murasaki's Rustic Genji by Ryūtei Tanehiko, a swashbuckling adaptation of the 11th-century novel, The Tale of Genji."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_asakura_togo.tres
msgid "The Ghost of Asakura Tōgo"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_asakura_togo.tres
msgid "The image was flipped and the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_asakura_togo.tres
msgid ""
"Depicts the kabuki actor Ichikawa Kodanji IV as the Ghost of Asakura Tōgo.\n"
"\n"
"This play, The Tale of the Martyr of Sakura, was based on a historical event, with the names, locations, and time period changed to elude censorship. It tells the story of Asakura Tōgo, a village leader who travels to Edo to petition the shōgun, which is strictly prohibited. After he is executed together with his family, his ghost takes revenge on the executioner."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_banishment_to_sado_island.tres
msgid "Banishment to Sado Island"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_banishment_to_sado_island.tres
msgid "The text was edited out, the crease was cleaned up, and a rain layer was added to make the style fit better with other prints used in the same intro cutscene."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_banishment_to_sado_island.tres
msgid ""
"The full title is Banishment to Sado Island: Sutra Title on the Waves at Kakuta.\n"
"\n"
"This prints depicts the priest Nichiren on his way to his forced exile to Sado Island, while a large storm in the Sea of Japan threatens to destroy his boat and frightened crew. To protect them, Nichiren casts a spell, the Daimoku mantra of the Lotus Sutra, \"Namu Myōhō Renge Kyō\", which appears on the waves.\n"
"\n"
"The wave is likely inspired by [url=artist:Katsushika Hokusai]Hokusai[/url]'s [url=art_piece:Great Wave off Kanagawa]Great Wave off Kanagawa[/url]."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_calligraphy_gathering.tres
msgid "A Children's Calligraphy Gathering"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_calligraphy_gathering.tres
msgid ""
"Depicts a calligraphy gathering at a school during the Edo period (1603–1868). At these events, children publicly demonstrated their skills in calligraphy.\n"
"\n"
"This scene takes place in a terakoya (\"temple school\"), where Edo-period commoner children learned reading, writing, and arithmetic. The Edo period was a time of unprecedented peace that gave rise to broad literacy fostered by such schools.\n"
"\n"
"Hung above the doors are examples of particularly impressive calligraphy, including ancient poems and auspicious phrases or mottoes.\n"
"\n"
"In the alcove on the left is a portrait of Sugawara no Michizane (845–903), a Heian scholar revered as a deity of learning. His portrait is being honored with offerings to bless the students' academic progress."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_chusenko.tres
msgid "Chūsenko Tei Tokuson"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_chusenko.tres
msgid "Only the snake was used, with the rest of the image edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_chusenko.tres
msgid "Depicts Chūsenko Tei Tokuson (Ding Desun), a hero from the Chinese epic Water Margin, raising his sword to plunge it into the head of a giant snake."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_daruma.tres
msgid "Moriyama Station: Daruma Daishi"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_daruma.tres
msgid "The overlays were removed, and the background was simplified."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_daruma.tres
msgid ""
"Depicts Daruma Daishi eating mounded dishes of soba noodles in a riverside noodle shop, as a shop assistant watches in disbelief.\n"
"\n"
"Daruma Daishi is the Japanese name for the semi-legendary Indian monk Bodhidharma, who is credited with founding Zen Buddhism and bringing it to China in the 5th or 6th century."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_foxes.tres
msgid "Foxes Training in Disguise"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_foxes.tres
msgid "The supernatural elements were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_foxes.tres
msgid ""
"Fox spirits appear in Japanese folklore in a variety of roles: servants of the goddess Inari, destructive tricksters, or even benevolent defenders.\n"
"\n"
"Among their most common powers is the ability to disguise themselves as humans. This print shows a group of foxes practicing this skill. Two foxes stack reeds on their heads, a necessary preparation for shape-shifting. Other foxes have already succeeded, parading about as young women and monks."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_fukurokuju.tres
msgid "Fukurokuju"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_fukurokuju.tres
msgid ""
"Depicts the actor Bandō Takesaburō I seated in a garden with blue flowers, rolling up a scroll, while a turtle is crawling up the bank towards him.\n"
"\n"
"The inset depicts Fukurokuju, a god of wisdom and longevity, likely an assimilation of several Chinese deities. He is one of the Seven Lucky Gods in Japanese mythology, and was believed to be an immortal who could exist without eating food during his human incarnation.\n"
"\n"
"The inset is signed Yoshijo (\"daughter of Yoshi\"), Kuniyoshi's daughter and student."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_fukushima.tres
msgid "Fukushima"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_fukushima.tres
msgid "The image was cropped and the cloud was adjusted to not come out of the turtle."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_fukushima.tres
msgid ""
"Depicts Urashima Tarō, a fairy tale hero, on a shore under a pine tree with a turtle, from whose mouth issues a vision of the Dragon Palace.\n"
"\n"
"The Urashima Tarō fairy tale tells of a fisherman rewarded for rescuing a sea turtle, and carried on its back to the Dragon Palace beneath the sea. There, he is entertained by the princess Otohime. He spends what he believes to be several days with the princess, but when he returns to his home village, he discovers he has been gone for at least a hundred years. When he opens the forbidden jewelled box given to him by Otohime, he turns into an old man.\n"
"\n"
"The inset shows a descending road between steep wooded hills, presumably in Fukushima."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_jizou.tres
msgid "Picture of Hashiba in the Eastern Capital"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_jizou.tres
msgid "The statue was edited and the foreground figure was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_jizou.tres
msgid ""
"Depicts people looking at the statue of Jizō in a pine grove in the town of Hashiba, within modern-day Tōkyō.\n"
"\n"
"Jizō is a Buddhist deity, the patron of children, particularly deceased or aborted children, as well as hell beings."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_monkey_sign.tres
msgid "Monkey: Yojirō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_monkey_sign.tres
msgid "The background was removed and the face was recolored."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_monkey_sign.tres
msgid ""
"Depicts Yojirō, a monkey trainer from the play [url=https://www.kabuki21.com/horikawa.php]Chikagoro Kawara no Tatehiki (\"Recent Riverbed Confrontation\")[/url], seated by a smoking fire and a meal tray.\n"
"\n"
"A tiny monkey can be seen in top right corner above the cartouche, as this print is from a series likening characters to zodiac animals.\n"
"\n"
"The play is a love story between Yojirō's sister, a courtesan, and her lover, as well as Yojirō's devotion to his sister. The play was originally made for bunraku (puppet theater), but was later adapted to kabuki. The inscription in the top left praises Yojirō for his devotion.\n"
"\n"
"One production of the play during the Meiji period used a real monkey, and ended up with said monkey urinating on stage."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_okabe.tres
msgid "Okabe: The Story of the Cat Stone"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_okabe.tres
msgid "Only the old woman was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_okabe.tres
msgid ""
"Depicts a folklore scene associated with the village of Okabe (in present-day Shizuoka prefecture). A young woman is being menaced by an old, monstrous woman. In the background, a giant ghostly apparition of a cat appears through shredded blinds. The text at the top gives context:\n"
"\n"
"[i]Along a narrow ivy path above the shrine plain, beside the edge of six or seven old pine trees, lies the Cat Stone, a giant boulder resembling the shape of a crouching cat.\n"
"\n"
"Long ago, there was a solitary house in this place. An ancient mountain cat transformed into an old woman here and harmed many people. It tormented the locals until a Lesser Tengu exterminated it.\n"
"\n"
"According to folklore, the beast finally died and its spirit transformed into this stone, though the exact details of this legend remain uncertain.[/i]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_rain_and_thunder_in_hashidate.tres
msgid "Rain and Lightning in Hashidate"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_rain_and_thunder_in_hashidate.tres
msgid "A pine tree frames an expansive view of a thunderstorm in Miyazu Bay, one of Japan's canonical list of \"three scenic views\". It features the \"Ama no Hashidate\", a long, narrow sandbar covered in thousands of pine trees."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_rock_gazing.tres
msgid "Gazing at the Rock on Komuro Mountain"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_rock_gazing.tres
msgid "In one case the warriors were edited out and the piece was cropped. In another case, only the cliff and floating rock were used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_rock_gazing.tres
msgid ""
"Depicts the priest Nichiren in Komuroyama suspending a large rock thrown at him by a yamabushi, or mountain hermit.\n"
"\n"
"Various versions of this legend exist. In one retelling, the hermit threw a rock at Nichiren, which he was able to suspend in the air by the sheer will of his \"spiritual power\". In another version of the story, a member of a competing Buddhist school invited Nichiren to a contest to see who had the greater religious power to control the levitation of a rock. According to this legend, the man was able to lift the rock but Nichiren prevented him from lowering it. Upon losing the contest, the story goes, the man left his sect and became Nichiren's follower."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_shotoku.tres
msgid "The Miraculous Gourd"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_shotoku.tres
msgid "The image was cropped and split into two and recombined, the horse was edited out, and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_shotoku.tres
msgid ""
"Depicts people admiring a miraculous gourd that appeared at the birth of Prince Shōtoku, guarded by a sacred snake.\n"
"\n"
"[url=https://en.wikipedia.org/wiki/Prince_Sh%C5%8Dtoku]Prince Shōtoku[/url] (574-622) was a semi-legendary regent and a politician of the Asuka period in Japan who served under Empress Suiko. He is regarded as a protector of Buddhism in Japan.\n"
"\n"
"According to legend, around the time of Prince Shōtoku's birth, a mysterious gourd grew in the garden of Emaro in Sanuki Province. As the gourd grew to a great size, images of holy sages and written characters appeared on it, and a sacred snake came to protect it."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_sunrise.tres
msgid "The First Sunrise of the New Year at Susaki"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_sunrise.tres
msgid "The image was flipped and the foreground figures were edited out."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_tang_long.tres
msgid "Tōryū the Golden Leopard"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_tang_long.tres
msgid ""
"Depicts Tōryū (Tang Long), a hero from the Chinese epic Water Margin, making hooked sickle spears, the signature anti-cavalry weapon of his cousin Xu Ning's squad.\n"
"\n"
"The text in the background gives a basic background on the character and his role in the story."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_toi_crystal_river.tres
msgid "The Toi Crystal River in Settsu Province"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_toi_crystal_river.tres
msgid "Only the left panel was used and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_toi_crystal_river.tres
msgid "Depicts women beating the creases out of cloth on the banks of the Toi Crystal River in Settsu Province (presently covering parts of the Hyōgo and Ōsaka prefectures)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_tsuchigumo.tres
msgid "The Earth Spider Slain by Minamoto no Yorimitsu's Retainers"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kuniyoshi_tsuchigumo.tres
msgid "Only the spider was used, with the rest of the image edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_tsuchigumo.tres
msgid "Depicts the historical samurai Minamoto no Yorimitsu defeating a yōkai called Tsuchigumo (\"earth spider\"). The name of this yōkai was a derogatory term for renegade local clans, primarily during the Asuka, Nara, and early Heian periods."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kuniyoshi_warabi.tres
msgid "Warabi Station: Inuyama Dōsetsu"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kuniyoshi_warabi.tres
msgid ""
"Depicts Inuyama Dōsetsu, one of the \"eight dog\" heroes from the epic Hakkenden (\"Tale of Eight Dogs\"). He was a fire magician who traveled through villages to walk through fire in exchange for offerings.\n"
"\n"
"Dōsetsu is dressed in the white robes of an ascetic and holds a pine sprig wrapped in an incantation between his teeth.\n"
"\n"
"The left hand inset shows the Warabi village where the related chapter of the epic takes place. The name is a pun on \"straw fire\" which is visible amid the flames."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kyosai_coastal_island.tres
msgid "Mount Fuji and Coastal Island"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kyosai_coastal_island.tres
msgid "Only the mountain was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kyosai_coastal_island.tres
msgid ""
"Depicts a rough ocean wave around a small coastal island, with a tiny boat lost in the mist on the horizon and a majestic Mount Fuji peeking through the clouds above.\n"
"\n"
"This version is a posthumous reprint, circa 1930."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kyosai_guardian_god.tres
msgid "Niō Statue"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_kyosai_guardian_god.tres
msgid "The image was flipped and recolored, and the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kyosai_guardian_god.tres
msgid ""
"A Niō guardian statue at a temple gate. Niō are two legendary guardians of the Buddha, and their statues are often found standing at the entrance of many Buddhist temples in East Asian Buddhism.\n"
"\n"
"The title of this print may be inaccurate, as sources disagree."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_kyosai_tiger_screen.tres
msgid "Standing Screen of a Tiger"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_kyosai_tiger_screen.tres
msgid ""
"Depicts a tiger painted on a standing screen in an artist's studio, surrounded by ink, brushes, and rolls of paper.\n"
"\n"
"The print was likely designed to celebrate the arrival of the Year of the Tiger in 1878."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_moronobu_charted_map_of_tokaidou.tres
msgid "A Charted Map of the Tōkaidō"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_moronobu_charted_map_of_tokaidou.tres
msgid ""
"This example page is from a travel guide of the Tōkaidō (Eastern Sea Road), connecting Edo (present-day Tōkyō) to Kyōto, the most important of the Five Routes of the Edo period.\n"
"\n"
"Such guides were targeted as much towards travelers as towards common people who wanted to experience travel vicariously. The print depicts villages, shrines, and famous locations, and includes text that lists things such as travel fees and restaurant recommendations.\n"
"\n"
"Follow the link above to view more pages from this travel guide."
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_original_forest_shrine.tres
msgid "Forest Shrine"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_original_forest_shrine.tres
msgid ""
"Inspired by a quote from [url=artist:Hiroshi Yoshida]Yoshida[/url]'s book, Japanese Wood-Block Printing:\n"
"\n"
"\"I should disapprove of nobody more heartily than one who merely copied what he sees [...] and not going a step beyond or making any effort to do so. [...] I wish that the knowledge and accomplishments I have set forth herein may serve as a foundation for others to build upon, raising their own structures which shall be in style and substance worthy of them and of the age in which they live.\""
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_original_ghost_lanterns.tres
#: stage/spots/seashore/upgrade_seashore_3_ghost_lanterns.tres
msgid "Ghost Lanterns"
msgstr ""

#. TRANSLATORS: Property: name
#. Property: event_name
#: art/pieces/piece_original_iron_wreck.tres
#: events/generic/iron_wreck/event_iron_wreck.tres
msgid "The Iron Wreck"
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_original_lake_shrine.tres
msgid "Lake Shrine"
msgstr ""

#. TRANSLATORS: Property: name
#: art/pieces/piece_original_pillars.tres
msgid "Steppe Pillars"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_oukyo_tiger.tres
msgid ""
"Depicts a tiger by a cliff wall.\n"
"\n"
"The title of the work does not survive. The only prints of this image I could find, including the one featured here, are dated 1892, long after the artist's death."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_placeholder.tres
msgid "This image is a temporary placeholder that should be replaced before release."
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_raijirou_tiger.tres
msgid "The image was split and recomposed to fit a vertical format."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_raijirou_tiger.tres
msgid ""
"Depicts a tiger looking up at the moon, surrounded by maple leaves dancing in the wind.\n"
"\n"
"Although often misattributed to [url=artist:Katsushika Hokusai]Katsushika Hokusai[/url] online, this appears to be by Ichikawa Raijiro, published in a Hokusai-inspired book titled Katsushika Calligraphic Illustrated Compendium."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_sadahide_rokuhara.tres
msgid "The Battle of Rokuhara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_sadahide_rokuhara.tres
msgid "The triptych was stitched, text was removed, and the battle was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_sadahide_rokuhara.tres
msgid "Depicts the burning of the Rokuhara Palace in 1333, based on The Chronicle of Great Peace. This historical epic describes the fall of the Kamakura military government in an attempt for imperial restoration led by Emperor Go-Daigo (1288-1339) with the support of the Kusunoki Masashige samurai, Nitta Yoshisada (1301-1338) and Ashikaga Takauji (1305-1358). The latter finally seized power and managed to be named shōgun. The burning of the palace was the final defeat of the Kamakura military government, leading to Japan being ruled by the Ashikaga clan from 1338 to 1573."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shigenobu_excursions.tres
msgid "Pictures of Excursions Through the Famous Sites of the Capital"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shigenobu_excursions.tres
msgid ""
"This is a small portion from a pair of long handscrolls which depict sites in Kyōto, the imperial capital of Japan.\n"
"\n"
"The full scrolls, available from the link above, show dozens of different places, from temples and festivals, to horse races and farms. The scroll is filled with hundreds of people of all ages and all walks of life. Many of the figures are repeated with identical postures but different clothing colors.\n"
"\n"
"In addition to inked lines and watercolor shading, the scroll is decorated with metallic dust, possibly gold, but more likely gold-colored brass."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shinsai_rabbit_scroll.tres
msgid "Rabbit Incense Burner and Scroll Painting of Fukurokuju"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shinsai_rabbit_scroll.tres
msgid "Only the flower was cut out to be used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shinsai_rabbit_scroll.tres
msgid "From a collection of still life surimono (commissioned prints) called The Rabbit's Boastful Exploits, incorporating the motif of the Japanese Year of the Rabbit."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shinsai_scrolls.tres
msgid "Picture Scrolls, Inkstone, and Brush"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shinsai_scrolls.tres
msgid "The image was cropped and some cropped parts were moved to the top left."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shinsai_treasure_ship.tres
msgid "Painting of a Ship of Treasures and a Western Clock"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shinsai_treasure_ship.tres
msgid "The scroll was cut out and the background was discarded."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shinsai_treasure_ship.tres
msgid "This surimono (commissioned prints) depicts a takarabune (\"treasure ship\"), a mythical vessel from Japanese folklore, believed to sail into port during the first three days of the New Year, carrying the Seven Lucky Gods. It symbolizes good fortune, wealth, and prosperity, with roots in the Edo period when people placed pictures of it under their pillows for a lucky first dream."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shousou_tigers.tres
msgid "The Qing Army's Foolish Plan of Using Tigers as Weapons"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shousou_tigers.tres
msgid "The stamp was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shousou_tigers.tres
msgid ""
"This propaganda print from the First Sino-Japanese War depicts a group of Japanese soldiers being confronted by a pack of tigers, set upon them by The Chinese Qing army.\n"
"\n"
"Such a scene has no basis in real history."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shoutei_ashitakayama.tres
msgid "The Foothills of the Mountains, Ashitakayama, Summer"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shoutei_ashitakayama.tres
msgid "Depicts a river at the foothills of mount Ashitaka in Shizuoka prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shoutei_gamman_ga_fuchi.tres
msgid "Gamman-ga-Fuchi in Nikko"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shoutei_gamman_ga_fuchi.tres
msgid ""
"Depicts an autumn scene of the river gorge known today as the [url=https://www.japan-guide.com/e/e3810.html]Kanman-ga-fuchi Abyss[/url] in Nikko, Tochigi prefecture.\n"
"\n"
" The short gorge was formed by an eruption of Mount Nantai and today serves as a pleasant riverside walking trail.\n"
"\n"
"According to legend, in 1654 the priest Kōkai established the Jiun-ji Temple near this gorge, and the priests there chanted a mantra than ended with the word \"kanman\" (\"finish firmly\"), for which the gorge was named."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shoutei_night_rain.tres
msgid "Night View of Lanterns on the Road to Nikkō"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shoutei_night_rain.tres
msgid "Depicts roadside lanterns on a rainy night in Nikkō, Tochigi prefecture. The area is famous for its tall cedars which can be seen in this print. The saying \"Never say kekkō (magnificent) until you've seen Nikkō\" is a reference to the city's beauty."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shoutei_temple_3.tres
msgid "The Setting Sun at Temple"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shoutei_temple_3.tres
msgid "This image is no longer used in the game."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shoutei_ueno_kiyomizu_dou.tres
msgid "Ueno Kiyomizu-dō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shoutei_ueno_kiyomizu_dou.tres
msgid "The image was cropped and the people were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shoutei_ueno_kiyomizu_dou.tres
msgid ""
"Depicts a rainy afternoon at the Kiyomizu Kiyomizu-dō temple in Ueno Park, Tōkyō.\n"
"\n"
"The temple was built in 1631, modeled after Kyōto's famous Kiyomizu-dera. It features a raised, pillared veranda overlooking Shinobazu Pond and is celebrated for its Moon Pine tree, depicted in numerous ukiyo-e prints. You can visit the temple and see the (current generation of the) tree even today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shunkei_grasshopper.tres
msgid "Grasshopper and Flowering Squash"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shunkei_grasshopper.tres
#: art/pieces/piece_utamaro_grasshopper.tres
msgid "The image was cropped and the background was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shunkei_grasshopper.tres
msgid "From the e-hon (\"illustrated book\") Chuka Senzen (\"Selection of Insects at My Elbow\"), which contains 12 detailed illustrations of insects and plants, alternating with 12 Chinese verses."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shunshou_airing_books.tres
msgid "Women Airing Books and Clothes"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shunshou_airing_books.tres
msgid ""
"Depicts four women and a young boy drying out books. One of the women is distracted by what she finds in an open book.\n"
"\n"
"This annual practice was called mushiboshi (\"drying bugs\"). During the late summer, people at homes and temples would remove books, scrolls, and clothes from storage and hang them over a line to air out and prevent mildew and insect damage.\n"
"\n"
"The cuckoo at the very top of the image is often associated with poetry expressing love and longing (or alternatively, courtesans)."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shuntei_oomukade.tres
msgid "Fujiwara no Hidesato with the Ōmukade at Lake Biwa"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shuntei_oomukade.tres
msgid ""
"Depicts [url=https://en.wikipedia.org/wiki/Fujiwara_no_Hidesato]Fujiwara no Hidesato[/url], a Heian-period folk hero, being attacked by Ōmukade, a giant centipede yōkai.\n"
"\n"
"The scene comes from the [url=https://en.wikipedia.org/wiki/Tawara_T%C5%8Dda_Monogatari]Tale of Tawara Tōda[/url]. According to this legend, Hidesato was asked by a giant serpent to avenge the killer of her offspring. He found the centipede at Mount Mikami, shot two ineffective arrows, but the third arrow smeared with his saliva proved lethal."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_shuuun_tanuki.tres
msgid "Tanuki and Full Moon"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_shuuun_tanuki.tres
msgid "The things carried by the tanuki were removed and the image was cropped."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_shuuun_tanuki.tres
#: art/pieces/piece_souzan_tanuki.tres
msgid "Depicts a tanuki (Japanese raccoon dog), surrounded by vines and grass looking up, presumably at the moon. A tanuki looking at the moon was a recognized symbol of autumn evenings and numerous ukiyo-e prints depict similar scenes."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_souzan_tanuki.tres
msgid "Tanuki in Grass"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_tankei_eruption.tres
msgid "Eruption of Mount Bandai"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_tankei_eruption.tres
msgid "Only the right panel of the triptych was used and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_tankei_eruption.tres
msgid ""
"Depicts the 1888 eruption of Mount Bandai in Fukushima prefecture. The paragraph on the left outlines the horrific aftermath of the event. The details listed below are augmented with modern statistics.\n"
"\n"
"The eruption occurred on the morning of July 15, 1888, triggered by a relatively minor earthquake. The initial explosion was followed by successive blasts occurring 15 to 20 times per minute. Each explosion was accompanied by thunder and a black eruption column up to 1300 meters high. Several hours later hot rain started falling, transforming the vast quantity of ash into volcanic mudslides.\n"
"\n"
"The eruption transformed hundreds of square kilometers of forest and farmland around the mountain into a wasteland, and several villages were completely buried under landslides. At least 477 people were killed, and hundreds more were injured and rendered homeless."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_toshikata_spring_sea.tres
msgid "Spring Sea"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_toshikata_spring_sea.tres
msgid "The seashells were replaced with bones, the boats and the waves were removed, and the image was flipped and recolored to depict a wasteland."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_toshikata_spring_sea.tres
msgid ""
"Depicts a young woman collecting seashells into a handkerchief on a springtime beach. Waves lap gently at the shore and distant boats are fading into the mist against the silhouette of a mountain.\n"
"\n"
"The print uses soft shading and pastel colors, common in Toshikata's style.\n"
"\n"
"This print was published in volume 11, no. 4 of the Bungei Kurabu magazine as a decorative frontispiece. Despite what you might read online, it was not associated with a particular article or story in the issue."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_toukou_cat_spider.tres
msgid "Cat Watching a Spider"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_toukou_cat_spider.tres
msgid "The text was edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_toukou_cat_spider.tres
msgid "Unlike most artwork featured in the game, this piece was a painting on silk rather than a woodblock print, though the composition and perspective are reminiscent of ukiyo-e."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_tsukumogami_drum.tres
msgid "Drum Yōkai"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_tsukumogami_drum.tres
msgid "Depicts an unidentified yōkai associated with hand drums. This is an example of Tsukumogami (\"tool spirit\"). According to legends, once a tool is over 100 years old, it would develop a spirit (kami), and with this change would become a tsukumogami."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_unknown_cat_and_toad.tres
msgid "Cat and Toad"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_unknown_namazu.tres
msgid "The Cause of the Great Catfish at Shin Yoshiwara"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_unknown_namazu.tres
msgid "The people were edited out and the fish was retextured to match the e-maki style of other yōkai images."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_unknown_namazu.tres
msgid ""
"Depicts people beating a giant catfish. Apparently, the women of the pleasure quarters blame the catfish for the earthquake, but the catfish is delighted to have these ladies press flesh with it, and threatens to squirm again, causing aftershocks.\n"
"\n"
"This is an example of [url=https://en.wikipedia.org/wiki/Namazu#Namazu-e]namazu-e[/url], depictions of catfish as causes of earthquakes. Over a dozen prints by different artists with this motif exist. This one was made after the 1855 Edo earthquake."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_unknown_sea_bream.tres
msgid "Sea Bream in the Ocean"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_unknown_sea_bream.tres
msgid ""
"This print by an unidentified artist comes from the Meiji era and depicts groups of sea bream (\"tai\").\n"
"\n"
"The sea bream is associated with good fortune and abundance in Japanese culture, and eaten on special occasions as a luxury food.\n"
"\n"
"The red scales are considered auspicious, and traditionally believed to ward off evil spirits. Public figures such as politicians or sumo wrestlers are sometimes photographed holding up a red sea bream after a victorious event.\n"
"\n"
"Ebisu, the god of fortune and fishermen, is often portrayed holding a red sea bream.\n"
"\n"
"Several Japanese idioms also reference the red sea bream as a precious object:[ul]\n"
"To fish a sea bream using a shrimp as bait (海老で鯛を釣る, ebi de tai o tsuru): To gain a great profit or achievement with minimal investment.\n"
"Even if it's rotten, it's still sea bream (腐っても鯛, kusatte mo tai): Something of high quality still retains its value even if it becomes degraded.\n"
"Rather a sardine's head than a sea bream's tail (鯛の尾より鰯の頭, tai no o yori iwashi no atama): It's better to be the leader of a small group rather than a follower of a large group.\n"
"[/ul]"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_unknown_teapot.tres
msgid "Teapot With Cherry Blossoms"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_utamaro_grasshopper.tres
msgid "Grasshopper and Cicada"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_utamaro_grasshopper.tres
msgid "An illustration from Utamaro's Picture Book of Selected Insects."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_utamaro_persimmons.tres
msgid "Picking Persimmons"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_utamaro_persimmons.tres
msgid "The image was cropped and some fruits were moved."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_utamaro_persimmons.tres
msgid "Depicts a group of people gathering persimmons. This is an example of [url=https://en.wikipedia.org/wiki/Benizuri-e]Benizuri-e[/url], an early ukiyo-e style that used only crimson (\"beni\") and green ink."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yagyou_curtains.tres
msgid "Yōkai in Front of a Curtain"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yagyou_curtains.tres
msgid "The background was edited out and only the left figure was used, with the tassel removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_curtains.tres
msgid "Depicts a group of unidentified yōkai, two sitting in front of a curtain, and a few peeking from behind."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yagyou_furunushi.tres
msgid "Koto Furunushi and Biwa Bokuboku"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yagyou_furunushi.tres
msgid "The background and the biwa monster were edited out."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_furunushi.tres
msgid ""
"Depicts a pair of yōkai, the Koto Furunushi (\"old master koto\") and the Biwa Bokuboku, both considered harmless.\n"
"\n"
"The Koto Furunushi looks like a koto (a Japanese zither) which grows a demonic face on its front.\n"
"\n"
"The Biwa Bokuboku is an anthropomorphic being with the head of a biwa (a Japanese lute). It comes to life at night and sits calmly in a tatami room, singing and plinking while lamenting the neglect of its former owner. Other stories report it dancing through inhabited houses while making much noise."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_housougami.tres
#: stage/hauntings/types/housougami/haunting_housougami.tres
msgid "Hōsōgami"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_housougami.tres
msgid ""
"The Hōsōgami (\"smallpox demon\"), a yōkai thought to cause smallpox. Since people in the past had no effective treatment for smallpox, they tried to appease the demon by assuaging its anger or attacking it.\n"
"\n"
"In Ryūkyū (present-day Okinawa), there was poetry for appeasing the smallpox demon, including a collection of 105 poems published in 1805.\n"
"\n"
"Traditional smallpox-appeasing folk dances have also been observed even in present-day Japan, notably in Ibaraki and Kagoshima prefectures."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_kasukurai.tres
#: stage/hauntings/types/kasukurai/haunting_kasukurai.tres
msgid "Kasukurai"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_kasukurai.tres
msgid "The Kasukurai (\"leftovers eater\"), a yōkai thought to appear when food scraps are thrown away instead of being eaten, illustrating the Japanese concept of [url=https://en.wikipedia.org/wiki/Mottainai]mottainai[/url], a sense of regret over waste."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_kotengu.tres
#: stage/hauntings/types/kotengu/haunting_kotengu.tres
msgid "Kotengu"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_kotengu.tres
msgid "Depicts a yōkai of unclear identity. It is most like a Kotengu (\"lesser heavenly dog\"), a human-bird hybrid that hoards human implements and goes on rampages."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_kyuuso.tres
#: stage/hauntings/types/kyuuso/haunting_kyuuso.tres
msgid "Kyūso"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_kyuuso.tres
msgid "The Kyūso (\"former rat\"), a giant yōkai rat. It is said that when a mouse or a rat reaches 1000 years of age, it turns into this giant rodent and loses its sense of fear."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_nigawarai.tres
#: stage/hauntings/types/nigawarai/haunting_nigawarai.tres
msgid "Nigawarai"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_nigawarai.tres
msgid "The Nigawarai (\"bitter smile\"), an ogre-like yōkai with a green body, venomous claws, and a hairy mouth twisted into a forced smile. Nigawarai are said to come when people smile uncomfortably to hide their feelings of discomfort."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yagyou_onibi.tres
msgid "Sun and Flames"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yagyou_onibi.tres
msgid "Only the flames were used, with the background being edited out, and the result recolored."
msgstr ""

#. TRANSLATORS: Property: piece_name
#. Property: name
#: art/pieces/piece_yagyou_raijuu.tres
#: stage/hauntings/types/raijuu/haunting_raijuu.tres
msgid "Raijū"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yagyou_raijuu.tres
msgid "Depicts a yōkai of unclear identity. It may be a raijū (\"thunder beast\"), a beast which is usually docile but becomes ferocious and wrapped in lightning when storms arrive. They are companions of Raijin, the Shinto god of lightning."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yokai_kappa.tres
msgid "Kappa and Friends"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yokai_kappa.tres
msgid "The background was edited out and only the kappa was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yokai_kappa.tres
msgid ""
"Depicts several yōkai including a Kappa (\"river child\"), one of the most well-known yōkai. It is said to be an amphibian, about the size of a child, living in the lakes and rivers of Japan.\n"
"\n"
"The kappa has webbed feet and hands, scaly or slippery skin, often with a turtle-like shell on its back. Most depictions of kappa have a dish-like structure on the top of their head, filled with some kind of liquid. Kappa enjoy sumo wrestling, eating cucumbers, and causing trouble in various ways.\n"
"\n"
"This image is part of a yōkai scroll of unknown authorship from the late Edo period, linked above."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_above_the_cloud.tres
msgid "Above the Cloud"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_above_the_cloud.tres
msgid "Depicts a sea of clouds viewed from one of the peaks in the Southern Japanese Alps."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_camping.tres
msgid "Bivouac: Mount Kitadake and Mount Ainodake"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshida_camping.tres
msgid "Three of the people, as well as the ropes were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_camping.tres
msgid ""
"Depicts a group of mountaineers resting at a campsite overlooking Mount Kitadake and Mount Ainodake in the Japanese alps.\n"
"\n"
"Yoshida was an avid mountaineer, and many of his prints depict sights from his expeditions."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_deer.tres
msgid "Deer in Kasuga"
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_ellara.tres
msgid "Third Cave Temple in Ellora"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshida_ellara.tres
msgid "The image was cropped and recolored."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_ellara.tres
msgid ""
"Depicts visitors walking through one of the caves of the [url=https://en.wikipedia.org/wiki/Ellora_Caves]Ellora Temple complex[/url], in Maharashtra, India.\n"
"\n"
"The temple complex includes Hindu, Buddhist, and Jain rock-cut temples dating from the 7th to the 11th century.\n"
"\n"
"This particular cave features a square hall, a central back shrine with a seated Buddha, and residential cells for monks."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_gingko.tres
msgid "Ginkgo in Autumn"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_gingko.tres
msgid ""
"Depicts a covered viewing platform in Hiroshi Yoshida's house in Nakazato.\n"
"\n"
"The boy is his son Toshi who is playing with his dog Tarō. Toshi continued his father's legacy as a printmaker."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_himeji_castle.tres
msgid "Himeji Castle, Morning"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshida_himeji_castle.tres
msgid "The castle was leaned, the image was recolored, and the text was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_himeji_castle.tres
msgid "Depicts the Himeji Castle, in Hyōgo prefecture. The castle still stands, and is one of Japan's most visited tourist destinations. An evening version of this print also exists."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_kurobe_river.tres
msgid "Kurobe River"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_kurobe_river.tres
msgid ""
"Depicts the Kurobe river running through the Kurobe Gorge in the Hida Mountains in Toyama prefecture. The river notable for its steepness and speed.\n"
"\n"
"Part of a series called Twelve Scenes of the Japanese Alps."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_nigatsudo_temple.tres
msgid "Nigatsudo Temple"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_nigatsudo_temple.tres
msgid "Pilgrims are taking a rest in the Nigatsudo Temple in Nara prefecture."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_nikko.tres
msgid "A Misty Day in Nikkō"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_nikko.tres
msgid "Three pilgrims are taking a rest under a huge cedar tree."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_sphinx.tres
msgid "The Sphinx by Day"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshida_sphinx.tres
msgid "Only the background was cut out and used in a composition."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_sphinx.tres
msgid "The head of the Sphinx, outside Cairo, Egypt, before it had been fully excavated. A group of locals and tourists are progressing across the desert on camels and mules. A night version of the same print also exists."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshida_stupa.tres
msgid "A Gate to the Stupa of Sanchi"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshida_stupa.tres
msgid "Only the gate was cut out, simplified, and used in a composition."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshida_stupa.tres
msgid "Depicts the gate to the Buddhist stupa in Sanchi, India, built in the 3rd century BCE. The monument still stands."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshimune_temple_visit.tres
msgid "Visiting a Temple"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshimune_temple_visit.tres
msgid "The text overlay was removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshimune_temple_visit.tres
msgid "Depicts ladies and an attendant visiting a temple in the early spring."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_amaterasu.tres
msgid "Dancing for the Sun Goddess"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshitoshi_amaterasu.tres
msgid "The triptych was stitched."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_amaterasu.tres
msgid ""
"Depicts an attempt to lure the sun goddess, Amaterasu Ōmikami, the chief deity of the Shinto pantheon, from her hiding place in a mountain cave, where she had retreated following an argument with her brother, the storm god.\n"
"\n"
"In the center, the goddess of Dawn, Ame no Uzume, dances, accompanied by musicians beating a large drum, and a group of praying monks. Ame-no-Tajikarao, the god of strength, rolls out the rock blocking the cave entrance, while the leader of earthly deities, Sarutahiko-ōkami, looks on from the right side of the print.\n"
"\n"
"After hearing the noise, Amaterasu opens the door of the cave a crack, letting out a sunbeam. With the cave open, the other deities could persuade her to come out and shine on the world again."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_guns.tres
msgid "Chōsokabe Attacks Hori's Encampment at Night"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_guns.tres
msgid ""
"This print claims to depict a night raid from the [url=https://en.wikipedia.org/wiki/Invasion_of_Shikoku_(1585)]Shikoku Campaign of 1585[/url], where the [url=https://en.wikipedia.org/wiki/Ch%C5%8Dsokabe_clan]Chōsokabe clan[/url] attacked the camp of [url=https://en.wikipedia.org/wiki/Hori_Hidemasa]Hori Hidemasa[/url].\n"
"\n"
"It doesn't take an expert to recognize that the weaponry is unrealistic for a 16th-century battle. Due to the shogunate's strict publishing regulations during Yoshitoshi's time, publication of prints dealing with current events was strictly prohibited, so artists adopted the format of depicting contemporary events thinly disguised as historical scenes. One source claims that this image was in reality intended to depict the [url=https://en.wikipedia.org/wiki/Second_Ch%C5%8Dsh%C5%AB_expedition]Second Chōshū Expedition[/url] of 1866."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_housougami.tres
msgid "Tametomo Scares Away Smallpox Demons"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshitoshi_housougami.tres
msgid "The background was removed and the rash was exaggerated."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_housougami.tres
msgid "The ferocity of Minamoto no Tametomo (1139-70) scares away a pair of smallpox demons."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_newspaper.tres
msgid "Old Man Nishimura Seated and Holding the Hochi Newspaper"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshitoshi_newspaper.tres
msgid "Only the newspaper was used."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_newspaper.tres
msgid ""
"Depicts an old man holding a newspaper frowning at a peddler. The text above relates the story:\n"
"\n"
"[i]A man calling himself the messenger of the Tengu of Mount Nikkō arrived at the house of Nishimura, a man famous for his \"high nose\" (pride and confidence).\n"
"\n"
"The peddler took out several statues of Daikoku (one of Japan's Seven Lucky Gods) and said \"My master was moved by your faith, and sent me to grant you boundless fortune, longevity, and perfect harmony.\"\n"
"\n"
"The old man did not fall for the trap and responded: \"I am a Great Tengu among merchants! A Leaf-Tengu like you is a fellow who wouldn't even be seen at the very lowest seat of my followers! Leave! Withdraw while your footing is still clear, or I'll teach you a lesson!\"\n"
"\n"
"Glaring fiercely upwards over his glasses, the light in his eyes made the imposter tremble in fear and flee.\n"
"\n"
"So it is told, this took place around the autumn of Meiji 7 (1874).\n"
"\n"
"Recorded by Kishū Gyojin.[/i]\n"
"\n"
"The Tengu mentioned are yōkai famous for having long noses, and the \"high nose\" of the old man is a pun on this. The Leaf-Tengu is a lower-ranking subtype of this species."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_priest_raigo.tres
msgid "Priest Raigo of Miidera"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_priest_raigo.tres
msgid "Depicts the priest Raigo, who starved himself to death in anger at Emperor Shirakawa for refusing to grant a request of his, only to be reborn as a rat spirit, seen here systematically destroying the Emperor's sacred library."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitoshi_tsunade.tres
msgid "The Brave Woman Tsunade"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshitoshi_tsunade.tres
msgid "The dagger and the text overlay were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitoshi_tsunade.tres
msgid ""
"Depicts the fictional ninja [url=https://en.wikipedia.org/wiki/Tsunade]Tsunade[/url] holding a dagger, standing her ground against an enormous, hissing serpent coiled around a standing screen.\n"
"\n"
"Tsunade is from the [url=https://en.wikipedia.org/wiki/Jiraiya]Jiraiya Gōketsu Monogatari[/url] (The Tale of the Gallant Jiraiya). She is the wife of Jiraiya, a legendary ninja who commands giant frogs, and she herself uses snail-related magic."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yoshitsugu_shikan.tres
msgid "Ōsaka Print of Nakamura Shikan II in Cave"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yoshitsugu_shikan.tres
msgid "The weapons and text overlays were removed."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yoshitsugu_shikan.tres
msgid "Depicts the Ōsaka kabuki actor Nakamura Shikan II. It is unknown what play this is related to, but it was likely used as a kabuki advertisement."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_yuhan_sugi.tres
msgid "Cryptomeria Avenue in Nikkō"
msgstr ""

#. TRANSLATORS: Property: edits_description
#: art/pieces/piece_yuhan_sugi.tres
msgid "The road was replaced by a furrow, and the people and buildings in the background were edited out. Additional versions add layers on top of this."
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_yuhan_sugi.tres
msgid "The dappled sunlight casts pools of sunspots through the dense canopy of ancient cedar trees in the famous Nikko Cedar Avenue, the longest tree-lined road in the world, with 12,000 cedars still there today."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_zaisei_cranes.tres
msgid "Thousand Cranes and Rising Sun"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_zaisei_cranes.tres
msgid "Depicts a flock of over 100 red-crowned cranes gathering beneath a red sun. This is not an ukiyo-e print, but rather a painted silk hanging scroll."
msgstr ""

#. TRANSLATORS: Property: piece_name
#: art/pieces/piece_zeshin_old_man_and_dog.tres
msgid "Old Man and Dog"
msgstr ""

#. TRANSLATORS: Property: blurb
#: art/pieces/piece_zeshin_old_man_and_dog.tres
msgid "A blind old man loses his balance as his sandal slips off. A dog barks at him."
msgstr ""

