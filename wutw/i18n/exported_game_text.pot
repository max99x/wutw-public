msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_2_goats_on_the_wall.tres
msgid "Goats on the Wall"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_2_goats_on_the_wall.tres
msgid "The goats do not wonder if the cliffs will hold them. They step, and the cliffs obey."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_2_gorge_waystation.tres
msgid "Gorge Waystation"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_2_gorge_waystation.tres
msgid "A tea house on one side of the gorge, and an inn on the other, helping motivate folks to brave the bridge."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_2_moss_ball_nursery.tres
msgid "Moss Ball Nursery"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_2_moss_ball_nursery.tres
msgid "Each ball a miniature garden to carry on your travels."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_2_vine_lattice.tres
msgid "Vine Lattice"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_2_vine_lattice.tres
msgid "These vines easily hold anyone's weight. Usually. That is the whole thrill of it."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_2_wandering_script.tres
msgid "Wandering Script"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_2_wandering_script.tres
msgid "Words appear, carved into the stone, but only if no one is looking."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/canyon/upgrade_canyon_3_hanging_monastery.tres
msgid "Hanging Monastery"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_3_hanging_monastery.tres
msgid "A massive building perched on a wooden platform and chained to the wall, creaking with every step the monks take."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/canyon/upgrade_canyon_3_rocks_reply.tres
msgid "A question left at dusk may have an answer by sunrise, but the canyon does not like an audience."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/spot_cliff.tres
msgid "Rocky Cliff"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/spot_cliff.tres
msgid "A sheer rock wall challenges passersby to brave its cliffs or burrow through its crevices."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_1_cave_shelter.tres
msgid "Cave Shelter"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_1_cave_shelter.tres
msgid "Perhaps the remnant of an Old World mine, or an ancient bear's burrow. Today all it can do is keep a traveler safe from the rain."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_1_nest.tres
msgid "Bird Nesting Cliff"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_1_nest.tres
msgid "The eggs cradled in these downy nests are safe from the foxes and snakes below."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_1_rock_mine.tres
msgid "Granite Quarry"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_1_rock_mine.tres
msgid "Picks ring out against crevices, intent on turning the ancient cliff into stones for new homes."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_2_climb.tres
msgid "Climbing Trial"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_2_climb.tres
msgid "Old ropes hang from pegs pounded into the rock. An invitation to test one's mettle."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_2_echo_cave.tres
msgid "Stalactite Cavern"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_2_echo_cave.tres
msgid "Stalactites grip the ceiling deep within the cavern, echoing a thousand tiny waterdrops."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_2_silver_mine.tres
msgid "Silver Mine"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_2_silver_mine.tres
msgid "Silver seams shimmer with the promise of rings and necklaces to invite envy."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_2_waterfall.tres
msgid "Waterfall Veil"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_2_waterfall.tres
msgid "A tiny spring on top of the cliff descends down the slopes in a splash of shiny mist."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_3_petroglyph_cave.tres
msgid "Petroglyph Cave"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_3_petroglyph_cave.tres
msgid "Messages from the Old World cover the walls, though few are left today who could decipher their meaning."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/cliff/upgrade_cliff_3_song_waterfall.tres
msgid "Singing Cascade"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_3_song_waterfall.tres
msgid "A torrent of glimmering water drums an ever-changing beat as it tumbles over the cliff's countless ledges."
msgstr ""

#. TRANSLATORS: Property: name
#. Property: text
#: stage/spots/cliff/upgrade_cliff_3_stair.tres
#: stage/spots/spot_recipe.tscn
msgid "Skybound Stair"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/cliff/upgrade_cliff_3_stair.tres
msgid "These steps look like they have been carved for, or perhaps by, giants, yet most can climb them with enough effort."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/spot_desert.tres
msgid "This expanse of sand may look barren, but those who learn to survive here are generously rewarded."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_1_cactus_forest.tres
msgid "Cactus Forest"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_1_cactus_forest.tres
msgid "These water tanks are kept safe by a cloak of thorns."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_1_oasis_spring.tres
msgid "Oasis Spring"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_1_oasis_spring.tres
msgid "Water in the desert is often either a trap or a trick of the eyes. This one, however, is genuine."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_1_underground_storehouse.tres
msgid "Underground Storehouse"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_1_underground_storehouse.tres
msgid "Cool, dark, and full of things someone meant to come back for."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_camel_grazing_spot.tres
msgid "Camel Grazing Spot"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_camel_grazing_spot.tres
msgid "A meeting place for those with thick skins and bad tempers. The camels are here too."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_caravanserai.tres
msgid "Caravanserai"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_caravanserai.tres
msgid "A place to rest your feet, fill your cup, and share your burdens with fellow travelers."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_cassava_farm.tres
msgid "Cassava Farm"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_cassava_farm.tres
msgid "These hardy tubers make for hearty meals, and don't mind the sand at all."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_date_palm_grove.tres
msgid "Date Palm Grove"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_date_palm_grove.tres
msgid "The palms are strung with garlands of sweet fruit, a perfect fuel for long treks among the dunes."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_millet_farm.tres
msgid "Millet Farm"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_millet_farm.tres
msgid "Where rice and wheat are but a memory, millet shines, ready to fill bowls within months of planting."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_mirage_gate.tres
msgid "If you look out of the corner of your eye, you can catch a glimpse of spires rising into a vast blue sky just beyond this gate."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_2_subterranean_archive.tres
msgid "Subterranean Archive"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_2_subterranean_archive.tres
msgid "Scrolls and tablets have lain safe under these sands for centuries, and may be preserved for centuries more."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_3_blooming_dunes.tres
msgid "Blooming Dunes"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_3_blooming_dunes.tres
msgid "Blink and you'll miss it: the sand erupting in flowers, a miracle gone by morning."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_3_grand_bazaar.tres
msgid "Grand Bazaar"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_3_grand_bazaar.tres
msgid "Whether silk, spice, or wisdom, everything can be found here, and often at a bargain price."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/desert/upgrade_desert_3_vanishing_city.tres
msgid "Vanishing City"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/desert/upgrade_desert_3_vanishing_city.tres
msgid "Once upon a blue moon this gateway appears to lead to a city spoken of in legends, but no one who has stepped through has ever returned."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/spot_forest.tres
msgid "The life of the shard beats close to the surface here, anchored by giants that might have stood long before the Shattering."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_1_forage.tres
msgid "Foraging Glade"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_1_forage.tres
msgid "Thickets full of juicy berries and delicious mushrooms fill empty hands and hungry bellies."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_1_shrine.tres
msgid "Hidden Shrine"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_1_shrine.tres
msgid "The statue of a long-forgotten deity is hidden behind a moss-clad torii gate nestled among the greenery."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_1_woodcutter.tres
msgid "Woodcutter's Camp"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_1_woodcutter.tres
msgid "Dry stumps dot the clearing, each a mute witness to a tree's reluctant farewell."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_2_fruit_grove.tres
msgid "Fruit Grove"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_2_fruit_grove.tres
msgid "Plums and persimmons weigh down these hard-working branches, eager to find their way into a dinner bowl or a pickle jar."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_2_hermit.tres
msgid "Hermit's Hut"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_2_hermit.tres
msgid "A lone recluse has built a hut here to care for this ancient shrine, and read prophecies into birdcalls."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_2_logging_mill.tres
msgid "Lumber Yard"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_2_logging_mill.tres
msgid "Trees are cut and sawn here to fit the humans' vision of order."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_2_wildlife_sanctuary.tres
msgid "Wildlife Sanctuary"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_2_wildlife_sanctuary.tres
msgid "A place where the wild beasts outnumber the words scholars have for naming them."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_3_labyrinth.tres
msgid "Verdant Labyrinth"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_3_labyrinth.tres
msgid "The entwined canopies of these ancient trees have turned this part of the forest into a maze of twisty little passages, all alike."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_3_monastery.tres
msgid "Forest Monastery"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_3_monastery.tres
msgid "Turns out the plural of \"recluse\" is \"monastery\". These folks have left the divine texts behind, and meditate instead on the never-ending rustle of the leaves."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/forest/upgrade_forest_3_old_glade.tres
msgid "Eternal Glade"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/forest/upgrade_forest_3_old_glade.tres
msgid "Under the soaring cedars of this hallowed hollow, every breath tastes of deep woods."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/spot_hill.tres
msgid "Hill"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/spot_hill.tres
msgid "The breeze moves more freely up here, carrying the fragrance of damp earth and the promise of a better view."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_1_bamboo_grove.tres
msgid "Bamboo Grove"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_1_bamboo_grove.tres
msgid "The wind hums through the stalks, gossiping with the leaves."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_1_signal_beacon.tres
msgid "Signal Beacon"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_1_signal_beacon.tres
msgid "A bonfire on a pole, enough to alert far-off settlements in an emergency."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_1_stone_quarry.tres
msgid "Stone Quarry"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_1_stone_quarry.tres
msgid "Pieces of the hill are chipped off and carted away to even out the landscape."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_2_masonry_yard.tres
msgid "Masonry Yard"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_2_masonry_yard.tres
msgid "Stones of all shapes and sizes are taught here to fit in and avoid standing out."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_2_messenger_tower.tres
msgid "Messenger Tower"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_2_messenger_tower.tres
msgid "Homing pigeons nesting here like to carry messages to scouting parties and even nearby settlements."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_2_rice_terrace.tres
msgid "Rice Terrace"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_2_rice_terrace.tres
msgid "A series of steps carved into the hill, flooded to keep the thirsty stalks well quenched."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_2_tea_terrace.tres
msgid "Tea Terrace"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_2_tea_terrace.tres
msgid "Long before these leaves meet a cup, they spend their youth looking down from the ledges."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_2_windmill.tres
msgid "Windmill"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_2_windmill.tres
msgid "An invention of the New World, harnessing the air itself to turn hard grain into precious powder."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_3_falconer_spire.tres
msgid "Falconer's Spire"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_3_falconer_spire.tres
msgid "When pigeons lack range, folks call on companion falcons, resolute enough to carry messages across the Cloud Sea to other shards."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_3_rice_drying_racks.tres
msgid "Rice Drying Racks"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_3_rice_drying_racks.tres
msgid "One more stop before the grain meets the millstone, weather permitting."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/hill/upgrade_hill_3_teahouse_pavilion.tres
msgid "Tea Pavilion"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/hill/upgrade_hill_3_teahouse_pavilion.tres
msgid "A gathering for those who like to share a drink while pointing out landmarks on the horizon."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/spot_lake.tres
msgid "Lake"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/spot_lake.tres
msgid "This still lake fits the sky as easily as it fits the rain. A fine place for reflection."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_1_ferry_crossing.tres
msgid "Ferry Crossing"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_1_ferry_crossing.tres
msgid "It takes about as long to cross as walking around the lake, but your feet will thank you."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_1_hemp_retting_pond.tres
msgid "Hemp Retting Station"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_1_hemp_retting_pond.tres
msgid "The lake chews the hemp, spitting out the fiber. Weavers claim it's worth the smell."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_1_lotus_pond.tres
msgid "Lotus Pond"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_1_lotus_pond.tres
msgid "Watching these blossoms unfold is a fine excuse to delay starting work in the morning."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_2_cloth_rinsing_station.tres
msgid "Cloth Rinsing Station"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_2_cloth_rinsing_station.tres
msgid "Dyed fabrics flutter beneath the water, giving the fish something to wonder at."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_2_floating_market.tres
msgid "Floating Market"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_2_floating_market.tres
msgid "The boats drift with the waves, much like prices when a merchant sees a heavy coin purse."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_2_indigo_fermentation_beds.tres
msgid "Indigo Fermentation Beds"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_2_indigo_fermentation_beds.tres
msgid "Indigo leaves travel here from the Shrublands to begin the long wait to meet the cloth."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_2_island_shrine.tres
msgid "Island Shrine"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_2_island_shrine.tres
msgid "The shrine offers no wisdom, but sharing your thoughts with your own reflection often does."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_2_lotus_silk_farm.tres
msgid "Lotus Silk Farm"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_2_lotus_silk_farm.tres
msgid "It takes ten thousand stems to make a shirt, so the fabric made here is reserved for only the most sacred of occasions."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_3_boat_festival.tres
msgid "Oars splash, sails billow, and the air is thick with merriment, with the occasional panicked yell from an unsteady boat."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/lake/upgrade_lake_3_master_dyer_workshop.tres
msgid "Master Dyer's Workshop"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/lake/upgrade_lake_3_master_dyer_workshop.tres
msgid "The traditional indigo is joined here by crimson, safflower, and dyes of every shade."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/spot_mountain.tres
msgid "These magnificent peaks and solitary valleys welcome daredevils and hermits alike."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_1_smoldering_crater.tres
msgid "Smoldering Crater"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_1_smoldering_crater.tres
msgid "The shard's molten core breaches the surface at the tip of this mountain, letting out a sigh of relief."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_1_snowmelt_springs.tres
msgid "Snowcapped Peaks"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_1_snowmelt_springs.tres
msgid "The mountain wears a crown of ice, watering the valleys with its melting jewels."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_1_winding_path.tres
msgid "Winding Path"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_1_winding_path.tres
msgid "Not exactly a road, but it beats scrambling over the rocks."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_ember_monastery.tres
msgid "Ember Monastery"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_ember_monastery.tres
msgid "Burning coals are no challenge for the tough soles of the peculiar priests living here."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_ice_caves.tres
msgid "Ice Caves"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_ice_caves.tres
msgid "Crystal tunnels of frozen blue. They never look the same on repeat visits."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_lava_fed_forges.tres
msgid "Lava-Fed Forges"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_lava_fed_forges.tres
msgid "Metal melts like wax in the lava flowing down these slopes."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_natural_hot_spring.tres
msgid "Natural Hot Springs"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_natural_hot_spring.tres
msgid "You won't need a cauldron or a fire to take a hot bath in this spring. The mountain takes care of that."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_sky_ropeways.tres
msgid "Sky Ropeways"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_sky_ropeways.tres
msgid "An ingenious system of pulleys and gears powers these skybound palanquins."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_2_verdant_hollow.tres
msgid "Verdant Hollow"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_2_verdant_hollow.tres
msgid "Greenery nestled among the rocks, all the more precious for the challenges it had to overcome."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_3_dragon_roost.tres
msgid "The Dragon's Rest"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_3_dragon_roost.tres
msgid "Old World legends speak of great dragons resting within such fiery peaks, though recent sightings are lacking."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/mountain/upgrade_mountain_3_onsen_retreat.tres
msgid "Onsen Retreat"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/mountain/upgrade_mountain_3_onsen_retreat.tres
msgid "Add a few trees and a little shack to turn the humble spring into a resort."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/spot_plains.tres
msgid "A blank canvas fit for a vibrant new scene. What it lacks in excitement is made up for by its stability."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_1_farm.tres
msgid "The dream of soba noodle bowls is alive in this field."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_1_rest_stop.tres
msgid "Pilgrim's Rest"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_1_rest_stop.tres
msgid "A stone slab meets soft grass to offer wanderers a shaded break."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_1_wildflower_field.tres
msgid "A riot of blossoms insists on claiming every inch of grass, leaving insects no excuse to nap."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_apiary.tres
msgid "Apiary"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_apiary.tres
msgid "Hives hum within hollow stumps, patiently nurtured by oddly dressed caretakers."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_firebreak_reservoir.tres
msgid "Firebreak Reservoir"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_firebreak_reservoir.tres
msgid "Just a pit full of water, in case of fire. Works better than prayers."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_herb_garden.tres
msgid "Herb Garden"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_herb_garden.tres
msgid "A flower to help with headaches, an herb to ease the pain, and a dozen other plants grow behind the herbalist's shack."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_kudzu_plantation.tres
msgid "Kudzu Plantation"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_kudzu_plantation.tres
msgid "The roots yield sweet starch and the vines weave strong cloth. But anything standing still risks becoming part of the trellis."
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_road.tres
msgid "A ribbon of hardened earth smoothed by feet unwilling to weave through the grass."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_sacred_grove.tres
msgid "Sacred Grove"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_sacred_grove.tres
msgid "Seeds saved from the Old World are planted here to grow into great trees. Superior to local flora, or so the priests claim."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_2_storyteller_camp.tres
msgid "Storyteller Camp"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_2_storyteller_camp.tres
msgid "Roving bards and koto players gather around this cozy fire to share warmth and swap stories."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/plains/upgrade_plains_3_endless_blossoms.tres
msgid "Endless Blossoms"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/plains/upgrade_plains_3_endless_blossoms.tres
