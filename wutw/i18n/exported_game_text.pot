#: stage/spots/building_large/upgrade_building_large_2_town_hall.tres
msgid "Assembly Hall"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/building_large/upgrade_building_large_2_town_hall.tres
msgid "The wisdom or folly proclaimed in this room will echo far across the shard."
msgstr ""

