msgid "Common Dining Hall"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/building_large/upgrade_building_large_1_dining_hall.tres
msgid "Nothing eases the labor of building a new home like a warm meal shared."
msgstr ""

