#: stage/spots/brushland/upgrade_brushland_2_thatching_yard.tres
msgid "Thatching Yard"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_2_thatching_yard.tres
msgid "Straw will keep out rain, wind, and prying eyes, but rarely mice. Mice go where they please."
msgstr ""

