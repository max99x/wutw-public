#: stage/spots/brushland/upgrade_brushland_2_paper_mulberry_grove.tres
msgid "Paper Mulberry Grove"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_2_paper_mulberry_grove.tres
msgid "Once the pulp is pounded and strained, it will be ready to record the lives led in this dry land."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/brushland/upgrade_brushland_2_rabbit_warren.tres
msgid "Rabbit Warren"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_2_rabbit_warren.tres
msgid "Soft paws dig mazes through the earth, hidden just beneath our feet."
msgstr ""

