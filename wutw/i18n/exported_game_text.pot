#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_antique_collector.tres
msgid "I am a scholar on a quest for ancient artifacts. Folks keep bringing me modern devices trying to impress me, but I am sure the ancients had much more impressive mechanisms."
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_antique_collector.tres
msgid "Reduce <term_lower:card_rarity_tier> by 25%."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_antique_collector.tres
msgid "Get 2 extra options whenever you get a <term:relic> choice."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_antique_collector.tres
msgid "From now on, get 2 extra options whenever you get a <term:relic> choice."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_antique_collector.tres
msgid "An Antique Collector"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_ascetic.tres
msgid "I have spent my life living among people, and I grow weary of the excesses of civilization. It is time for me to take up the mossy robes and retire into the wilderness."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_ascetic.tres
msgid "An Ascetic"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_clumsy_scholar.tres
msgid "I've always wanted to found a library, but every time I try to join an expedition, they say there's no space because I can't fit all my books and scrolls into a single bag. I can't just leave them behind!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_clumsy_scholar.tres
msgid "A Clumsy Librarian"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_daredevil.tres
msgid "My old shard is so boring. They just eat, work, and sleep. I want to settle on a shard full of mysteries and adventure!"
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_daredevil.tres
msgid "Increases <term_lower:haunting> probability by 10%."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_daredevil.tres
msgid "Increase the <term_lower:card_rarity_tier> of <term_lower:glyph> rewards by 10%."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_daredevil.tres
msgid "Increased the <term_lower:card_rarity_tier> of <term_lower:glyph> rewards by 10%."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_daredevil.tres
msgid "A Daredevil"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_diligent_surveyor.tres
msgid "My shard has perfected the art of safe exploration. We always pack extra supplies and take our time to plan out every step. I'm looking to teach other surveyors these skills."
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_diligent_surveyor.tres
msgid "<term:survey> <term_lower:task>s have extra <term_lower:aspect_slot>s."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_diligent_surveyor.tres
msgid "A Diligent Surveyor"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_dragon_scale.tres
msgid "No one believes that my collection of dragon scales is real. I must find a dragon's lair and prove them all wrong! I've read that dragons used to live inside volcanoes, deep in the vents..."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_dragon_scale.tres
msgid "A Dragon Enthusiast"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_enterprising_trader.tres
msgid "I come from a small shard where we import most of our goods, but I dream of creating a trading empire that connects large cities all throughout a shard. It will be my life's work!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_enterprising_trader.tres
msgid "An Enterprising Trader"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_former_monk.tres
msgid "The abbot at my former monastery is... not a good person. I've had enough of this! It is time for me to return to the lay life. I want to see the world outside the lonely mountain peaks!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_former_monk.tres
msgid "Leaving the Order"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_grumpy_scout.tres
msgid "My old scouting team fired me. Can you believe them? \"Lowers team morale,\" they said. It's not my fault that bad things are bound to happen. I just don't sugarcoat it."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_grumpy_scout.tres
msgid "A Grumpy Scout"
msgstr ""

#. TRANSLATORS: Property: intro_text
#. Property: text
#: quests/settler/quests/quest_settler_hanami.tres
#: quests/settler/settler_quest_description.tscn
msgid "I come from a desert shard, and I've always wanted to live by a river. I want to spend my days listening to the rustling of the stream and having picnics beneath the sakura trees."
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_hanami.tres
msgid "Event <term_lower:bonus> requirements are increased by 10%."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_hanami.tres
msgid "A Sakura Dream"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_healer.tres
msgid "My home shard has been hit by an epidemic, and I am exploring the shards in search of a solution. I am infected myself, but once I find a cure, I will be able to help people throughout the Cloud Sea!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_healer.tres
msgid "A Traveling Healer"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_hoarder.tres
msgid "People throw away the most useful things. I can't take it. I need a place to store all my collections. They must be kept safe for generations to come!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_hoarder.tres
msgid "A Hoarder"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_novelty_seeker.tres
msgid "I'm tired of the same old sights. I need more novelty in my life. Romance! Adventure! Questionable behavior!"
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_novelty_seeker.tres
msgid "A Novelty Seeker"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_perfectionist.tres
msgid "So many people are content to accept average work, but not me! Everything I do has to be immaculate. I'll replan and replan again until I can get the perfect result. I'm looking to join an expedition with like-minded individuals."
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_perfectionist.tres
msgid "<term:event> choices with <term_lower:aspect> requirements require 1 more."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_perfectionist.tres
msgid "Allows you to reshuffle your <term_lower:card_deck> and draw a new starting <term_lower:hand> 2 more times."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_perfectionist.tres
msgid "You can now reshuffle your <term_lower:card_deck> and draw a new starting <term_lower:hand> 2 more times during this <term_lower:run>."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_perfectionist.tres
msgid "A Perfectionist"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_planner.tres
msgid "I am developing a revolutionary city planning technique. It will allow us to plan exactly how to order our tasks for maximum efficiency, as long as no one tries to guess. I still need a few more cities to perfect it though."
msgstr ""

#. TRANSLATORS: Property: description
#: quests/settler/quests/quest_settler_planner.tres
msgid "<term:card_ability.divine> <term_lower:card_ability>s do not work."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_planner.tres
msgid "The <term:draw_pile> will appear in draw order."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_planner.tres
msgid "The <term:draw_pile> will now appear in draw order."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_planner.tres
msgid "A Meticulous Planner"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_publisher.tres
msgid "The artists in my employ keep letting other studios use their designs. How is an honest publisher supposed to make a living in such conditions? I am moving my studio to a new shard, where artists will not be allowed to copy others' work."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_publisher.tres
msgid "A Woodblock Print Publisher"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_rabbit_family.tres
msgid "I have a couple of rabbit companions, but their family is growing too fast for me to handle. I'm looking for a shard to rehome them."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_rabbit_family.tres
msgid "Get one more <term:glyph> reward at the end of each <term:foray>."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_rabbit_family.tres
msgid "Added one more <term:glyph> reward at the end of each <term:foray>."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_rabbit_family.tres
msgid "A Rabbit Family"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_safety_warden.tres
msgid "It is a custom on my shard to volunteer with an expedition at least once in one's lifetime. As a safety warden, it will be my duty to keep people safe."
msgstr ""

#. TRANSLATORS: Property: preview_description
#. Property: default_description
#: quests/settler/quests/quest_settler_safety_warden.tres
#: relics/common/incense_pellet/relic_incense_pellet.tres
msgid "Block the first time each <term_lower:haunting> triggers during each stage. Can stack."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_safety_warden.tres
msgid "From now on, block the first time each <term_lower:haunting> triggers during each stage. Can stack."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_safety_warden.tres
msgid "A Safety Warden"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_sick_elder.tres
msgid "The years have caught up with me. My joints are swollen now, and it's time to put my days of traveling behind. I need to settle down on a shard with proper healers to care for me in my old age."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_sick_elder.tres
msgid "Gain 5 maximum inspiration."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_sick_elder.tres
msgid "Gained 5 maximum inspiration."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_sick_elder.tres
msgid "A Sick Elder"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_talisman_bead.tres
msgid "The Ember Order has sent me to establish a chapter on a new shard. I have many fellow monks and nuns with me, though, so we will need two monasteries to fit us all."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_talisman_bead.tres
msgid "A Chapter of the Ember Order"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_talisman_ring.tres
msgid "The Shattered Order has sent me to establish a chapter on a new shard. We are an order of scholars, so we will need archives of pre-Shattering texts to study, and a ready supply of paper to publish our detailed commentaries."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_talisman_ring.tres
msgid "A Chapter of the Shattered Order"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_talisman_scent_bag.tres
msgid "The Order of the Wilds has sent me to establish a chapter on a new shard. We channel the Enlightened One's will by meditating on the scents of the wilderness, so we must settle away from the foul air of large cities."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_talisman_scent_bag.tres
msgid "A Chapter of the Order of the Wilds"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_talisman_seed_pouch.tres
msgid "The Order of Growth has sent me to establish a chapter on a new shard. My branch of our order is tasked with maintaining the forests, so we will need a well-forested shard."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_talisman_seed_pouch.tres
msgid "A Chapter of the Order of Growth"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_tipsy_musician.tres
msgid "My home shard has instituted an alcohol ban so now I have no parties to play at. I'm looking for a shard where people actually know how to have fun."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_tipsy_musician.tres
msgid "Restore 2 points of <term:inspiration> after each <term:foray>."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_tipsy_musician.tres
msgid "From now on, restore 2 points of <term:inspiration> after each <term:foray>."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_tipsy_musician.tres
msgid "A Tipsy Musician"
msgstr ""

#. TRANSLATORS: Property: intro_text
#: quests/settler/quests/quest_settler_traditionalist.tres
msgid "Folks nowadays don't respect their elders. All they care about is so-called progress. Well, progress is what shattered our world in the first place! I am moving to a shard which knows to honor its traditions."
msgstr ""

#. TRANSLATORS: Property: preview_description
#: quests/settler/quests/quest_settler_traditionalist.tres
msgid "Whenever you lose <term:inspiration>, lose 3 less."
msgstr ""

#. TRANSLATORS: Property: outcome_description
#: quests/settler/quests/quest_settler_traditionalist.tres
msgid "From now on, whenever you lose <term:inspiration>, lose 3 less."
msgstr ""

#. TRANSLATORS: Property: name
#: quests/settler/quests/quest_settler_traditionalist.tres
msgid "A Traditionalist"
