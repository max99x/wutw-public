msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/seashore/upgrade_seashore_3_shimmering_reef.tres
msgid "Turtles amble about and fish dart among the corals, eager to escape a plunging beak."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/seashore/upgrade_seashore_3_ships_at_sea.tres
