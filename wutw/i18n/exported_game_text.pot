msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/seashore/upgrade_seashore_3_ships_at_sea.tres
msgid "Masts crowd the horizon, carrying the promise of distant shores."
msgstr ""

#. TRANSLATORS: Property: name
#: stage/spots/seashore/upgrade_seashore_3_shipwreck_shrine.tres
