#: stage/spots/building_large/upgrade_building_large_2_hospital.tres
msgid "House of Healing"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/building_large/upgrade_building_large_2_hospital.tres
msgid "Stubborn patients grumble as they are forced to rest, yet nothing eases their pain as well as the masters of this house."
