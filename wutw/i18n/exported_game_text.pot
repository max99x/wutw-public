#: stage/spots/brushland/upgrade_brushland_2_incense_workshop.tres
msgid "Incense Workshop"
msgstr ""

#. TRANSLATORS: Property: description
#: stage/spots/brushland/upgrade_brushland_2_incense_workshop.tres
msgid "The scents crafted here carry the spirits of the wilds into every home."
msgstr ""

