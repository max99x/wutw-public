[memory]

limits/message_queue/max_size_mb=512

[rendering]

textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"
rendering_device/driver.macos="vulkan"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
2d/sdf/scale=0

[steam]

initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
updates/godotsteam/check_for_updates=false
initialization/app_id=0
initialization/initialize_on_startup=false

[wwise]

common_user_settings/root_output_path="res://audio/generated_sound_banks"
project_settings/windows_platform_info="res://Wwise/resources/Windows.tres"
project_settings/linux_platform_info="res://Wwise/resources/Linux.tres"
project_settings/mac_platform_info="res://Wwise/resources/Mac.tres"
