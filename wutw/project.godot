; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
script_name_on_top/hide_scripts_panel=false
script_name_on_top/hide_bottom_bar=false
script_name_on_top/show_bottom_bar_on_warning=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Worlds Upon The Wind"
config/description="A roguelite game about rebuilding a shattered world."
config/version="1.2"
run/main_scene="uid://b1hgfs2l3hume"
config/use_custom_user_dir=true
config/custom_user_dir_name="Worlds Upon The Wind"
config/project_settings_override="user://custom_settings_v2.cfg"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
run/max_fps=59
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=2
boot_splash/image="uid://bhomt4yqtpf4g"
config/icon="uid://dt3ks28tcf08m"

[autoload]

WwiseRuntimeManager="*res://addons/Wwise/runtime/wwise_runtime_manager.gd"
GlobalStartup="*uid://bi1lrc40w0hw8"
GlobalGameSettings="*res://settings/game_settings.gd"
GlobalAudioSystem="*res://audio/audio_system.gd"
GlobalSaveGame="*res://utils/save_game.gd"
GlobalUI="*res://utils/ui.gd"
Console="*uid://ouiu5xh1cs8n"
GlobalTooltipSystem="*res://glossary/tooltip/tooltip_system.gd"
GlobalContextHighlight="*res://utils/context_highlight.gd"
GlobalTutorialSystem="*uid://bsfd6flwg4eyy"
GlobalConsoleCommands="*res://_dev_tools/debug_console_commands.gd"
GlobalAchievements="*uid://d07kg5sot8oxi"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/size/mode.editor=0

[editor]

movie_writer/video_quality=1.0
movie_writer/mjpeg_quality=1.0

[editor_plugins]

enabled=PackedStringArray("res://addons/console/plugin.cfg", "res://addons/godot_resource_groups/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/wutw_editor/plugin.cfg", "res://addons/wutw_exporter/plugin.cfg", "res://addons/wutw_i18n_export/plugin.cfg")

[global_group]

AspectSlots=""
Bonuses=""
HubFacilities=""

[godot_resource_groups]

auto_rebuild=true

[gui]

timers/tooltip_delay_sec=0.2
common/snap_controls_to_pixels=false
theme/default_font_antialiasing=2
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/custom="uid://bneu0powe6n80"
theme/custom_font="res://theme/fonts/presets/font_default.tres"

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

