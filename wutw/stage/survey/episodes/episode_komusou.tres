[sub_resource type="Resource" id="Resource_u7fiu"]
script = ExtResource("2_gmgv0")
label = "Ask about his order."
aspects = Array[ExtResource("3_l1qnd")]([ExtResource("4_q0y7i")])
aspects_per_season = Array[ExtResource("3_l1qnd")]([null])
outcome = SubResource("Resource_bb1jx")
outcome_text = "The man explains that theirs is not an order that follows the Enlightened One, but one that seeks enlightenment in meditating on the void which they believe is the true nature of self.

In pursuit of this goal, they cover their heads to dull their senses, play haunting music on the flute to block out sounds, and travel unexplored shards to escape human contact."

[sub_resource type="Resource" id="Resource_i5hty"]
script = ExtResource("9_qj70s")
bonus_type = ExtResource("8_7oxqr")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_op3e0"]
script = ExtResource("2_gmgv0")
label = "Invite him along."
aspects = Array[ExtResource("3_l1qnd")]([ExtResource("7_3c7r5")])
aspects_per_season = Array[ExtResource("3_l1qnd")]([null])
outcome = SubResource("Resource_i5hty")
outcome_text = "The scouts offer to take the man along, as solitary travel on a wild shard is bound to be dangerous.

The man refuses, but takes out a flute and invites everyone to meditate with him on emptiness.

The tune he plays is haunting and loud, but also strangely beautiful."

[sub_resource type="Resource" id="Resource_euma0"]
script = ExtResource("6_owa72")
card_type = ExtResource("11_gy5xj")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_54mch"]
script = ExtResource("2_gmgv0")
label = "Present an offering."
aspects = Array[ExtResource("3_l1qnd")]([ExtResource("10_61bhn")])
aspects_per_season = Array[ExtResource("3_l1qnd")]([null])
outcome = SubResource("Resource_euma0")
outcome_text = "The scouts offer the man a share of their supplies, in case it's a spirit testing their generosity, but the man refuses.

Instead, he asks the explorers to take his flute. He claims to have grown beyond needing it as a meditation aid, able now to block out the whole world by mere thought."

[sub_resource type="Resource" id="Resource_0pc3t"]
script = ExtResource("2_gmgv0")
label = "Ignore the strange man."
aspects = Array[ExtResource("3_l1qnd")]([null])
aspects_per_season = Array[ExtResource("3_l1qnd")]([null])
outcome_text = "The scouts nod a polite bow and move on.

The man appears to be perfectly content to be left alone."

