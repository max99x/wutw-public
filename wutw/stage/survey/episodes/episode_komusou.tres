[resource]
script = ExtResource("12_82g3g")
episode_id = "komusou"
title = "The Monk of Emptiness"
biome_types = Array[int]([6, 5, 8])
requirement = SubResource("Resource_trtbi")
text = "As the survey team is walking through an ancient, overgrown road, they spot a figure on the horizon.

The figure turns out to be a man wearing a basket as a hat. He introduces himself as a monk of Emptiness, an order none of the scouts had heard of.

A few scouts whisper that it must be a trickster spirit taking human form."
background_image = SubResource("Resource_2pltd")
background_credit = ExtResource("1_gmgv0")
choices = Array[ExtResource("2_gmgv0")]([SubResource("Resource_u7fiu"), SubResource("Resource_op3e0"), SubResource("Resource_54mch"), SubResource("Resource_0pc3t")])
